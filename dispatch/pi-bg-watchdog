#!/usr/bin/env bash
# pi-bg-watchdog — periodic sweep for dead pi-bg dispatches (lost callbacks)
#
# GAP covered: pi-bg posts its Discord callback from a hardened EXIT path
# (issue #14), but SIGKILL/OOM cannot be trapped. When the pi-bg shell dies
# untrapably, no callback is posted and the worktree under
# ~/.pi-bg-wt/<repo>/<ticket>/ lingers with the cgroup escape dir behind it.
#
# This sweep runs every 15 min (pi-bg-watchdog.timer) and does:
#   1. enumerate ~/.pi-bg-wt/*/*/ ticket dirs
#   2. skip tickets with a LIVE process:
#        - any pid still inside the escape cgroup
#          /sys/fs/cgroup/.../pi-bg/<ticket>/cgroup.procs|threads, OR
#        - any same-user process whose cwd IS the worktree dir (covers the
#          cgroup-escape-unavailable fallback). A cmdline grep for the ticket
#          id is deliberately NOT used: a live pi-bg whose TASK TEXT happens
#          to mention the id would mask a dead ticket (false negative).
#   3. skip tickets that completed normally: out.md exists and is non-empty
#      (default $HOME/.pi-bg-art — persistent; legacy /tmp is checked too,
#      for one release, so runs started before the ~/.pi-bg-art upgrade are
#      still recognized as completed). Normal exit keeps the worktree BY
#      DESIGN so the orchestrator can diff it; the callback was posted
#   4. if the dir mtime is older than 20 min and the ticket is not already
#      in today's dead letter log -> post a DEAD webhook (same url source
#      and embed format as pi-bg) and append ~/.pi-bg-deadlog
#   4a. STALLED (issue #52): a LIVE ticket whose heartbeat file
#       ($PI_BG_TMPDIR/pi-bg-<id>-hb, touched every 30s by the pi-bg
#       wrapper) is stale > PI_BG_STALL_MIN (default 10) min -> post a
#       STALLED webhook + dead log line. Distinct from DEAD: the process
#       exists, the run is hung (hung tool, wedged model call). One alert
#       per ticket per day (same dead log dedupe as DEAD).
#   4b. run-state prune (issue #51): one-shot runs (task/cron/sleep wakes)
#       leave run records that are never cleared. Records untouched for
#       > PI_BG_PRUNE_DAYS (default 7) are pruned: the ticket's artifact
#       files (persistent dir + legacy /tmp) and the record itself are
#       deleted. Live tickets (cgroup member / worktree cwd) keep theirs.
#   5. AGENTS.md drift tripwire (2026-09-14, alert-only): run
#      `jarate agents-check`; on drift post ONE warning per drifted hash
#      (state: ~/.pi/agent/.agents-md-drift-warned). Never reverts,
#      never blocks. jarate missing/unreadable -> skip silently.
#
# config (same source as pi-bg):
#   $PI_DISPATCH_WEBHOOK or first line of ~/.config/pi-dispatch/webhook
#   (no webhook configured = sweep still runs, posts skipped)
# env:
#   PI_BG_STALL_MIN    stale-heartbeat threshold, min (default 10, issue #52)
#   PI_BG_PRUNE_DAYS   run-record prune age, days (default 7, 0 = off, #51)
#   PI_BG_WT_PRUNE_DAYS killed-worktree prune age, days (default 7, 0 = off)
# args:
#   --quiet   log-only mode: append to dead log, post no webhooks
#             (use for the first run after install to baseline existing debris)
#   --dry-run print what would be done, change nothing
#   --age-min N  override the 20-minute age threshold
set -uo pipefail

WT_DIR="${PI_BG_WT_DIR:-${HOME}/.pi-bg-wt}"
# persistent artifact dir (same default as pi-bg); /tmp is a tmpfs on the
# hydrogen box and a reboot wipes it (2026-09-13 DEAD-flood). LEGACY_TMP is
# checked as a fallback for one release (pre-upgrade runs).
BG_TMP="${PI_BG_TMPDIR:-${HOME}/.pi-bg-art}"
LEGACY_TMP="/tmp"
mkdir -p "$BG_TMP" 2>/dev/null
DEADLOG="${HOME}/.pi-bg-deadlog"
AGE_MIN=20
QUIET=0
DRY=0
# heartbeat staleness threshold (issue #52): a live process whose hb file
# is older than this is STALLED (the process exists; the run is hung)
STALL_MIN="${PI_BG_STALL_MIN:-10}"
# run-record prune age (issue #51): one-shot runs leave records that are
# never cleared; records untouched for this many days are pruned (0 = off)
PRUNE_DAYS="${PI_BG_PRUNE_DAYS:-7}"
# auto-prune: worktrees carrying a killed marker older than N days are
# removed (0 = off). 2026-09-14: Frank's box had 146 worktrees, 125 dead.
WT_PRUNE_DAYS="${PI_BG_WT_PRUNE_DAYS:-7}"

while [ $# -gt 0 ]; do
  case "$1" in
    --quiet)   QUIET=1; shift ;;
    --dry-run) DRY=1; shift ;;
    --age-min) AGE_MIN="$2"; shift 2 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

# PI_BG_CG_ROOT overrides the cgroup base (same hook as pi-bg + pi-bg-kill);
# tests point the sweep at a per-run fake root instead of the real user slice.
CG_DIR="${PI_BG_CG_ROOT:-/sys/fs/cgroup/user.slice/user-$(id -u).slice/user@$(id -u).service}/pi-bg"
today="$(date -u +%Y-%m-%d)"

webhook="${PI_DISPATCH_WEBHOOK:-}"
if [ -z "$webhook" ] && [ -f "${HOME}/.config/pi-dispatch/webhook" ]; then
  webhook="$(head -1 "${HOME}/.config/pi-dispatch/webhook")"
fi

# cg_has_members <cgroup-dir>: 0 while the cgroup still holds a process.
# cgroupfs files ALWAYS report size 0 to stat, so test -s is useless on
# real cgroups (it silently read "empty" for a live ticket and the cgroup
# leg of is_live never fired, 2026-09-14); the content must be read.
# cgroup.threads is checked too: threaded cgroups have no cgroup.procs.
cg_has_members() {
  local d="$1"
  [ -n "$(tr -d '[:space:]' 2>/dev/null < "$d/cgroup.procs")" ] && return 0
  [ -n "$(tr -d '[:space:]' 2>/dev/null < "$d/cgroup.threads")" ] && return 0
  return 1
}

# is_live <ticket> <wt-path>: 0 if a process still matches this ticket
is_live() {
  local t="$1" d="$2" p cwd me
  me="$(id -un)"
  cg_has_members "$CG_DIR/$t" && return 0
  for p in /proc/[0-9]*; do
    [ "$(stat -c %U "$p" 2>/dev/null)" = "$me" ] || continue
    cwd="$(readlink "$p/cwd" 2>/dev/null)" || continue
    [ "$cwd" = "$d" ] && return 0
  done
  return 1
}

# dedupe: already logged as dead on <today>
already_dead() {
  local t="$1"
  grep -q "^${today} ${t} " "$DEADLOG" 2>/dev/null
}

# rule-3 lookups: persistent dir first, legacy /tmp for pre-upgrade runs
has_out() {
  local t="$1"
  [ -s "$BG_TMP/pi-bg-${t}-out.md" ] || [ -s "$LEGACY_TMP/pi-bg-${t}-out.md" ]
}
has_killed() {
  local t="$1"
  [ -f "$BG_TMP/pi-bg-${t}-killed" ] || [ -f "$LEGACY_TMP/pi-bg-${t}-killed" ]
}
has_deadletter() {
  local t="$1"
  [ -f "$BG_TMP/pi-bg-${t}-webhook-failed" ] || [ -f "$LEGACY_TMP/pi-bg-${t}-webhook-failed" ]
}
# started marker (pi-bg writes it at ticket creation, removes on exit):
# distinguishes "ran and was lost" from "never actually started"
has_started() {
  local t="$1"
  [ -f "$BG_TMP/pi-bg-${t}-started" ]
}

# record_done <ticket>: the run record reached a terminal state (pi-bg
# marks state=done on every trapped exit, pi-bg-kill marks killed). A
# ticket whose wrapper ran its exit trap COMPLETED - if no out.md exists
# the callback was lost or mislabeled (deploy-swap deaths, 2026-09-15),
# not a lost process. The sweep must not re-flag it DEAD.
record_done() {
  local t="$1" rf
  rf="${PI_DISPATCH_RECORD_DIR:-${HOME}/.pi-dispatch/runs}/pi-bg-$t.json"
  [ -f "$rf" ] || return 1
  grep -q '"state": *"done"\|"state": *"killed"' "$rf" 2>/dev/null
}

# hb_stale <ticket>: 0 when a heartbeat file exists and is older than
# STALL_MIN min (live process + this = STALLED, issue #52). A fresh hb =
# healthy; no hb at all (pre-upgrade run) = not judgeable -> never stale.
hb_stale() {
  local t="$1" f m now
  now="$(date +%s)"
  for f in "$BG_TMP/pi-bg-${t}-hb" "$LEGACY_TMP/pi-bg-${t}-hb"; do
    [ -f "$f" ] || continue
    m="$(stat -c %Y "$f" 2>/dev/null)" || return 1
    [ $(( now - m )) -gt $(( STALL_MIN * 60 )) ] && return 0
    return 1
  done
  return 1
}

# prune_live <ticket>: liveness for the run-state prune (issue #51) - the
# sweep's liveness scoped to the ticket: a cgroup member, or a same-user
# process sitting in the ticket's worktree dir when one exists.
prune_live() {
  local t="$1" wt
  for wt in "$WT_DIR"/*/"$t"; do
    [ -d "$wt" ] || continue
    is_live "$t" "$wt" && return 0
  done
  cg_has_members "$CG_DIR/$t"
}

# issue #57 artifacts (written by the pi-bg wrapper): -rc holds the final
# exit code (EXIT trap), -retry1 marks the one silent-death relaunch (kept
# when the retry did not recover, removed when it did). The watchdog uses
# both to split DEAD into DEAD (generic: SIGKILL/OOM/...) and SILENT
# (rc=1 + no output + unconsumed retry1 = the #57 idle-timeout mode).
has_retry1() {
  [ -f "$BG_TMP/pi-bg-${1}-retry1" ]
}
rc_of() {
  tr -d '[:space:]' < "$BG_TMP/pi-bg-${1}-rc" 2>/dev/null
}

# wd_post <body-file>: same retry shape as pi-bg bg_post (3 attempts)
wd_post() {
  local body="$1" code i
  [ -n "$webhook" ] || return 1
  for i in 1 2 3; do
    code="$(curl -s -o "$BG_TMP/pi-bg-watchdog-wb-resp.txt" -w '%{http_code}' -X POST "$webhook" \
      -H 'Content-Type: application/json' --max-time 15 --data @"$body" 2>/dev/null)" || code="000"
    case "$code" in 2*) return 0 ;; esac
    [ "$i" -lt 3 ] && sleep $((i * 3))
  done
  echo "[pi-bg-watchdog] webhook FAILED (http=$code) for body: $body" >&2
  return 1
}

# wd_build <body-file> <ticket> <repo> <wt-path> <last-activity> <reason> <kind>
# kind: DEAD (generic) or SILENT (issue #57 idle-timeout death)
# embed format mirrors pi-bg bg_build (author header, bash meta block,
# footer). Code lines are clipped to FRAME_W (32, docs/STYLE.md 2.3):
# the wt path head-clips (the ticket at the path tail is the discriminator),
# reason/note tail-clip (the classification leads). The full ticket stays
# in the author name; the title drops it (it cannot fit in 32 with the
# kind) - PR #64 review P3.
wd_build() {
  local bodyfile="$1" t="$2" repo="$3" path="$4" last="$5" reason="$6" kind="${7:-DEAD}"
  WD_T="$t" WD_REPO="$repo" WD_PATH="$path" WD_LAST="$last" WD_REASON="$reason" WD_KIND="$kind" \
  python3 - > "$bodyfile" 2>/dev/null <<'PY'
import json, os, sys, datetime
E = lambda k: os.environ.get("WD_" + k, "")
FRAME_W = 32  # mobile budget (docs/STYLE.md 2.3): every code line <= 32
def clip_end(s, max):
    s = str(s)
    return s if len(s) <= max else (s[:max - 1] + "\u2026" if max > 1 else "\u2026")
def clip_start(s, max):
    s = str(s)
    return s if len(s) <= max else ("\u2026" + s[len(s) - (max - 1):] if max > 1 else "\u2026")
def kv(key, val, width=6, vbudget=23, head=False):
    # 9-col label + 23-col value = FRAME_W
    cut = clip_start if head else clip_end
    return key.ljust(width) + " : " + cut(val, vbudget)
kind = E('KIND') or 'DEAD'
note = ("silent death (issue #57): rc=1, no output, retry1 did not recover"
        if kind == 'SILENT' else
        "no live pi-bg process, no completion report - callback lost (SIGKILL/OOM)")
meta = [kv("repo", E('REPO')),
        kv("wt", E('PATH'), head=True),
        kv("last", E('LAST')),
        kv("reason", E('REASON')),
        kv("note", note)]
embed = {"author": {"name": f"pi-bg ticket \u00b7 {E('T')}"},
         "color": 15105570,  # orange, same as pi-bg DIED
         "title": f"{kind} \u00b7 watchdog sweep",
         "description": "```bash\n" + "\n".join(meta) + "\n```",  # fence on its own line (pi-bg pattern)
         "footer": {"text": "pi-bg watchdog"},
         "timestamp": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")}
json.dump({"embeds": [embed]}, sys.stdout)
PY
}

# wd_build_drift <body-file> <hash8> <ts>
# AGENTS.md drift warning (alert-only tripwire). Message format is fixed:
#   AGENTS.md drift: <hash8> since <ts> — review + re-bless: jarate agents-bless "note"
wd_build_drift() {
  local bodyfile="$1" h8="$2" ts="$3"
  WD_H8="$h8" WD_TS="$ts" python3 - > "$bodyfile" 2>/dev/null <<'PY'
import json, os, sys, datetime
h8 = os.environ.get("WD_H8", "")
ts = os.environ.get("WD_TS", "unknown")
embed = {"author": {"name": "pi-bg watchdog"},
         "color": 15105570,  # orange, same as the DEAD sweep
         "title": "AGENTS.md drift",
         "description": f'AGENTS.md drift: {h8} since {ts} \u2014 review + re-bless: jarate agents-bless "note"',
         "footer": {"text": "pi-bg watchdog"},
         "timestamp": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")}
json.dump({"embeds": [embed]}, sys.stdout)
PY
}

found=0
DT=(); DREPO=(); DP=(); DLAST=(); DREAS=(); DTYPE=()
ST=(); STREPO=(); STL=()
for d in "$WT_DIR"/*/*/; do
  d="${d%/}"
  [ -d "$d" ] || continue
  t="$(basename "$d")"
  repo="$(basename "$(dirname "$d")")"
  # sanity: ticket ids are YYYYMMDD-HHMMSS-NNNNN
  [[ "$t" =~ ^[0-9]{8}-[0-9]{6}-[0-9]+$ ]] || continue
  # 1) live dispatch -> leave alone; STALLED check (issue #52): a live
  #    process whose heartbeat is stale > STALL_MIN min is hung (DEAD needs
  #    the process gone, so without the hb this state was invisible)
  if is_live "$t" "$d"; then
    if hb_stale "$t" && ! already_dead "$t"; then
      hb_f="$BG_TMP/pi-bg-${t}-hb"
      [ -f "$hb_f" ] || hb_f="$LEGACY_TMP/pi-bg-${t}-hb"
      hbm="$(stat -c %Y "$hb_f" 2>/dev/null)" || hbm=""
      stall_last="$(date -u -d "@${hbm:-0}" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" || stall_last="unknown"
      echo "[pi-bg-watchdog] STALLED $repo/$t (hb last $stall_last, > ${STALL_MIN} min stale)"
      ST+=("$t"); STREPO+=("$repo"); STL+=("$stall_last")
      printf '%s %s %s %s %s\n' "$today" "$t" "$repo" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "stalled: live process, heartbeat stale > ${STALL_MIN} min" >> "$DEADLOG"
    fi
    continue
  fi
  # 2) normal completion (out.md written) -> callback was posted, worktree kept by design;
  #    killed on purpose (pi-bg-kill marker) -> not a lost callback. Both
  #    checked in the persistent dir AND legacy /tmp (one release of overlap).
  if has_out "$t" || has_killed "$t" || record_done "$t"; then continue; fi
  # 3) recent activity -> give it time
  mtime="$(stat -c %Y "$d" 2>/dev/null)" || continue
  [ $(( $(date +%s) - mtime )) -gt $((AGE_MIN * 60)) ] || continue
  # 4) dedupe on today's dead letter
  if already_dead "$t"; then continue; fi

  found=$((found + 1))
  last="$(date -u -d "@$mtime" +%Y-%m-%dT%H:%M:%SZ)"
  # SILENT (issue #57): the wrapper recorded exit 1, never produced output,
  # and its one silent-death relaunch (retry1) did not recover. Distinct
  # from generic DEAD: the process path was healthy, the model stream
  # idle-timed-out. rc + retry1 alone prove the run started (retry1 is only
  # touched inside the run loop), so no started-marker requirement. Only
  # claimed when no stronger artifact explains it.
  kind="DEAD"
  if has_deadletter "$t"; then
    reason="webhook dead letter exists (callback attempted, post failed)"
  elif [ "$(rc_of "$t")" = "1" ] && has_retry1 "$t"; then
    kind="SILENT"
    reason="silent death: rc=1, no output, retry1 did not recover (issue #57)"
  elif has_started "$t"; then
    reason="started, no completion marker (callback lost - SIGKILL/OOM)"
  else
    reason="no callback on record (SIGKILL/OOM suspected)"
  fi

  echo "[pi-bg-watchdog] $kind $repo/$t (last activity $last, $reason)"
  DT+=("$t"); DREPO+=("$repo"); DP+=("$d"); DLAST+=("$last"); DREAS+=("$reason"); DTYPE+=("$kind")
  printf '%s %s %s %s %s\n' "$today" "$t" "$repo" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$reason" >> "$DEADLOG"
done

# ─── empty cgroup reaper (2026-09-14, issue: pi-bg cgroup-dir leak) ─────────
# A ticket dir that holds no process is a leak: a live run always keeps at
# least the wrapper shell in its escape cgroup. Untrappable deaths (bun
# test SIGKILL/timeout, pi.service restart, OOM) kill the wrapper before
# its exit-trap self-drain; the kernel then drops the cgroup files when the
# last member dies, leaving an empty dir that accumulates in $CG_DIR.
# rmdir them: members present -> untouched; rmdir failing (busy race, or a
# plain-file test root with a leftover fake procs file) -> skip silently.
reaped=0
for cg in "$CG_DIR"/*/; do
  cg="${cg%/}"
  [ -d "$cg" ] || continue
  cg_has_members "$cg" && continue
  if [ "$DRY" -eq 1 ]; then
    echo "[pi-bg-watchdog] dry-run: would reap empty cgroup $cg"
  elif rmdir "$cg" 2>/dev/null; then
    echo "[pi-bg-watchdog] reaped empty cgroup $cg"
    reaped=$((reaped + 1))
  fi
done
[ "$reaped" -gt 0 ] && echo "[pi-bg-watchdog] reaped $reaped empty cgroup dir(s)"

# Post (flood guard, 2026-09-14): 1-3 dead tickets = one embed each (as
# before); 4+ = ONE digest embed. A mass-death event (reboot tmpfs wipe,
# OOM storm) must never spam the channel one embed per corpse.
if [ "$found" -gt 0 ] && [ "$QUIET" -eq 0 ] && [ -n "$webhook" ] && [ "$DRY" -eq 0 ]; then
  bodyf="$BG_TMP/pi-bg-watchdog-digest-body.json"
  if [ "$found" -le 3 ]; then
    for i in "${!DT[@]}"; do
      wd_build "$bodyf" "${DT[$i]}" "${DREPO[$i]}" "${DP[$i]}" "${DLAST[$i]}" "${DREAS[$i]}" "${DTYPE[$i]}"
      if [ -s "$bodyf" ]; then
        wd_post "$bodyf" || echo "[pi-bg-watchdog] DEAD post failed for ${DT[$i]} (dead log still updated)" >&2
      fi
    done
  else
    WD_N="$found" WD_LIST="$(for i in "${!DT[@]}"; do
      [ "$i" -ge 10 ] && break
      printf '%s/%s | %s | last %s\n' "${DREPO[$i]}" "${DT[$i]}" "${DTYPE[$i]}" "${DLAST[$i]}"
    done)" WD_EXTRA=$((found - 10)) python3 - > "$bodyf" 2>/dev/null <<'PY'
import json, os, sys, datetime
FRAME_W = 32  # mobile budget (docs/STYLE.md 2.3): every code line <= 32
def clip_start(s, max):
    s = str(s)
    return s if len(s) <= max else ("\u2026" + s[len(s) - (max - 1):] if max > 1 else "\u2026")
count = int(os.environ.get("WD_N", "0"))
extra = int(os.environ.get("WD_EXTRA", "0"))
lines = []
for r in os.environ.get("WD_LIST", "").splitlines():
    # "repo/ticket | KIND | last ts" -> two lines: the ticket head-clips
    # to FRAME_W (a long repo name must not eat the ticket), kind +
    # minuted ts on line 2. Full precision stays in the dead log.
    parts = r.split(" | ")
    lines.append(clip_start(parts[0], FRAME_W))
    ts = parts[2][len("last "):] if len(parts) > 2 else ""
    lines.append(f"  {parts[1] if len(parts) > 1 else ''} \u00b7 last {ts[:16].replace('T', ' ')}")
if extra > 0:
    lines.append(f"... {extra} more: ~/.pi-bg-deadlog")
lines.append("wt kept: ~/.pi-bg-wt (prune 7d)")
embed = {"author": {"name": "pi-bg watchdog"},
         "color": 15105570,
         "title": f"pi-bg \u00b7 {count} dead tickets swept",
         "description": "```bash\n" + "\n".join(lines) + "\n```",  # fence on its own line (pi-bg pattern)
         "footer": {"text": "pi-bg watchdog (digest)"},
         "timestamp": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")}
json.dump({"embeds": [embed]}, sys.stdout)
PY
    if [ -s "$bodyf" ]; then
      wd_post "$bodyf" || echo "[pi-bg-watchdog] digest post failed (dead log still updated)" >&2
    fi
  fi
  rm -f "$bodyf"
fi

# Post STALLED (issue #52): ONE embed listing up to 10 tickets. A stalled
# run is alive-but-hung (red), distinct from DEAD (orange, process gone).
if [ "${#ST[@]}" -gt 0 ] && [ "$QUIET" -eq 0 ] && [ -n "$webhook" ] && [ "$DRY" -eq 0 ]; then
  bodyf="$BG_TMP/pi-bg-watchdog-stalled-body.json"
  WD_N="${#ST[@]}" WD_MIN="$STALL_MIN" WD_LIST="$(for i in "${!ST[@]}"; do
    [ "$i" -ge 10 ] && break
    printf '%s/%s | hb last %s\n' "${STREPO[$i]}" "${ST[$i]}" "${STL[$i]}"
  done)" python3 - > "$bodyf" 2>/dev/null <<'PY'
import json, os, sys, datetime
FRAME_W = 32  # mobile budget (docs/STYLE.md 2.3): every code line <= 32
def clip_end(s, max):
    s = str(s)
    return s if len(s) <= max else (s[:max - 1] + "\u2026" if max > 1 else "\u2026")
def clip_start(s, max):
    s = str(s)
    return s if len(s) <= max else ("\u2026" + s[len(s) - (max - 1):] if max > 1 else "\u2026")
count = int(os.environ.get("WD_N", "0"))
mins = os.environ.get("WD_MIN", "10")
lines = []
for r in os.environ.get("WD_LIST", "").splitlines():
    # "repo/ticket | hb last ts" -> two lines (same shape as the digest)
    parts = r.split(" | ")
    lines.append(clip_start(parts[0], FRAME_W))
    ts = parts[1][len("hb last "):] if len(parts) > 1 else ""
    lines.append(f"  hb last {ts[:16].replace('T', ' ')}")
if count > 10:
    lines.append(f"... {count - 10} more: ~/.pi-bg-deadlog")
lines.append(clip_end(f"process alive; hb stale >{mins} min", FRAME_W))
lines.append("pi-bg-kill <ticket> to cancel")
embed = {"author": {"name": "pi-bg watchdog"},
         "color": 15158332,  # red: alive but stuck (DEAD is orange)
         "title": f"{count} stalled \u00b7 watchdog sweep",
         "description": "```bash\n" + "\n".join(lines) + "\n```",
         "footer": {"text": "pi-bg watchdog (stalled)"},
         "timestamp": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")}
json.dump({"embeds": [embed]}, sys.stdout)
PY
  if [ -s "$bodyf" ]; then
    wd_post "$bodyf" || echo "[pi-bg-watchdog] stalled post failed (dead log still updated)" >&2
  fi
  rm -f "$bodyf"
fi

# ─── AGENTS.md drift tripwire (2026-09-14, alert-only) ────────────────────────
# Manifest: ~/.pi/agent/.agents-md-hash (<sha256>  <ts>  <note>). The check
# itself never blocks; this section only decides whether to post. One warning
# per drifted hash: the full drifted hash is remembered in
# ~/.pi/agent/.agents-md-drift-warned (written only after a successful post,
# so a dead webhook retries on the next sweep). Backward compatible: jarate
# missing/unreadable, jq/python missing, or a non-drift check -> skip
# silently, sweep still exits 0.
JARATE_BIN="${HOME}/bin/jarate"
DRIFT_STATE="${HOME}/.pi/agent/.agents-md-drift-warned"
# same resolution as jarate agents-check: JARATE_AGENTS_MD override first,
# then canonical ~/.pi/agent/AGENTS.md, else ~/AGENTS.md. The manifest sits at
# the fixed path unless the override moves it next to the checked file.
if [ -n "${JARATE_AGENTS_MD:-}" ]; then
  AGENTS_MD="$JARATE_AGENTS_MD"
  MANIFEST="$(dirname "$JARATE_AGENTS_MD")/.agents-md-hash"
else
  AGENTS_MD="${HOME}/.pi/agent/AGENTS.md"
  [ -f "$AGENTS_MD" ] || AGENTS_MD="${HOME}/AGENTS.md"
  MANIFEST="${HOME}/.pi/agent/.agents-md-hash"
fi
if [ -x "$JARATE_BIN" ]; then
  check_json="$(timeout 30 "$JARATE_BIN" agents-check 2>/dev/null)" || check_json=""
  if [ -n "$check_json" ]; then
    c_ok="$(jq -r '.ok // false' <<<"$check_json" 2>/dev/null)"
    c_drift="$(jq -r '.drift // false' <<<"$check_json" 2>/dev/null)"
    c_hash="$(jq -r '.hash // empty' <<<"$check_json" 2>/dev/null)"
    if [ "$c_ok" = "true" ] && [ "$c_drift" = "true" ] && [ -n "$c_hash" ]; then
      prev_warned="$(cat "$DRIFT_STATE" 2>/dev/null)"
      if [ "$prev_warned" != "$c_hash" ]; then
        # <ts>: the manifest's blessing timestamp; if the manifest is
        # missing (never blessed), the AGENTS.md mtime; else unknown.
        c_ts="$(awk 'NR==1 {print $2; exit}' "$MANIFEST" 2>/dev/null)"
        if [ -z "$c_ts" ] && [ -f "$AGENTS_MD" ]; then
          c_ts="$(date -u -d "@$(stat -c %Y "$AGENTS_MD" 2>/dev/null)" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)"
        fi
        [ -n "$c_ts" ] || c_ts="unknown"
        echo "[pi-bg-watchdog] AGENTS.md drift: ${c_hash:0:8} since $c_ts"
        if [ "$DRY" -eq 1 ]; then
          echo "[pi-bg-watchdog] dry-run: would post AGENTS.md drift warning (${c_hash:0:8})"
        elif [ "$QUIET" -eq 0 ] && [ -n "$webhook" ]; then
          bodyf="$BG_TMP/pi-bg-watchdog-drift-body.json"
          wd_build_drift "$bodyf" "${c_hash:0:8}" "$c_ts"
          if [ -s "$bodyf" ]; then
            if wd_post "$bodyf"; then
              mkdir -p "$(dirname "$DRIFT_STATE")" 2>/dev/null
              printf '%s\n' "$c_hash" > "$DRIFT_STATE"
            fi
          fi
          rm -f "$bodyf"
        fi
      fi
    fi
  fi
fi

# auto-prune: killed-marked worktrees older than WT_PRUNE_DAYS (0 = off)
if [ "$WT_PRUNE_DAYS" -gt 0 ] && [ "$DRY" -eq 0 ]; then
  pruned=0
  for d in "$WT_DIR"/*/*/; do
    d="${d%/}"
    [ -d "$d" ] || continue
    t="$(basename "$d")"
    has_killed "$t" || continue
    mtime="$(stat -c %Y "$d" 2>/dev/null)" || continue
    [ $(( $(date +%s) - mtime )) -gt $((WT_PRUNE_DAYS * 86400)) ] || continue
    if git -C "$d" worktree remove --force "$d" 2>/dev/null || rmdir "$d" 2>/dev/null; then
      echo "[pi-bg-watchdog] pruned $d"
      pruned=$((pruned + 1))
    fi
  done
  [ "$pruned" -gt 0 ] && echo "[pi-bg-watchdog] pruned $pruned worktree(s)"
fi

# ─── run-state prune (issue #51): one-shot runs (task/cron/sleep wakes)
#     leave run records + artifacts that are never cleared. Records
#     untouched for > PRUNE_DAYS are pruned: the ticket's artifact files
#     (persistent dir + legacy /tmp) and the record itself are deleted.
#     The record mtime is the age clock: pi-bg marks state=done on every
#     trapped exit and pi-bg-kill marks state=killed (both refresh the
#     mtime), so a stale mtime means an untrappable death or a record that
#     was never closed. Live tickets keep theirs (prune_live above).
pruned_state=0
if [ "$PRUNE_DAYS" -gt 0 ]; then
  rec_dir="${PI_DISPATCH_RECORD_DIR:-${HOME}/.pi-dispatch/runs}"
  for rf in "$rec_dir"/pi-bg-*.json; do
    [ -f "$rf" ] || continue
    t="${rf##*/pi-bg-}"
    t="${t%.json}"
    [[ "$t" =~ ^[0-9]{8}-[0-9]{6}-[0-9]+$ ]] || continue
    mtime="$(stat -c %Y "$rf" 2>/dev/null)" || continue
    [ $(( $(date +%s) - mtime )) -gt $((PRUNE_DAYS * 86400)) ] || continue
    prune_live "$t" && continue
    if [ "$DRY" -eq 1 ]; then
      echo "[pi-bg-watchdog] dry-run: would prune run state $t"
      continue
    fi
    rm -f "$BG_TMP"/pi-bg-"$t"-* 2>/dev/null
    rm -f "$LEGACY_TMP"/pi-bg-"$t"-* 2>/dev/null
    rm -f "$rf"
    echo "[pi-bg-watchdog] pruned run state $t"
    pruned_state=$((pruned_state + 1))
  done
  [ "$pruned_state" -gt 0 ] && echo "[pi-bg-watchdog] pruned $pruned_state run record(s)"
fi

echo "[pi-bg-watchdog] sweep done: $found dead ticket(s) found, $reaped cgroup dir(s) reaped, ${#ST[@]} stalled, $pruned_state run record(s) pruned (quiet=$QUIET dry=$DRY stall_min=$STALL_MIN prune_days=$PRUNE_DAYS wt_prune_days=$WT_PRUNE_DAYS)"
exit 0
