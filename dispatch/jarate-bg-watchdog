#!/usr/bin/env bash
# jarate-bg-watchdog — periodic sweep for dead jarate-bg dispatches (lost callbacks)
#
# GAP covered: jarate-bg posts its Discord callback from a hardened EXIT path
# (issue #14), but SIGKILL/OOM cannot be trapped. When the jarate-bg shell dies
# untrapably, no callback is posted and the worktree under
# ~/.pi-bg-wt/<repo>/<ticket>/ lingers with the cgroup escape dir behind it.
#
# This sweep runs every 15 min (pi-bg-watchdog.timer) and does:
#   1. enumerate ~/.pi-bg-wt/*/*/ ticket dirs
#   2. skip tickets with a LIVE process:
#        - any pid still inside the escape cgroup
#          /sys/fs/cgroup/.../pi-bg/<ticket>/cgroup.procs|threads, OR
#        - any same-user process whose cwd IS the worktree dir (covers the
#          cgroup-escape-unavailable fallback). A cmdline grep for the ticket
#          id is deliberately NOT used: a live jarate-bg whose TASK TEXT happens
#          to mention the id would mask a dead ticket (false negative).
#   3. skip tickets that completed normally: out.md exists and is non-empty
#      (default $HOME/.pi-bg-art — persistent; legacy /tmp is checked too,
#      for one release, so runs started before the ~/.pi-bg-art upgrade are
#      still recognized as completed). Normal exit keeps the worktree BY
#      DESIGN so the orchestrator can diff it; the callback was posted
#   4. if the dir mtime is older than 20 min and the ticket is not already
#      in today's dead letter log -> post a DEAD webhook (same url source
#      and embed format as jarate-bg) and append ~/.pi-bg-deadlog
#   4a. STALLED (issue #52): a LIVE ticket whose heartbeat file
#       ($PI_BG_TMPDIR/pi-bg-<id>-hb, touched every 30s by the jarate-bg
#       wrapper) is stale > PI_BG_STALL_MIN (default 10) min -> post a
#       STALLED webhook + dead log line. Distinct from DEAD: the process
#       exists, the run is hung (hung tool, wedged model call). One alert
#       per ticket per day (same dead log dedupe as DEAD).
#   4b. run-state prune (issue #51): one-shot runs (task/cron/sleep wakes)
#       leave run records that are never cleared. Records untouched for
#       > PI_BG_PRUNE_DAYS (default 7) are pruned: the ticket's artifact
#       files (persistent dir + legacy /tmp) and the record itself are
#       deleted. Live tickets (cgroup member / worktree cwd) keep theirs.
#   4c. cwd-ticket sweep (issue #86, #116): non-worktree runs (no
#       --worktree) leave no dir under $WT_DIR and were invisible to DEAD
#       detection. Run records with state=running whose cgroup is empty
#       (no processes - "stale") OR whose cgroup dir is already gone
#       (reaped by the empty-cgroup reaper or never created - issue #116)
#       AND whose heartbeat is stale > STALL_MIN min are DEAD: same dead
#       webhook payload + dead log as the worktree sweep, record marked
#       state=killed, empty cgroup reaped via the guarded cgroup.kill
#       (cgroup.kill is only ever written when cgroup.procs is empty -
#       issue #86).
#   4d. HUNG (issue #142): a LIVE run whose profile session jsonl has no
#       write for > PI_BG_HUNG_MIN (default 30) min. DEAD needs the process
#       gone; STALLED needs the hb stale - but the hb child keeps touching
#       while the wrapper lives, so a pi session wedged in a bash tool
#       call (20261004-140606-286112: pi -> bash -> sshpass -> ssh, 5h51m,
#       fresh hb, tree alive) was invisible. HUNG posts a red embed (same
#       webhook/channel as DIED) with run id, last jsonl write, silence
#       age, last hb time, and the longest-lived process in the pi tree
#       (pstree - the hang candidate). At most ONE HUNG per run: a
#       hungNotified flag in the run record (written only after a
#       successful post, so a dead webhook retries next sweep). NEVER
#       kills: HUNG informs + wakes; if the process later dies the
#       existing DIED path fires unchanged.
#   4e. DEAD retry (issue #110): a FIRST death (DEAD class, run record
#       with the stored task prompt, no retryOf yet) is re-dispatched
#       ONCE through the normal jarate-bg launcher (PI_BG_RUN_ID +
#       PI_BG_RETRY_OF + --wt-reuse <same worktree>: partial work
#       survives). Cap full -> held in the run record (deadRetry),
#       fired by a later sweep on a free slot. The retry's own death =
#       SECOND death = human wake only, no third attempt. HUNG/STALLED
#       are never auto-retried. Placement: the watchdog, not the wrapper
#       trap - DEAD means the traps never ran (that is the death class);
#       #57's SILENT retry stays in the wrapper because SILENT is only
#       judgeable from inside (rc + quiet tail, process still alive).
#       Under --quiet the retry is off unless PI_BG_WATCHDOG_RETRY=1
#       (posts stay suppressed - the quiet contract is no posts).
#   5. AGENTS.md drift tripwire (2026-09-14, alert-only): run
#      `jarate agents-check`; on drift post ONE warning per drifted hash
#      (state: ~/.pi/agent/.agents-md-drift-warned). Never reverts,
#      never blocks. jarate missing/unreadable -> skip silently.
#
# config (same source as jarate-bg):
#   $PI_DISPATCH_WEBHOOK or first line of ~/.config/pi-dispatch/webhook
#   (no webhook configured = sweep still runs, posts skipped)
# env:
#   PI_BG_STALL_MIN    stale-heartbeat threshold, min (default 10, issue #52)
#   PI_BG_HUNG_MIN     stale-session-write threshold, min (default 30,
#                      issue #142)
#   PI_BG_PRUNE_DAYS   run-record prune age, days (default 7, 0 = off, #51)
#   PI_BG_WT_PRUNE_DAYS killed-worktree prune age, days (default 7, 0 = off)
#   PI_BG_LAUNCHER     jarate-bg launcher path for the DEAD-retry
#                      re-dispatch (issue #110; default: $HOME/scripts/
#                      jarate-bg, then PATH; test hook)
#   PI_BG_RETRY_WAIT   seconds to wait for the retry's run record after
#                      launch (issue #110; default 8; a record that never
#                      appears drops the retry back to held)
#   PI_BG_WATCHDOG_RETRY =1 runs the DEAD auto-retry (decision, dispatch,
#                      held section) even under --quiet; POSTS stay
#                      suppressed (issue #110, review F2). Default 0.
# args:
#   --quiet   log-only mode: append to dead log, post no webhooks
#             (use for the first run after install to baseline existing
#             debris). DEAD auto-retry stays off unless
#             PI_BG_WATCHDOG_RETRY=1
#   --dry-run print what would be done, change nothing
#   --age-min N  override the 20-minute age threshold
set -uo pipefail

WT_DIR="${PI_BG_WT_DIR:-${HOME}/.pi-bg-wt}"
# persistent artifact dir (same default as jarate-bg); /tmp is a tmpfs on the
# reference agent host and a reboot wipes it (2026-09-13 DEAD-flood). LEGACY_TMP is
# checked as a fallback for one release (pre-upgrade runs).
BG_TMP="${PI_BG_TMPDIR:-${HOME}/.pi-bg-art}"
LEGACY_TMP="/tmp"
mkdir -p "$BG_TMP" 2>/dev/null
DEADLOG="${HOME}/.pi-bg-deadlog"
AGE_MIN=20
QUIET=0
DRY=0
# heartbeat staleness threshold (issue #52): a live process whose hb file
# is older than this is STALLED (the process exists; the run is hung)
STALL_MIN="${PI_BG_STALL_MIN:-10}"
# run-record prune age (issue #51): one-shot runs leave records that are
# never cleared; records untouched for this many days are pruned (0 = off)
PRUNE_DAYS="${PI_BG_PRUNE_DAYS:-7}"
# auto-prune: worktrees carrying a killed marker older than N days are
# removed (0 = off). 2026-09-14: Frank's box had 146 worktrees, 125 dead.
WT_PRUNE_DAYS="${PI_BG_WT_PRUNE_DAYS:-7}"

while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) sed -n '2,/^set -uo pipefail$/{ /^set -uo pipefail$/d; p }' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --quiet)   QUIET=1; shift ;;
    --dry-run) DRY=1; shift ;;
    --age-min) AGE_MIN="$2"; shift 2 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done

# DEAD auto-retry under --quiet (issue #110, review F2): the retry
# decision/dispatch/section still runs, the POSTS stay suppressed
# (the quiet contract = no posts)
RETRY_ON=0
case "${PI_BG_WATCHDOG_RETRY:-}" in
  1) RETRY_ON=1 ;;
esac

# PI_BG_CG_ROOT overrides the cgroup base (same hook as jarate-bg + jarate-bg-kill);
# tests point the sweep at a per-run fake root instead of the real user slice.
CG_DIR="${PI_BG_CG_ROOT:-/sys/fs/cgroup/user.slice/user-$(id -u).slice/user@$(id -u).service}/pi-bg"
today="$(date -u +%Y-%m-%d)"
rec_dir="${PI_DISPATCH_RECORD_DIR:-${HOME}/.pi-dispatch/runs}"

webhook="${PI_DISPATCH_WEBHOOK:-}"
if [ -z "$webhook" ] && [ -f "${HOME}/.config/pi-dispatch/webhook" ]; then
  webhook="$(head -1 "${HOME}/.config/pi-dispatch/webhook")"
fi

# cg_has_members <cgroup-dir>: 0 while the cgroup still holds a process.
# cgroupfs files ALWAYS report size 0 to stat, so test -s is useless on
# real cgroups (it silently read "empty" for a live ticket and the cgroup
# leg of is_live never fired, 2026-09-14); the content must be read.
# cgroup.threads is checked too: threaded cgroups have no cgroup.procs.
cg_has_members() {
  local d="$1"
  [ -n "$(tr -d '[:space:]' 2>/dev/null < "$d/cgroup.procs")" ] && return 0
  [ -n "$(tr -d '[:space:]' 2>/dev/null < "$d/cgroup.threads")" ] && return 0
  return 1
}

# cg_kill_guarded <cgroup-dir> (issue #86): write cgroup.kill=1 ONLY when
# the cgroup holds NO process. cgroup.kill kills every current member, so
# on a non-empty cgroup it is a nuke, not a cleanup: 2026-09-25 a "clean up
# stale cgroups" loop wrote cgroup.kill on four LIVE ticket cgroups and
# killed four workers mid-run. "Stale" means no processes. Live PIDs ->
# warning on stderr, no write, rc 1. Every watchdog cleanup path that
# writes cgroup.kill goes through here.
cg_kill_guarded() {
  local d="$1"
  if cg_has_members "$d"; then
    echo "[pi-bg-watchdog] warning: $d not empty (live PIDs), skipping cgroup.kill" >&2
    return 1
  fi
  # #164 review LOW: group the redirect so a missing dir is silent -
  # bare `> file 2>/dev/null` prints the open-failure error (redirects are
  # processed L-to-R, stderr is only dropped after the file open fails).
  { echo 1 > "$d/cgroup.kill"; } 2>/dev/null || true
  return 0
}

# is_live <ticket> <wt-path>: 0 if a process still matches this ticket
is_live() {
  local t="$1" d="$2" p cwd me
  me="$(id -un)"
  cg_has_members "$CG_DIR/$t" && return 0
  for p in /proc/[0-9]*; do
    [ "$(stat -c %U "$p" 2>/dev/null)" = "$me" ] || continue
    cwd="$(readlink "$p/cwd" 2>/dev/null)" || continue
    [ "$cwd" = "$d" ] && return 0
  done
  return 1
}

# dedupe: already logged as dead on <today>
already_dead() {
  local t="$1"
  grep -q "^${today} ${t} " "$DEADLOG" 2>/dev/null
}

# rule-3 lookups: persistent dir first, legacy /tmp for pre-upgrade runs
has_out() {
  local t="$1"
  [ -s "$BG_TMP/pi-bg-${t}-out.md" ] || [ -s "$LEGACY_TMP/pi-bg-${t}-out.md" ]
}
has_killed() {
  local t="$1"
  [ -f "$BG_TMP/pi-bg-${t}-killed" ] || [ -f "$LEGACY_TMP/pi-bg-${t}-killed" ]
}
has_deadletter() {
  local t="$1"
  [ -f "$BG_TMP/pi-bg-${t}-webhook-failed" ] || [ -f "$LEGACY_TMP/pi-bg-${t}-webhook-failed" ]
}
# started marker (jarate-bg writes it at ticket creation, removes on exit):
# distinguishes "ran and was lost" from "never actually started"
has_started() {
  local t="$1"
  [ -f "$BG_TMP/pi-bg-${t}-started" ]
}

# record_done <ticket>: the run record reached a terminal state (jarate-bg
# marks state=done on every trapped exit, jarate-bg-kill marks cancelled,
# the watchdog's own sweep/launch-fail paths mark killed). A ticket whose
# wrapper ran its exit trap COMPLETED - if no out.md exists the callback
# was lost or mislabeled (deploy-swap deaths, 2026-09-15), not a lost
# process. The sweep must not re-flag it DEAD.
record_done() {
  local t="$1" rf
  rf="${PI_DISPATCH_RECORD_DIR:-${HOME}/.pi-dispatch/runs}/pi-bg-$t.json"
  [ -f "$rf" ] || return 1
  grep -q '"state": *"done"\|"state": *"killed"\|"state": *"cancelled"' "$rf" 2>/dev/null
}

# hb_stale <ticket>: 0 when a heartbeat file exists and is older than
# STALL_MIN min (live process + this = STALLED, issue #52). A fresh hb =
# healthy; no hb at all (pre-upgrade run) = not judgeable -> never stale.
hb_stale() {
  local t="$1" f m now
  now="$(date +%s)"
  for f in "$BG_TMP/pi-bg-${t}-hb" "$LEGACY_TMP/pi-bg-${t}-hb"; do
    [ -f "$f" ] || continue
    m="$(stat -c %Y "$f" 2>/dev/null)" || return 1
    [ $(( now - m )) -gt $(( STALL_MIN * 60 )) ] && return 0
    return 1
  done
  return 1
}

# prune_live <ticket>: liveness for the run-state prune (issue #51) - the
# sweep's liveness scoped to the ticket: a cgroup member, or a same-user
# process sitting in the ticket's worktree dir when one exists.
prune_live() {
  local t="$1" wt
  for wt in "$WT_DIR"/*/"$t"; do
    [ -d "$wt" ] || continue
    is_live "$t" "$wt" && return 0
  done
  cg_has_members "$CG_DIR/$t"
}

# issue #57 artifacts (written by the jarate-bg wrapper): -rc holds the final
# exit code (EXIT trap), -retry1 marks the one silent-death relaunch (kept
# when the retry did not recover, removed when it did). The watchdog uses
# both to split DEAD into DEAD (generic: SIGKILL/OOM/...) and SILENT
# (rc=1 + no output + unconsumed retry1 = the #57 idle-timeout mode).
has_retry1() {
  [ -f "$BG_TMP/pi-bg-${1}-retry1" ]
}
rc_of() {
  tr -d '[:space:]' < "$BG_TMP/pi-bg-${1}-rc" 2>/dev/null
}

# ─── DEAD-class auto retry (issue #110) ───────────────────────────────────
# State machine, all markers in the run records (a watchdog restart or a
# double sweep is idempotent on them):
#   first death (DEAD, record + stored prompt, no retryOf, no deadRetry)
#     -> cap free: deadRetry={dispatched, ticket=T2}; T2 is launched
#        through the normal jarate-bg launcher (PI_BG_RUN_ID +
#        PI_BG_RETRY_OF=T1 + --wt-reuse <same worktree>); T2's record
#        carries retryOf=T1; T1's record is closed (killed).
#     -> cap full: deadRetry={held} (posted with the DEAD alert); a
#        later sweep (the retry section) fires it on a free slot.
#        A launch that never starts its record (cap race, launch-fail)
#        drops back to held.
#   second death (the retry dies: its record has retryOf)
#     -> embed only + human wake (FAIL-loop rule: one round, then human).
#   HUNG/STALLED: not auto-retried (issue #110 non-goal).
# Precondition: the record stores the task prompt (post-#101). Pre-#101
# records (no prompt file) get the embed only, no retry.
retry_wait="${PI_BG_RETRY_WAIT:-8}"
case "$retry_wait" in '' | *[!0-9]*) retry_wait=8 ;; esac
[ "$retry_wait" -ge 1 ] || retry_wait=1
retry_dispatched=0
retry_held=0

# retry_gate: 0 while the retry machinery runs = non-quiet, or quiet with
# PI_BG_WATCHDOG_RETRY=1. Dry-run never runs it (baseline launches nothing).
retry_gate() {
  [ "$DRY" -eq 0 ] && { [ "$QUIET" -eq 0 ] || [ "$RETRY_ON" -eq 1 ]; }
}

# wd_cap: "<live> <max>" - live-ticket count + resolved cap, SAME rules as
# the jarate-bg launcher (hb-file count, 3-interval window,
# PI_BG_MAX_CONCURRENT / cap file / fleet default 3; 0 = unlimited). The
# launcher re-checks at launch, so a race resolves by the launcher
# refusing (exit 5) and the retry dropping back to held.
wd_cap() {
  local max_c int cutoff live hb
  max_c="${PI_BG_MAX_CONCURRENT:-}"
  if [ -z "$max_c" ] && [ -f "${HOME}/.config/pi-dispatch/max-concurrent" ]; then
    max_c="$(tr -d '[:space:]' < "${HOME}/.config/pi-dispatch/max-concurrent" 2>/dev/null)"
  fi
  [ -z "$max_c" ] && max_c=3
  case "$max_c" in '' | *[!0-9]*) max_c=3 ;; esac
  if [ "$max_c" -eq 0 ]; then
    echo "0 0"
    return 0
  fi
  int="${PI_BG_HB_INTERVAL:-30}"
  case "$int" in '' | *[!0-9]*) int=30 ;; esac
  [ "$int" -ge 1 ] || int=1
  cutoff=$(( $(date +%s) - int * 3 ))
  live=0
  while IFS= read -r hb; do
    live=$((live + 1))
  done < <(find "$BG_TMP" -maxdepth 1 -type f -name 'pi-bg-*-hb' -newermt "@${cutoff}" 2>/dev/null)
  echo "$live $max_c"
}

# wd_rec_fields <ticket>: \x1f-separated record fields, one line
# (\x1f = non-whitespace: bash read collapses consecutive tab delimiters,
# which would swallow the empty fields):
#   state  retryOf  deadRetry.state  deadRetry.ticket  profile  project
#   cwd    wt
# (no line when the record is missing/corrupt; caller must tolerate it).
wd_rec_fields() {
  python3 - "${rec_dir}/pi-bg-${1}.json" <<'PY' 2>/dev/null || true
import json, sys
try:
    rec = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
dr = rec.get("deadRetry") or {}
fields = [rec.get("state"), rec.get("retryOf"), dr.get("state"),
          dr.get("ticket"), rec.get("profile"), rec.get("project"),
          rec.get("cwd"), rec.get("wt")]
print("\x1f".join("" if f is None else str(f) for f in fields))
PY
}

# wd_rec_set_deadretry <ticket> <held|dispatched> <ticket-id|->: the
# deadRetry marker in the original record - the double-dispatch guard.
# "at" is set once (first mark); held rechecks keep it.
wd_rec_set_deadretry() {
  local t="$1" st="$2" tk="$3"
  [ "$tk" = "-" ] && tk=""
  PI_BG_DR_STATE="$st" PI_BG_DR_TICKET="$tk" \
  python3 - "${rec_dir}/pi-bg-${t}.json" <<'PY' 2>/dev/null || true
import datetime, json, os, sys
p = sys.argv[1]
try:
    rec = json.load(open(p))
except Exception:
    sys.exit(0)
dr = rec.get("deadRetry") or {}
dr["state"] = os.environ["PI_BG_DR_STATE"]
if os.environ["PI_BG_DR_TICKET"]:
    dr["ticket"] = os.environ["PI_BG_DR_TICKET"]
dr.setdefault("at", datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"))
rec["deadRetry"] = dr
json.dump(rec, open(p, "w"), indent=2)
PY
}

# wd_rec_close <ticket> <reason>: state=killed + finished (audit path,
# same as the cwd sweep / jarate-bg-kill). Closes the original record
# once its death is owned by the retry chain (or a non-retryable reason).
wd_rec_close() {
  local t="$1" reason="$2"
  PI_BG_REASON="$reason" python3 - "${rec_dir}/pi-bg-${t}.json" <<'PY' 2>/dev/null || true
import datetime, json, os, sys
p = sys.argv[1]
try:
    rec = json.load(open(p))
except Exception:
    sys.exit(0)
rec["state"] = "killed"
rec["reason"] = os.environ["PI_BG_REASON"]
rec["finished"] = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
json.dump(rec, open(p, "w"), indent=2)
PY
}

# wd_chain_live <ticket>: 0 when the record carries a dispatched retry
# chain whose retry record exists. The live process in the ticket's dir is
# then the retry (wt-reuse), the original is dead: the original's stale-hb
# STALLED re-flag after a midnight crossing (today's dead-log dedupe
# expired) is spurious (issue #110, review F3)
wd_chain_live() {
  local drS drT
  IFS=$'\x1f' read -r _ _ drS drT _ _ _ _ < <(wd_rec_fields "$1")
  [ "$drS" = "dispatched" ] && [ -n "$drT" ] && [ -f "${rec_dir}/pi-bg-${drT}.json" ]
}

# wd_retry_launcher: resolve the jarate-bg launcher for the re-dispatch.
# PI_BG_LAUNCHER (test hook) > $HOME/scripts/jarate-bg (the install.sh
# canonical spot - the systemd watchdog env has no ~/scripts on PATH) >
# PATH. rc 1 when none resolves.
wd_retry_launcher() {
  local l="${PI_BG_LAUNCHER:-}"
  [ -n "$l" ] || l="${HOME}/scripts/jarate-bg"
  [ -x "$l" ] && { printf '%s' "$l"; return 0; }
  l="$(command -v jarate-bg 2>/dev/null)" || l=""
  [ -n "$l" ] && { printf '%s' "$l"; return 0; }
  return 1
}

# wd_dead_retry_dispatch <ticket> <wt-dir|->: launch the one auto
# re-dispatch for a dead ticket's first death. Preconditions (record,
# stored prompt, no retryOf, no live dispatch marker) are the CALLER's;
# this function owns the cap decision + the launch + the markers.
# rc: 0 dispatched, 1 held (cap full / launch never started),
#     2 not retryable (launcher/prompt/dir missing -> embed only)
wd_dead_retry_dispatch() {
  local t="$1" wt="$2"
  local pf="$BG_TMP/pi-bg-${t}-prompt.md"
  local launcher prof pj cwd1 wt1 cap live maxc new_id i
  [ -f "${rec_dir}/pi-bg-${t}.json" ] || return 2
  [ -s "$pf" ] || return 2
  launcher="$(wd_retry_launcher)" || return 2
  IFS=$'\x1f' read -r _ _ _ _ prof pj cwd1 wt1 < <(wd_rec_fields "$t")
  case "$prof" in worker | reviewer) ;; *) prof="worker" ;; esac
  # the retry must land in the SAME dir: the sweep's worktree dir first,
  # else the record's wt (new records), else none (cwd run -> its cwd)
  [ -n "$wt" ] && [ "$wt" != "-" ] || wt="$wt1"
  local launchcwd="${cwd1:-$HOME}"
  [ -n "$wt" ] && [ "$wt" != "-" ] && launchcwd="$wt"
  if [ ! -d "$launchcwd" ]; then
    wd_rec_close "$t" "retry not possible: launch dir missing ($launchcwd)"
    echo "[pi-bg-watchdog] retry $t: launch dir missing ($launchcwd) - no retry"
    return 2
  fi
  cap="$(wd_cap)"
  live="${cap%% *}"; maxc="${cap##* }"
  if [ "$maxc" -gt 0 ] && [ "$live" -ge "$maxc" ]; then
    wd_rec_set_deadretry "$t" held "-"
    retry_held=$((retry_held + 1))
    echo "[pi-bg-watchdog] retry $t: HELD (at cap $live/$maxc) - fires on a later sweep"
    return 1
  fi
  new_id="$(date -u +%Y%m%d-%H%M%S)-$RANDOM"
  # marker BEFORE the launch: the deadRetry state is the double-dispatch
  # guard across watchdog restarts / double sweeps
  wd_rec_set_deadretry "$t" dispatched "$new_id"
  local wargs=() pjargs=()
  [ -n "$wt" ] && [ "$wt" != "-" ] && wargs=(--wt-reuse "$wt")
  [ -n "$pj" ] && pjargs=(--project "$pj")
  # pi lives outside the systemd user-service PATH; the retry must reach
  # it the same way a login-shell dispatch does
  local pi_bin
  pi_bin="$(command -v pi 2>/dev/null)" || pi_bin=""
  [ -n "$pi_bin" ] || pi_bin="${HOME}/.pi/agent/bin/pi"
  # same launch path as a normal dispatch: nohup + launcher + cgroup +
  # hb + run record. PI_BG_RUN_ID pins the pre-generated ticket, PI_BG_
  # RETRY_OF tags the new record, the task is the SAME stored prompt.
  ( cd "$launchcwd" && tail -n +3 "$pf" | \
      PI_BG_RUN_ID="$new_id" PI_BG_RETRY_OF="$t" \
      PATH="$(dirname "$pi_bin"):$PATH" \
      nohup "$launcher" "$prof" ${wargs[@]+"${wargs[@]}"} ${pjargs[@]+"${pjargs[@]}"} - \
      > "$BG_TMP/pi-bg-${new_id}-launch.log" 2>&1 & ) \
    < /dev/null > "$BG_TMP/pi-bg-${new_id}-launch.log" 2>&1
  for i in $(seq 1 "$retry_wait"); do
    [ -f "${rec_dir}/pi-bg-${new_id}.json" ] && break
    sleep 1
  done
  if [ ! -f "${rec_dir}/pi-bg-${new_id}.json" ]; then
    # launch failed before its record (cap race, launch-fail, no
    # profile): back to held - a later sweep retries; the DEAD embed
    # was already posted with the retry reason
    wd_rec_set_deadretry "$t" held "-"
    echo "[pi-bg-watchdog] retry $t: launch $new_id did not start - back to held (log: $BG_TMP/pi-bg-${new_id}-launch.log)"
    return 1
  fi
  wd_rec_close "$t" "dead retry dispatched: $new_id (issue #110)"
  retry_dispatched=$((retry_dispatched + 1))
  scope="same worktree"
  if [ -z "$wt" ] || [ "$wt" = "-" ]; then scope="same cwd"; fi
  echo "[pi-bg-watchdog] retry $t: DISPATCHED $new_id (retry_of=$t, $scope)"
  return 0
}

# wd_dead_retry_decide <ticket> <repo> <wt-dir|->: the classification-site
# decision. Sets the global WDR_ACTION (PREPENDED to the DEAD reason; the
# reason kv keeps the head - the embed shows it), empty when the plain
# embed is right. No $( ) capture: the launch below starts a pipeline
# whose list subshell outlives the sweep and must not inherit the
# caller's pipes. Called for DEAD class only (SILENT is owned by #57's
# in-wrapper retry; HUNG/STALLED are not auto-retried).
WDR_ACTION=""
wd_dead_retry_decide() {
  local t="$1" wt="$3" rc
  WDR_ACTION=""
  [ -f "${rec_dir}/pi-bg-${t}.json" ] || return 2  # pre-#51: embed only
  local st rt drS drT
  IFS=$'\x1f' read -r st rt drS drT _ _ _ _ < <(wd_rec_fields "$t")
  if [ -n "$rt" ]; then
    # this record already IS a retry: its death is the second death
    WDR_ACTION="second death in chain (issue #110): retry died - human wake"
    return 2
  fi
  case "$drS" in
    dispatched)
      # crash window / double sweep: reconcile, never re-launch here.
      # (The retry section closes the record; if the retry's record is
      # gone entirely, drop back to held so the cap check runs again.)
      if [ -z "$drT" ] || [ ! -f "${rec_dir}/pi-bg-${drT}.json" ]; then
        wd_rec_set_deadretry "$t" held "-"
        drS="held"
      else
        return 2
      fi
      ;;
  esac
  wd_dead_retry_dispatch "$t" "$wt"
  rc=$?
  case $rc in
    0) WDR_ACTION="retry dispatched (issue #110)" ;;
    1) WDR_ACTION="retry held: at cap - fires on a later sweep (issue #110)" ;;
    *) return 2 ;;
  esac
  return 0
}

# wd_post <body-file>: same retry shape as jarate-bg bg_post (3 attempts)
wd_post() {
  local body="$1" code i
  [ -n "$webhook" ] || return 1
  for i in 1 2 3; do
    code="$(curl -s -o "$BG_TMP/pi-bg-watchdog-wb-resp.txt" -w '%{http_code}' -X POST "$webhook" \
      -H 'Content-Type: application/json' --max-time 15 --data @"$body" 2>/dev/null)" || code="000"
    case "$code" in 2*) return 0 ;; esac
    [ "$i" -lt 3 ] && sleep $((i * 3))
  done
  echo "[pi-bg-watchdog] webhook FAILED (http=$code) for body: $body" >&2
  return 1
}

# wd_build <body-file> <ticket> <repo> <wt-path> <last-activity> <reason> <kind>
# kind: DEAD (generic) or SILENT (issue #57 idle-timeout death)
# embed format mirrors jarate-bg bg_build (author header, framed description
# block, footer). The frame obeys the 40-col mobile budget (FRAME_W,
# docs/STYLE.md 2.3, measured 2026-09-15): bar prefix (2) + 6-col label
# + " : " + 29-col value = 40. Code lines are clipped to the value budget:
# the wt path head-clips (the ticket at the path tail is the discriminator),
# reason/note tail-clip (the classification leads). The full ticket stays
# in the author name; the title drops it (it carries the kind instead).
wd_build() {
  local bodyfile="$1" t="$2" repo="$3" path="$4" last="$5" reason="$6" kind="${7:-DEAD}"
  WD_T="$t" WD_REPO="$repo" WD_PATH="$path" WD_LAST="$last" WD_REASON="$reason" WD_KIND="$kind" \
  python3 - > "$bodyfile" 2>/dev/null <<'PY'
import json, os, sys, datetime
E = lambda k: os.environ.get("WD_" + k, "")
FRAME_W = 40  # mobile budget (docs/STYLE.md 2.3, measured 2026-09-15): every frame line <= 40
def clip_end(s, max):
    s = str(s)
    return s if len(s) <= max else (s[:max - 1] + "\u2026" if max > 1 else "\u2026")
def clip_start(s, max):
    s = str(s)
    return s if len(s) <= max else ("\u2026" + s[len(s) - (max - 1):] if max > 1 else "\u2026")
def kv(key, val, head=False):
    # 2-col bar prefix + 6-col label + " : " + 29-col value = FRAME_W
    cut = clip_start if head else clip_end
    return "\u251c " + key.ljust(6) + " : " + cut(val, FRAME_W - 11)
kind = E('KIND') or 'DEAD'
note = ("silent death (issue #57): rc=1, no output, retry1 did not recover"
        if kind == 'SILENT' else
        "no live process, no completion report - callback lost (SIGKILL/OOM)")
# framed block, same shape as jarate-bg bg_build died (C3, polish sweep):
# the single DEAD/SILENT ticket gets a real 40-col frame, not a bare
# meta dump.
lines = ["\u250c " + kind.lower() + " \u00b7 " + E('T'),
         "\u251c $ jarate-bg-watchdog sweep",
         kv("repo", E('REPO')),
         kv("wt", E('PATH'), head=True),
         kv("last", E('LAST')),
         kv("reason", E('REASON')),
         kv("note", note),
         "\u2514"]
embed = {"author": {"name": f"pi-bg ticket \u00b7 {E('T')}"},
         "color": 15105570,  # orange, same as jarate-bg DIED
         "title": f"{kind} \u00b7 watchdog sweep",
         "description": "```bash\n" + "\n".join(lines) + "\n```",
         "footer": {"text": "pi-bg watchdog"},
         "timestamp": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")}
json.dump({"embeds": [embed]}, sys.stdout)
PY
}

# wd_build_drift <body-file> <hash8> <ts>
# AGENTS.md drift warning (alert-only tripwire). Message format is fixed:
#   AGENTS.md drift: <hash8> since <ts> - review + re-bless: jarate agents-bless "note"
# fenced + wrapped to the 40-col mobile budget (docs/STYLE.md 2.7/2.3).
wd_build_drift() {
  local bodyfile="$1" h8="$2" ts="$3"
  WD_H8="$h8" WD_TS="$ts" python3 - > "$bodyfile" 2>/dev/null <<'PY'
import json, os, sys, datetime
h8 = os.environ.get("WD_H8", "")
ts = os.environ.get("WD_TS", "unknown")
FRAME_W = 40  # mobile budget (docs/STYLE.md 2.3, measured 2026-09-15)
# C9 (polish sweep): raw machine lines are fenced, not clipped to the
# 160-char cap. Wrap at FRAME_W so the fence body obeys the 40-col law.
msg = f'AGENTS.md drift: {h8} since {ts} - review + re-bless: jarate agents-bless "note"'
words, wrapped = msg.split(), []
for w in words:
    if wrapped and len(wrapped[-1]) + 1 + len(w) > FRAME_W:
        wrapped.append(w)
    elif wrapped:
        wrapped[-1] = wrapped[-1] + " " + w
    else:
        wrapped.append(w)
desc = "```\n" + "\n".join(wrapped) + "\n```"
embed = {"author": {"name": "pi-bg watchdog"},
         "color": 15105570,  # orange, same as the DEAD sweep
         "title": "AGENTS.md drift",
         "description": desc,
         "footer": {"text": "pi-bg watchdog"},
         "timestamp": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")}
json.dump({"embeds": [embed]}, sys.stdout)
PY
}

found=0
DT=(); DREPO=(); DP=(); DLAST=(); DREAS=(); DTYPE=()
ST=(); STREPO=(); STL=()
for d in "$WT_DIR"/*/*/; do
  d="${d%/}"
  [ -d "$d" ] || continue
  t="$(basename "$d")"
  repo="$(basename "$(dirname "$d")")"
  # sanity: ticket ids are YYYYMMDD-HHMMSS-NNNNN
  [[ "$t" =~ ^[0-9]{8}-[0-9]{6}-[0-9]+$ ]] || continue
  # 1) live dispatch -> leave alone; STALLED check (issue #52): a live
  #    process whose heartbeat is stale > STALL_MIN min is hung (DEAD needs
  #    the process gone, so without the hb this state was invisible)
  if is_live "$t" "$d"; then
    if hb_stale "$t" && ! already_dead "$t" && ! wd_chain_live "$t"; then
      hb_f="$BG_TMP/pi-bg-${t}-hb"
      [ -f "$hb_f" ] || hb_f="$LEGACY_TMP/pi-bg-${t}-hb"
      hbm="$(stat -c %Y "$hb_f" 2>/dev/null)" || hbm=""
      stall_last="$(date -u -d "@${hbm:-0}" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" || stall_last="unknown"
      echo "[pi-bg-watchdog] STALLED $repo/$t (hb last $stall_last, > ${STALL_MIN} min stale)"
      ST+=("$t"); STREPO+=("$repo"); STL+=("$stall_last")
      printf '%s %s %s %s %s\n' "$today" "$t" "$repo" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "stalled: live process, heartbeat stale > ${STALL_MIN} min" >> "$DEADLOG"
    fi
    continue
  fi
  # 2) normal completion (out.md written) -> callback was posted, worktree kept by design;
  #    killed on purpose (jarate-bg-kill marker) -> not a lost callback. Both
  #    checked in the persistent dir AND legacy /tmp (one release of overlap).
  if has_out "$t" || has_killed "$t" || record_done "$t"; then continue; fi
  # 3) recent activity -> give it time
  mtime="$(stat -c %Y "$d" 2>/dev/null)" || continue
  [ $(( $(date +%s) - mtime )) -gt $((AGE_MIN * 60)) ] || continue
  # 4) dedupe on today's dead letter
  if already_dead "$t"; then continue; fi

  found=$((found + 1))
  last="$(date -u -d "@$mtime" +%Y-%m-%dT%H:%M:%SZ)"
  # SILENT (issue #57): the wrapper recorded exit 1, never produced output,
  # and its one silent-death relaunch (retry1) did not recover. Distinct
  # from generic DEAD: the process path was healthy, the model stream
  # idle-timed-out. rc + retry1 alone prove the run started (retry1 is only
  # touched inside the run loop), so no started-marker requirement. Only
  # claimed when no stronger artifact explains it.
  kind="DEAD"
  if has_deadletter "$t"; then
    reason="webhook dead letter exists (callback attempted, post failed)"
  elif [ "$(rc_of "$t")" = "1" ] && has_retry1 "$t"; then
    kind="SILENT"
    reason="silent death: rc=1, no output, retry1 did not recover (issue #57)"
  elif has_started "$t"; then
    reason="started, no completion marker (callback lost - SIGKILL/OOM)"
  else
    reason="no callback on record (SIGKILL/OOM suspected)"
  fi

  # DEAD-class auto retry (issue #110): the action is PREPENDED to the
  # reason (the reason kv keeps the head - the embed shows it). DRY skips
  # the decision (baseline launches nothing); QUIET skips it unless
  # PI_BG_WATCHDOG_RETRY=1 (retry on, posts off).
  if [ "$kind" = "DEAD" ] && retry_gate; then
    wd_dead_retry_decide "$t" "$repo" "$d" || true
    [ -n "$WDR_ACTION" ] && reason="$WDR_ACTION: $reason"
  fi

  # #51 sticky terminal: mark the run record killed (same audit path as
  # the cwd sweep) so the per-day dead-log dedupe expiring cannot re-flag
  # this death with a SECOND terminal embed. A worktree SIGKILL used to
  # leave the record "running" and re-flag daily. HELD records stay
  # state=running on purpose (the #110 retry section re-decides them
  # daily, issue #110 review F1); records already at a terminal state
  # (done/killed/cancelled) are never touched.
  if [ "$DRY" -eq 0 ]; then
    IFS=$'\x1f' read -r rst _ drS _ _ _ _ _ < <(wd_rec_fields "$t")
    if [ "$rst" = "running" ] && [ "$drS" != "held" ]; then
      PI_BG_REC_STATE="killed" python3 - "$rec_dir/pi-bg-${t}.json" <<'PY' 2>/dev/null || true
import datetime, json, os, sys
p = sys.argv[1]
try:
    rec = json.load(open(p))
except Exception:
    sys.exit(0)
rec["state"] = os.environ.get("PI_BG_REC_STATE", "killed")
rec["finished"] = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
json.dump(rec, open(p, "w"), indent=2)
PY
    fi
  fi

  echo "[pi-bg-watchdog] $kind $repo/$t (last activity $last, $reason)"
  DT+=("$t"); DREPO+=("$repo"); DP+=("$d"); DLAST+=("$last"); DREAS+=("$reason"); DTYPE+=("$kind")
  printf '%s %s %s %s %s\n' "$today" "$t" "$repo" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$reason" >> "$DEADLOG"
done

# ─── cwd-ticket sweep (issue #86): non-worktree dispatches ──────────────────
# The sweep above enumerates $WT_DIR/*/*/ only; runs without --worktree
# leave no dir there and were invisible to DEAD detection. 2026-09-25:
# four cwd workers were SIGKILLed by the orchestrator's own cleanup loop,
# posted no callback, kept state=running records, and this watchdog found
# "0 dead, 0 stalled".
#
# DEAD (cwd) = ALL of:
#   - run record state=running (the wrapper's exit trap never ran)
#   - the ticket cgroup is EMPTY (no member in cgroup.procs/threads -
#     "stale" means no processes; a live member keeps the ticket out of
#     this sweep) OR its dir is ABSENT. A missing dir is a reap (the
#     empty-cgroup reaper, manual cleanup) or an escape that never
#     happened - NOT a fresh-start signal once the heartbeat is stale
#     (issue #116: the reaper rmdir'd the dir in the fresh-hb window,
#     ate this sweep's evidence, and the DEAD post never fired for ~2/3
#     of qualifying SIGKILLed cwd runs)
#   - the heartbeat file is stale > STALL_MIN min (fresh hb = healthy;
#     absent hb = pre-upgrade run, not judgeable -> never flagged here)
# On DEAD: post the dead webhook (same payload as the worktree sweep),
# append the dead log (same today-dedupe), reap the empty cgroup via the
# guarded cgroup.kill, and mark the record state=killed (same audit path
# as jarate-bg-kill, so the record stops lying "running").
cwd_found=0
if [ -d "$rec_dir" ]; then
  while IFS=$'\t' read -r rt rcwd rwt; do
    [ -n "$rt" ] || continue
    [[ "$rt" =~ ^[0-9]{8}-[0-9]{6}-[0-9]+$ ]] || continue
    # wt-chain run (a retry re-dispatched with --wt-reuse carries the
    # original's wt on its record): its death shows the repo name, not
    # "cwd" (issue #110, review F4)
    repo="cwd"
    if [ -n "$rwt" ]; then
      rrepo="$(basename "$(dirname "$rwt")" 2>/dev/null)"
      case "$rrepo" in . | "" | "/") rrepo="" ;; esac
      [ -n "$rrepo" ] && repo="$rrepo"
    fi
    cg="$CG_DIR/$rt"
    if [ -d "$cg" ]; then
      cg_has_members "$cg" && continue  # live member -> not stale
      cg_state="empty"
    else
      # issue #116: no dir = reaped (this sweep's empty-cgroup reaper, or
      # manual cleanup) or cgroup escape never happened. Both are judgeable:
      # the dir itself is not the evidence, the record + heartbeat are.
      cg_state="reaped"
    fi
    hb_stale "$rt" || continue        # fresh/absent hb -> not DEAD
    has_out "$rt" && continue         # completed normally (record unclosed)
    has_killed "$rt" && continue      # jarate-bg-kill already reported it
    already_dead "$rt" && continue    # flagged earlier today
    if [ "$DRY" -eq 1 ]; then
      echo "[pi-bg-watchdog] dry-run: would flag cwd ticket DEAD $rt (cgroup $cg_state, hb stale)"
      continue
    fi
    # last activity = the heartbeat mtime: the hb child touched it every
    # 30s while the wrapper lived, so its mtime is the death clock
    hb_f="$BG_TMP/pi-bg-${rt}-hb"
    [ -f "$hb_f" ] || hb_f="$LEGACY_TMP/pi-bg-${rt}-hb"
    hbm="$(stat -c %Y "$hb_f" 2>/dev/null)" || hbm=""
    last="$(date -u -d "@${hbm:-0}" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null)" || last="unknown"
    if [ "$cg_state" = "reaped" ]; then
      reason="cwd run: cgroup reaped (dir gone), heartbeat stale > ${STALL_MIN} min (issue #116)"
    else
      reason="cwd run: cgroup empty, heartbeat stale > ${STALL_MIN} min (issue #86)"
    fi
    # DEAD-class auto retry (issue #110): the cwd sweep owns a retry's
    # SECOND death (the retry reuses the original's worktree dir, so the
    # dir sweep has already closed the original and skips it). When the
    # decision leaves the record HELD, the audit kill-mark below is
    # skipped: a held record must stay state=running or the retry section
    # (running-only filter) never re-checks its cap and the retry is
    # dropped forever (issue #110, review F1). Same-day re-flag is
    # suppressed by the dead-log dedupe above; a cross-day re-flag
    # re-decides via the held marker.
    drS=""
    if retry_gate; then
      wd_dead_retry_decide "$rt" "cwd" "-" || true
      [ -n "$WDR_ACTION" ] && reason="$WDR_ACTION: $reason"
      IFS=$'\x1f' read -r _ _ drS _ _ _ _ _ < <(wd_rec_fields "$rt")
    fi
    echo "[pi-bg-watchdog] DEAD $repo/$rt (last activity $last, $reason)"
    DT+=("$rt"); DREPO+=("$repo"); DP+=("${rcwd:--}")
    DLAST+=("$last"); DREAS+=("$reason"); DTYPE+=("DEAD")
    printf '%s %s %s %s %s\n' "$today" "$rt" "$repo" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$reason" >> "$DEADLOG"
    # cgroup cleanup: guarded cgroup.kill (memberless only, issue #86),
    # drop the plain-file leftovers a non-cgroupfs test root keeps, rmdir
    cg_kill_guarded "$cg"
    rm -f "$cg/cgroup.procs" "$cg/cgroup.kill" 2>/dev/null
    rmdir "$cg" 2>/dev/null
    # mark the record killed (issue #51 audit path, same as jarate-bg-kill):
    # audit-only, never breaks the sweep; skipped for a held record (above)
    if [ "$drS" != "held" ]; then
      PI_BG_REC_STATE="killed" python3 - "$rec_dir/pi-bg-${rt}.json" <<'PY' 2>/dev/null || true
import datetime, json, os, sys
p = sys.argv[1]
try:
    rec = json.load(open(p))
except Exception:
    sys.exit(0)
rec["state"] = os.environ.get("PI_BG_REC_STATE", "killed")
rec["finished"] = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
json.dump(rec, open(p, "w"), indent=2)
PY
    fi
    cwd_found=$((cwd_found + 1))
    found=$((found + 1))
  done < <(python3 - "$rec_dir" <<'PY' 2>/dev/null
import glob, json, os, sys
d = sys.argv[1]
for f in sorted(glob.glob(os.path.join(d, "pi-bg-*.json"))):
    try:
        rec = json.load(open(f))
    except Exception:
        continue
    if rec.get("state") != "running":
        continue
    run = str(rec.get("run") or "")
    if not run:
        continue
    print(f"{run}\t{rec.get('cwd') or ''}\t{rec.get('wt') or ''}")
PY
  )
fi
[ "$cwd_found" -gt 0 ] && echo "[pi-bg-watchdog] flagged $cwd_found dead cwd ticket(s)"

# ─── DEAD retry (issue #110): held + crashed-window records ────────────────
# deadRetry markers in run records (issue #51 audit trail), handled here
# instead of only at the DEAD classification site because the
# classification is dead-log deduped for the day - a retry held at a full
# cap would otherwise wait until tomorrow. Two cases per record:
#   held: first death at a full cap - fire it now if a slot freed.
#   dispatched + still running: watchdog died between the mark and the
#     record close - reconcile (close if the retry's record exists, else
#     drop back to held so the cap check runs again). Never re-launchs:
#     a dispatched marker with a live retry record means the chain is
#     already owned.
if retry_gate && [ -d "$rec_dir" ]; then
  retry_list="$(python3 - "$rec_dir" <<'PY' 2>/dev/null
import glob, json, os, sys
d = sys.argv[1]
for f in sorted(glob.glob(os.path.join(d, "pi-bg-*.json"))):
    try:
        rec = json.load(open(f))
    except Exception:
        continue
    dr = rec.get("deadRetry") or {}
    if dr.get("state") not in ("held", "dispatched"):
        continue
    if rec.get("state") != "running":
        continue
    run = str(rec.get("run") or "")
    if run:
        print(run + "\t" + str(dr.get("state")))
PY
)"
  while IFS=$'\t' read -r hrt hstate; do
    [ -n "$hrt" ] || continue
    [[ "$hrt" =~ ^[0-9]{8}-[0-9]{6}-[0-9]+$ ]] || continue
    if [ "$hstate" = "dispatched" ]; then
      IFS=$'\x1f' read -r _ _ _ hdt _ _ _ _ < <(wd_rec_fields "$hrt")
      if [ -n "$hdt" ] && [ -f "${rec_dir}/pi-bg-${hdt}.json" ]; then
        wd_rec_close "$hrt" "dead retry chain: $hdt (issue #110)"
        echo "[pi-bg-watchdog] retry $hrt: chain confirmed ($hdt) - record closed"
      else
        wd_rec_set_deadretry "$hrt" held "-"
        echo "[pi-bg-watchdog] retry $hrt: dispatch marker without a record - back to held"
      fi
      continue
    fi
    # held: cap recheck + launch (dispatch re-marks held when still full)
    hwt=""
    IFS=$'\x1f' read -r _ _ _ _ _ _ _ hwt < <(wd_rec_fields "$hrt")
    if [ -z "$hwt" ]; then
      for cand in "$WT_DIR"/*/"$hrt"; do
        [ -d "$cand" ] && { hwt="$cand"; break; }
      done
    fi
    wd_dead_retry_dispatch "$hrt" "${hwt:--}" || true
  done <<< "$retry_list"
fi

# ─── HUNG sweep (issue #142): alive tree, quiet session ────────────────────────
# HUNG = ALL of:
#   - run record state=running WITHOUT the hungNotified flag (at most ONE
#     HUNG per run; the flag is written only after a successful post, so a
#     dead webhook retries on the next sweep - drift pattern)
#   - the process tree is ALIVE: a ticket-cgroup member, or a same-user
#     process in the ticket's worktree dir (same liveness as is_live)
#   - the profile session jsonl for the run's pi cwd (newest after the
#     record's started ts, same discovery as jarate-bg bg_session_file)
#     has no write for > HUNG_MIN min (default 30, PI_BG_HUNG_MIN)
# On HUNG: red embed (same webhook + post path as DIED; red = alive but
# stuck, as STALLED - DEAD is orange) + stdout line. NEVER kills: HUNG
# informs + wakes; the existing DIED path fires unchanged if the process
# later dies (the flag does not touch state).
HUNG_MIN="${PI_BG_HUNG_MIN:-30}"
case "$HUNG_MIN" in
  '' | *[!0-9]*) HUNG_MIN=30 ;;
esac
[ "$HUNG_MIN" -ge 1 ] || HUNG_MIN=30

# cg_members <ticket>: pids held by the ticket cgroup. Fake-file test
# roots (plain cgroup.procs files) read the same way as cgroupfs.
cg_members() {
  local d="$CG_DIR/$1"
  { cat "$d/cgroup.procs" 2>/dev/null; cat "$d/cgroup.threads" 2>/dev/null; } | tr -s '[:space:]' '\n' | grep -E '^[0-9]+$'
}

# hung_root <ticket>: the process to hang-tree from = the OLDEST member.
# In a real run the wrapper joined the ticket cgroup first (then pi, then
# the hb child), so it is the oldest; the pstree from it covers the whole
# tree. A leaked pi (wrapper gone) or a test cgroup with a bare child
# degrades gracefully: the oldest member stands in. No members -> prints
# nothing (caller degrades gracefully).
hung_root() {
  local t="$1" p e root et
  root=""; et=-1
  for p in $(cg_members "$t"); do
    e="$(ps -o etimes= -p "$p" 2>/dev/null | tr -d '[:space:]')" || continue
    [ -n "$e" ] && [ "$e" -gt "$et" ] && { et="$e"; root="$p"; }
  done
  [ -n "$root" ] && echo "$root"
  return 0
}

# hung_child <root>: the hang candidate in the root's tree. Longest-lived
# process among the root's DESCENDANTS (the wrapper itself is bookkeeping,
# not the hang - skip it when descendants exist); the root stands in when
# it has no descendants (a bare hung pi, or a test cgroup). Prints
# "<pid> <comm> <etimes-s> <cmdline>"; nothing when the root is gone.
hung_child() {
  local root="$1" p c e best="" beste=-1
  # one pass over /proc for the whole-box ppid map. comm (field 2 of
  # /proc/<pid>/stat, parenthesized) may contain spaces, so strip through
  # the LAST ')' (greedy) and take $2 of the remainder (state $1, ppid $2)
  local ppid_map
  ppid_map="$(awk '{ line = $0; sub(/^.*) /, "", line); split(line, a, " "); if (a[2] != "") print FILENAME, a[2] }' /proc/[0-9]*/stat 2>/dev/null \
    | sed -E 's|^/proc/([0-9]+)/stat[[:space:]]+(.*)$|\1 \2|')"
  local -A kids=()
  while read -r c e; do
    [ -n "$c" ] && [ -n "$e" ] && kids["$e"]+=" $c"
  done <<< "$ppid_map"
  local -a stack=("$root")
  local seen=""  # descendants only (root excluded: bookkeeping)
  while [ "${#stack[@]}" -gt 0 ]; do
    p="${stack[0]}"; stack=("${stack[@]:1}")
    for c in ${kids["$p"]:-}; do
      case " $seen " in *" $c "*) continue ;; esac
      seen+="$c "
      stack+=("$c")
    done
  done
  if [ -z "${seen// /}" ]; then
    seen="$root"  # no descendants: the root itself is the candidate
  fi
  for p in $seen; do
    [ -d "/proc/$p" ] || continue
    e="$(ps -o etimes= -p "$p" 2>/dev/null | tr -d '[:space:]')" || continue
    [ -n "$e" ] && [ "$e" -gt "$beste" ] && { beste="$e"; best="$p"; }
  done
  [ -n "$best" ] || return 0
  local comm cmd
  comm="$(ps -o comm= -p "$best" 2>/dev/null | head -1)"
  cmd="$(tr '\0' ' ' < "/proc/$best/cmdline" 2>/dev/null | sed 's/[[:space:]]\{1,\}/ /g; s/^ //; s/ $//')"
  printf '%s %s %s %s\n' "$best" "${comm:-?}" "$beste" "${cmd:-${comm:-?}}"
}

# wd_build_hung <body-file> <ticket> <repo> <jsonl-last> <silent-min> <hb-last>
# <child-line> <child-cmd> <tree>
# Frame obeys the 40-col mobile budget (FRAME_W, docs/STYLE.md 2.3); the
# raw pstree wraps to the 29-col value budget with the 2.2 continuation
# gutter. Title carries HUNG + run id (task spec); the full ticket also
# stays in the author name (pi-bg convention).
wd_build_hung() {
  local bodyfile="$1" t="$2" repo="$3" jlast="$4" silent="$5" hblast="$6" child="$7" ccmd="$8" tree="$9"
  WD_H_T="$t" WD_H_REPO="$repo" WD_H_JLAST="$jlast" WD_H_SILENT="$silent" \
  WD_H_HB="$hblast" WD_H_CHILD="$child" WD_H_CMD="$ccmd" WD_H_TREE="$tree" \
  python3 - > "$bodyfile" 2>/dev/null <<'PY'
import json, os, sys, datetime
E = lambda k: os.environ.get("WD_H_" + k, "")
FRAME_W = 40  # mobile budget (docs/STYLE.md 2.3)
VAL_W = FRAME_W - 11  # 29-col value budget (kv layout, same as wd_build)
def clip_end(s, max):
    s = str(s)
    return s if len(s) <= max else (s[:max - 1] + "\u2026" if max > 1 else "\u2026")
def kv(key, val):
    return "\u251c " + key.ljust(6) + " : " + clip_end(val, VAL_W)
def wrap(s, width):
    out = []
    for line in str(s).splitlines():
        while len(line) > width:
            out.append(line[:width])
            line = line[width:]
        out.append(line)
    return out
t = E('T')
lines = ["\u250c hung \u00b7 " + t,
         "\u251c $ jarate-bg-watchdog",
         kv("repo", E('REPO') or "cwd"),
         kv("jsonl", E('JLAST')),
         kv("silent", str(E('SILENT')) + "m no session write"),
         kv("hb", E('HB')),
         kv("child", E('CHILD')),
         kv("cmd", E('CMD'))]
tree = [l for l in wrap(E('TREE'), VAL_W) if l]
if tree:
    lines.append("\u251c tree   : " + clip_end(tree[0], VAL_W))
    for cont in tree[1:]:
        lines.append("\u2502 " + clip_end(cont, VAL_W - 1))
lines.append("\u2514")
embed = {"author": {"name": f"pi-bg ticket \u00b7 {t}"},
         "color": 15158332,  # red: alive but stuck (as STALLED; DEAD is orange)
         "title": f"HUNG \u00b7 {t}",
         "description": "```bash\n" + "\n".join(lines) + "\n```",
         "footer": {"text": "pi-bg watchdog (hung)"},
         "timestamp": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")}
json.dump({"embeds": [embed]}, sys.stdout)
PY
}

