# ─── empty cgroup reaper (2026-09-14, issue: pi-bg cgroup-dir leak) ─────────
# A ticket dir that holds no process is a leak: a live run always keeps at
# least the wrapper shell in its escape cgroup. Untrappable deaths (bun
# test SIGKILL/timeout, pi.service restart, OOM) kill the wrapper before
# its exit-trap self-drain; the kernel then drops the cgroup files when the
# last member dies, leaving an empty dir that accumulates in $CG_DIR.
# rmdir them: members present -> untouched; rmdir failing (busy race, or a
# plain-file test root with a leftover fake procs file) -> skip silently.
reaped=0
skipped_young=0
# issue #101 (20260928-095136-360941): the reaper rmdirs'ed a FRESH ticket
# cgroup - created seconds earlier by a concurrent dispatch - because the
# empty test had no age guard. Two belt changes:
#   (a) AGE GUARD: never reap a dir younger than REAPER_MIN_AGE (default
#       300s; override PI_BG_REAPER_MIN_AGE). Dir mtime = creation time on
#       cgroupfs (writing cgroup.procs does not bump it), so this is exactly
#       the dispatch-race window, harmless after.
#   (b) LIVE PATH = rmdir alone: rmdir fails on a non-empty dir, which IS
#       the atomic emptiness test. The cg_has_members read-then-rmdir
#       pre-check only adds a race window (monky, #101). Dry-run keeps the
#       pre-check: it must report would-reap without touching the dir.
REAPER_MIN_AGE="${PI_BG_REAPER_MIN_AGE:-300}"
now_s="$(date +%s)"
for cg in "$CG_DIR"/*/; do
  cg="${cg%/}"
  [ -d "$cg" ] || continue
  cg_age=$(( now_s - $(stat -c %Y "$cg" 2>/dev/null || echo 0) ))
  if [ "$cg_age" -lt "$REAPER_MIN_AGE" ]; then
    skipped_young=$(( skipped_young + 1 ))
    continue
  fi
  if [ "$DRY" -eq 1 ]; then
    cg_has_members "$cg" && continue
    echo "[pi-bg-watchdog] dry-run: would reap empty cgroup $cg"
  elif rmdir "$cg" 2>/dev/null; then
    echo "[pi-bg-watchdog] reaped empty cgroup $cg"
    reaped=$(( reaped + 1 ))
  fi
done
[ "$reaped" -gt 0 ] && echo "[pi-bg-watchdog] reaped $reaped empty cgroup dir(s)"
[ "$skipped_young" -gt 0 ] && echo "[pi-bg-watchdog] skipped $skipped_young young cgroup dir(s) (age < ${REAPER_MIN_AGE}s, issue #101)"

