#!/usr/bin/env bash
# pi-bg — one-shot pi agent on a role profile (no Discord presence)
# profiles: worker (131k ctx, medium thinking) | reviewer (131k ctx, xhigh thinking)
# usage: cd <workdir> && pi-bg [worker|reviewer] [--worktree <ref>] [--project <tag>] [pi flags...] "task"
#   (workdir must be a git repo for --worktree; plain runs work anywhere)
#   pi-bg --help prints this header.
#
# --worktree [ref]: run the agent in a fresh git worktree instead of the live
#   checkout. ref defaults to HEAD (only consumed as ref when more args
#   follow it — otherwise the next arg is the task). Worktree:
#   $PI_BG_WT_DIR/<repo>/<id> (default ~/.pi-bg-wt/<repo>/<id>),
#   branch pi-bg/<id>. The worktree is KEPT after the run so the orchestrator
#   can diff/commit/merge it; path + branch are printed and in the callback.
#
# --project <tag>: project tag for invoice itemisation (2026-09-18).
#   tag: [a-z0-9][a-z0-9-]{0,31}, one per run; invalid/missing value =
#   usage error (rc 2, no side effects). Stored in the run record
#   ("project": tag | null). At exit the run's session tokens +
#   OpenRouter-list cost (qwen/qwen3.8-27b rate, 24h price cache in
#   $PI_BG_TMPDIR/pi-bg-price-cache.json) are attributed to the record
#   and one "│ pj <tag> · $<cost>" line is appended to the callback
#   embed. Cost capture is bounded + failure-tolerant: it never blocks
#   or fails the callback (no session file / price error -> null fields).
#
#   jarate projects / projects-backfill roll up records by tag (docs/JARATE.md).
#
# On completion, posts a callback to the configured Discord webhook:
#   webhook URL from $PI_DISPATCH_WEBHOOK or ~/.config/pi-dispatch/webhook
#   (file absent = no callback; stdout is always printed)
# Callback delivery (issue #14, 2026-09-10): the callback is the ONLY wake
#   mechanism for the orchestrator, so it is hardened:
#   - curl: 3 attempts, backoff 3s/6s, --max-time 15; non-2xx retried
#   - fallback: if the process exits before out.md exists/is non-empty and no
#     callback was posted, an EXIT/TERM/INT trap posts a 'DIED (no report)'
#     callback so a killed worker still wakes the orchestrator
#     (SIGKILL cannot be trapped - see DISPATCH.md recommendations)
#   - SILENT death (issue #57): exit 1, no output, death <15 min after the
#     last activity (mid-LLM-call idle timeout) -> the SAME ticket is
#     relaunched ONCE; a <ticket>.retry1 marker is written before the
#     relaunch so a second silent death reports a normal FAIL instead of
#     looping. Leftover SILENT tickets are classified distinctly from
#     generic DEAD by the pi-bg-watchdog sweep.
#   - dead letter: final post failure writes $PI_BG_TMPDIR/pi-bg-<id>-webhook-failed
#     (PI_BG_TMPDIR default ~/.pi-bg-art; honored by pi-bg-tail/-kill/-watchdog//jobs)
# Fresh machine (issue #29): a missing/empty role profile is seeded from the
#   main agent's ~/.pi/agent/{auth,models}.json + the repo template
#   dispatch/profiles/<role>.json (settings). Still no provider => exit 4
#   with instructions — never a silent empty-completion retry loop.
# No webhook (issue #30): loud warning at dispatch + a run record in
#   ~/.pi-dispatch/runs/pi-bg-<id>.json marked "delivery":"none".
# Heartbeat (issue #52): $PI_BG_TMPDIR/pi-bg-<id>-hb is touched by a
#   background child every 30s ($PI_BG_HB_INTERVAL test override); the
#   exit trap kills it so it never outlives the run. The watchdog: live
#   process + hb stale > 10 min = STALLED (a hung run, distinct from DEAD).
# Run record state (issue #51): "running" at dispatch, "done" on every
#   trapped exit, "killed" when pi-bg-kill finalizes the ticket.
# Concurrency cap (issue #41): at most $PI_BG_MAX_CONCURRENT live pi-bg
#   runs per user (0 = unlimited, operator escape hatch). Fleet default is
#   3; a per-box override file ~/.config/pi-dispatch/max-concurrent (one
#   integer) applies when the env var is unset (RCA #57 fix 2: monky's box
#   pins 2 - shared vLLM queue load). The
#   fleet shares one vLLM endpoint; unbounded fan-out starved the prefix
#   cache (2026-09-10 incident). The check runs BEFORE the agent's exec:
#   count = this uid's live processes whose args contain "pi-bg worker" or
#   "pi-bg reviewer" (the wrapper lives for the whole run: pi + callback),
#   excluding this process ($$). pi-bg-kill/-tail/
#   -watchdog, pi-wait and other users' processes never match. The count
#   scans /proc/<pid>/status + cmdline in this shell (no ps/grep
#   children): a forked helper keeps this wrapper's argv until it execs,
#   and a wrapper checking at the same instant would count it as a
#   phantom run. At cap: one stderr line + exit 5, with no
#   worktree/cgroup/run-record side effects. Fails open if /proc is
#   unreadable (a cap check must never block dispatch):
#     [!] at cap (N/M), try again later or pi-bg-kill a ticket
#
# Session isolation (issue #56): the ticket runs in its OWN session +
#   process group (a guarded setsid re-exec at the top of the script).
#   The launcher's tool call runs `nohup pi-bg ... &` from a bash the
#   harness spawned DETACHED (own session + PGID); without setsid the
#   ticket's pi child stays in the LAUNCHER's PGID, so a harness
#   bash-tool timeout that signals that PG kills a still-starting ticket
#   (2026-09-13: nested tickets died rc=143 inside `git worktree add`).
#   Blessed launch form (stays; now safe even if the tool call blocks in
#   wait4() on the ticket until the harness timeout):
#     cd <workdir> && nohup ~/scripts/pi-bg worker "task" > log 2>&1 & \
#     sleep 4; head -1 log
#   pi-bg-kill compensates: it signals the ticket's process group in
#   addition to the per-pid cgroup walk, so the whole session dies
#   together and no pi child orphans.
#
# Belt (issue #56): the ticket id line is printed BEFORE the slow
#   `git worktree add` (big repos: >60s), so the launcher's `head -1 log`
#   returns immediately and a dead ticket leaves an identifiable first
#   log line.

set -uo pipefail

# Original argv captured BEFORE any consumption (the profile shift and the
# --worktree strip below mutate $@): the deploy-swap snapshot exec re-passes
# the FULL original argument list to the snapshot process.
PI_BG_ORIG_ARGS=("$@")

# -h/--help: print this header
if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  sed -n '2,/^set -uo pipefail$/{ /^set -uo pipefail$/d; p }' "$0" | sed 's/^# \{0,1\}//'
  exit 0
fi

# --- session isolation (issue #56): own session + PGID via setsid -------
# Re-exec ONCE under setsid: this process becomes a new session leader and
# process-group leader; the pi child inherits both. A signal aimed at the
# launcher's PGID (harness bash-tool timeout/abort) can no longer reach
# the ticket. Cgroup escape below already isolated the cgroup axis; this
# isolates the PGID axis. Guard: $PI_BG_SETSID (set for the re-exec so it
# happens once). A box without a setsid binary keeps the legacy behavior
# instead of breaking dispatch entirely.
if [ "${PI_BG_SETSID:-0}" != "1" ] && command -v setsid >/dev/null 2>&1; then
  PI_BG_SETSID=1 exec setsid bash "$0" "$@"
fi

profile="${1:-worker}"
case "$profile" in
  worker|reviewer) shift ;;
  *) echo "unknown profile: $profile (want worker|reviewer)" >&2; exit 2 ;;
esac

export PI_CODING_AGENT_DIR="${HOME}/.pi/agent-${profile}"

# --- optional --worktree [ref] + --project <tag> (consumed before pi flags) ---
# builtin-only on purpose: this zone must stay fork-free for the cap
# check below (a forked child keeps this wrapper's argv until it execs;
# a sibling wrapper scanning at the same instant would count it).
wt_ref=""
wt_mode=0
pj_tag=""
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --worktree)
      wt_mode=1
      shift
      # ref is the next arg only if something follows and it is not another flag
      if [ $# -ge 2 ] && [ "${1#-}" = "$1" ]; then wt_ref="$1"; shift; fi
      ;;
    --project)
      # usage errors here: rc 2, one stderr line, no side effects (the run
      # record, worktree add and cgroup escape all happen after this zone)
      shift
      [ $# -ge 1 ] || { echo "pi-bg: --project needs a value (tag: [a-z0-9][a-z0-9-]{0,31})" >&2; exit 2; }
      [ -z "$pj_tag" ] || { echo "pi-bg: --project given twice (one tag per run)" >&2; exit 2; }
      pj_tag="$1"
      [[ "$pj_tag" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || { echo "pi-bg: invalid --project tag: $pj_tag (want [a-z0-9][a-z0-9-]{0,31})" >&2; exit 2; }
      shift
      ;;
    *)
      args+=("$1")
      shift
      ;;
  esac
done
set -- "${args[@]+"${args[@]}"}"

# --- concurrency cap (issue #41): refuse to start when this user already
#     has $PI_BG_MAX_CONCURRENT live pi-bg worker/reviewer runs (0 =
#     unlimited). Counted via the fleet-rule arg pattern (args contain
#     "pi-bg worker" or "pi-bg reviewer"), scoped to this uid, excluding
#     this process (it has not exec'd the agent yet). pi-bg-kill/-tail/
#     -watchdog, pi-wait and other users' processes never match. The
#     scan reads /proc/<pid>/status + cmdline in this shell (no
#     ps/grep children) and runs in the fork-free zone above: a forked
#     helper keeps this wrapper's argv until it execs, and a wrapper
#     checking at the same instant would count it as a phantom run. A
#     match whose parent has the identical cmdline (forked helper of
#     ANOTHER wrapper, mid-exec) is skipped the same way.
#     Runs before the worktree add, cgroup escape and run record so a
#     refused dispatch leaves no side effects. Fails open if /proc is
#     unreadable (a cap check must never block dispatch).
# Per-box cap file (RCA #57 fix 2): when PI_BG_MAX_CONCURRENT is unset,
# ~/.config/pi-dispatch/max-concurrent (one integer) overrides the fleet
# default of 3. The env var still wins for per-dispatch overrides.
max_c="${PI_BG_MAX_CONCURRENT:-}"
if [ -z "$max_c" ] && [ -f "${HOME}/.config/pi-dispatch/max-concurrent" ]; then
  max_c="$(tr -d '[:space:]' < "${HOME}/.config/pi-dispatch/max-concurrent" 2>/dev/null)"
fi
# env unset + no cap file (or empty file) = fleet default, no warning;
# the validation below only fires on a NON-EMPTY invalid value.
[ -z "$max_c" ] && max_c=3
case "$max_c" in
  '' | *[!0-9]*)
    echo "[!] PI_BG_MAX_CONCURRENT='$max_c' is not a non-negative integer, using 3" >&2
    max_c=3
    ;;
esac
if [ "$max_c" -gt 0 ]; then
  # own uid from /proc/self/status ("Uid:\t<real>\t<eff>\t<saved>\t<fs>")
  me_uid=""
  while IFS= read -r _l; do
    case "$_l" in
      Uid:*) IFS=$' \t' read -r _u0 me_uid _ <<<"$_l"; break ;;
    esac
  done 2>/dev/null < /proc/self/status || true
  live=0
  if [ -n "$me_uid" ]; then
    for d in /proc/[0-9]*; do
      pid="${d#/proc/}"
      [ "$pid" = "$$" ] && continue
      # gate on the Uid line: as non-root, other users' status is
      # usually unreadable (loop below simply skips it); as root the
      # comparison filters explicitly
      uid_ok=0
      while IFS= read -r _l; do
        case "$_l" in
          Uid:*)
            IFS=$' \t' read -r _u0 _u1 _ <<<"$_l"
            [ "$_u1" = "$me_uid" ] && uid_ok=1
            break
            ;;
        esac
      done 2>/dev/null < "$d/status"
      [ "$uid_ok" = 1 ] || continue
      mapfile -d '' _argv 2>/dev/null < "$d/cmdline" || continue
      # Match on argv ELEMENTS (review F1): a launcher "bash -c" carries
      # "pi-bg worker" inside one -c string, so a substring test over the
      # joined argv double-counted it. Require an element whose basename is
      # pi-bg immediately followed by a worker|reviewer element.
      _match=0
      _n=${#_argv[@]}
      for ((i = 0; i < _n; i++)); do
        if [ "${_argv[i]##*/}" = "pi-bg" ] && [ $((i + 1)) -lt "$_n" ]; then
          case "${_argv[i + 1]}" in
            worker | reviewer) _match=1 ;;
          esac
        fi
      done
      [ "$_match" = 1 ] || continue
      # fork-window phantom: a child of a process with the IDENTICAL
      # cmdline is a forked helper that has not exec'd yet (it keeps
      # the parent's argv); a real run's parent (launcher, bun,
      # nohup) always has a different cmdline
      _stat=$(<"$d/stat") 2>/dev/null || _stat=""
      _ppid=""
      if [ -n "$_stat" ]; then
        _tail="${_stat##*) }"
        read -r _ _ppid _ <<<"$_tail"
      fi
      _pargv=()
      [ -n "$_ppid" ] && mapfile -d '' _pargv 2>/dev/null < "/proc/$_ppid/cmdline"
      if [ "${_pargv[*]}" != "${_argv[*]}" ]; then
        live=$((live + 1))
      fi
    done
  fi
  if [ "$live" -ge "$max_c" ]; then
    echo "[!] at cap (${live}/${max_c}), try again later or pi-bg-kill a ticket" >&2
    exit 5
  fi
fi

# repo root (script lives in <repo>/dispatch) - profile templates + censor.
# Resolve symlinks first (issue #37): the normal launch is the
# ~/scripts/pi-bg symlink install.sh creates, and with the unresolved link
# path JB_ROOT would be $HOME, so the settings.json seed lookup at
# $JB_ROOT/dispatch/profiles/<role>.json silently missed (fresh role got
# auth+models but no settings.json -> pi fell back to its built-in
# provider -> 402). Fallback keeps the old behavior if readlink fails.
# JB_ROOT_SNAPPED: the per-run snapshot exec (deploy-swap guard below)
# runs bash on a hard link outside the repo, so BASH_SOURCE there would
# resolve the wrong root - the original process passes its own.
JB_ROOT="${JB_ROOT_SNAPPED:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")")/.." 2>/dev/null && pwd)}"

# --- per-run switchboard session id (unique ledger entry per dispatch) ---
# Unique per run: second-precision timestamp + this wrapper's own pid ($$).
# Concurrent wrappers always have different pids, so per-run temp file
# names (pi-bg-<run_id>*) can never collide. Shape constraint: the v3
# embed headers carry the full rid inside the 32-col mobile budget
# ("┌ fail · <rid>" is the longest header shape; the rc never fits and
# stays in the title), so the pid must stay <= 7 digits - $$ does
# (pid_max on these boxes is 4194304, 6-7 digits live). A hypothetical
# 8-digit pid loses the rid head to the header clip (tail kept). The
# 3-group numeric shape is preserved: the ticket validators in
# pi-bg-tail/-kill match ^[0-9]{8}-[0-9]{6}-[0-9]+$.
run_id="${PI_BG_RUN_ID:-$(date -u +%Y%m%d-%H%M%S)-$$}"
export PI_SESSION_ID="pi-${USER:-$(id -un)}-${profile}-${run_id}"

# --- per-run artifact dir: default ~/.pi-bg-art (persistent — /tmp on the
#     hydrogen box is a 32G tmpfs that a reboot wipes; 2026-09-13: a wiped
#     /tmp lost every out.md and the watchdog re-flagged finished tickets as
#     DEAD). PI_BG_TMPDIR is honored by pi-bg-tail, pi-bg-kill, pi-bg-watchdog
#     and the bridge /jobs history — keep all per-run files in the same place
#     so every tool finds them. ---
BG_TMP="${PI_BG_TMPDIR:-${HOME}/.pi-bg-art}"
mkdir -p "$BG_TMP" 2>/dev/null

# issue #56 belt: ticket id line BEFORE the slow `git worktree add` /
# cgroup escape, so the launcher's `head -1 log` returns immediately and a
# dead ticket leaves an identifiable first log line (pre-fix: >60s silence
# on big repos, and a TERM'd startup printed nothing). Printed once: the
# snapshot re-exec (PI_BG_SNAP) skips it.
if [ -z "${PI_BG_SNAP:-}" ]; then echo "[pi-bg] ticket $run_id profile=$profile"; fi

# --- deploy-swap guard (2026-09-15, ticket 20260915-011025-3740387) -----
# bash keeps reading this script from DISK for the whole run. A jarate
# deploy (git pull in the checkout that ~/scripts/pi-bg symlinks into)
# swaps dispatch/pi-bg while a long wrapper is parked in `wait` (a 15-min
# review): the resumed read lands on a stale offset in the NEW content
# and dies mid-run (bash syntax error, exit 2) - the review was complete
# (report + PASS on disk) but the wrapper never posted its callback and
# the watchdog re-flagged the ticket DEAD. Each run now execs a per-run
# COPY of the startup script: git pull REPLACES the checkout path (new
# inode) and editors/biome write IN PLACE (same inode) - a hard link only
# survives the former (1769153 died to my own in-place edits), a copy
# survives both. Basename stays "pi-bg" so the concurrency cap still
# counts us; the snapshot is cleaned in the exit trap. Fails open
# (continue on $0) when the copy cannot be made.
SNAP_DIR="${SNAP_DIR:-}"
if [ -z "${PI_BG_SNAP:-}" ] && [ "${PI_BG_NOSNAP:-0}" != "1" ]; then
  _snapdir="$BG_TMP/snap-$run_id"
  if mkdir -p "$_snapdir" 2>/dev/null && \
     cp -f "$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")" "$_snapdir/pi-bg" 2>/dev/null && \
     chmod 755 "$_snapdir/pi-bg" 2>/dev/null; then
    SNAP_DIR="$_snapdir"
    PI_BG_SNAP=1 PI_BG_RUN_ID="$run_id" JB_ROOT_SNAPPED="$JB_ROOT" SNAP_DIR="$_snapdir" exec bash "$_snapdir/pi-bg" "${PI_BG_ORIG_ARGS[@]+"${PI_BG_ORIG_ARGS[@]}"}"
  fi
  rm -rf "$_snapdir" 2>/dev/null || true
fi
# Snapshot process path (the original process exec'd away above): until the
# full bg_on_exit trap registers below, a minimal trap keeps the per-run
# snapshot from leaking on early exits (provider check, worktree fail).
# bg_on_exit replaces this on registration and cleans the same dir.
if [ -n "${SNAP_DIR:-}" ]; then
  trap 'rm -rf "${SNAP_DIR}" 2>/dev/null' EXIT
fi

wt_path=""
wt_branch=""
wt_repo=""
if [ "$wt_mode" -eq 1 ]; then
  ref="${wt_ref:-HEAD}"
  top="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "pi-bg: --worktree needs a git repo (cwd=$(pwd) is not one)" >&2; exit 3; }
  id="$run_id"
  wt_path="${PI_BG_WT_DIR:-${HOME}/.pi-bg-wt}/$(basename "$(git rev-parse --show-toplevel)")/$id"
  wt_branch="pi-bg/$id"
  wt_repo="$(basename "$top")"
  if ! git worktree add -b "$wt_branch" "$wt_path" "$ref" >/dev/null 2>&1; then
    echo "pi-bg: worktree add failed (ref=$ref path=$wt_path)" >&2; exit 3; fi
  echo "[pi-bg] worktree: $wt_path (branch $wt_branch, from $ref) - kept after run"
fi

# task = last positional arg (early: the exit trap needs it)
task="${@: -1}"
out=""; rc=1; purl=""; ourl=""

# --- cgroup escape (automatic, persistent): move THIS process (and all
#     children, incl. pi and the later webhook post) out of pi.service's
#     cgroup so an orchestrator restart can't kill an in-flight run.
#     systemd kills a unit's whole cgroup subtree on stop; a sibling cgroup
#     under the user slice survives. Fallback: run in place if cgroup v2
#     delegation is unavailable (mkdir/proc write fails).
#     PI_BG_CG_ROOT overrides the cgroup base (test hook; pi-bg-kill honors
#     the same var). ---
CG_PARENT="${PI_BG_CG_ROOT:-/sys/fs/cgroup/user.slice/user-$(id -u).slice/user@$(id -u).service}"
ESCAPE_CG="$CG_PARENT/pi-bg/${run_id}"
ESCAPE_ACTIVE=0
if mkdir -p "$ESCAPE_CG" 2>/dev/null && echo $$ > "$ESCAPE_CG/cgroup.procs" 2>/dev/null; then
  ESCAPE_ACTIVE=1
  echo "[pi-bg] cgroup escape active: $ESCAPE_CG"
else
  rmdir "$ESCAPE_CG" 2>/dev/null
  echo "[pi-bg] cgroup escape unavailable, running in caller cgroup"
fi

webhook="${PI_DISPATCH_WEBHOOK:-}"
if [ -z "$webhook" ] && [ -f "${HOME}/.config/pi-dispatch/webhook" ]; then
  webhook="$(head -1 "${HOME}/.config/pi-dispatch/webhook")"
fi

# --- no-webhook warning + run record (issue #30): a missing webhook must
#     not be a silent no-op — the callback is the ONLY wake mechanism. ---
if [ -n "$webhook" ]; then
  delivery="webhook"
else
  delivery="none"
  echo "[pi-bg] no webhook at ${HOME}/.config/pi-dispatch/webhook (and PI_DISPATCH_WEBHOOK unset) - no completion callback; poll with pi-wait" >&2
fi
rec_dir="${PI_DISPATCH_RECORD_DIR:-${HOME}/.pi-dispatch/runs}"
mkdir -p "$rec_dir" 2>/dev/null
PI_BG_REC_RUN="$run_id" PI_BG_REC_PROFILE="$profile" PI_BG_REC_PROJECT="$pj_tag" \
PI_BG_REC_CWD="$(pwd)" \
PI_BG_REC_DELIVERY="$delivery" python3 - "$rec_dir/pi-bg-${run_id}.json" <<'PY' 2>/dev/null || true
import datetime, json, os, sys
rec = {
    "run": os.environ["PI_BG_REC_RUN"],
    "profile": os.environ["PI_BG_REC_PROFILE"],
    "project": os.environ["PI_BG_REC_PROJECT"] or None,
    "cwd": os.environ["PI_BG_REC_CWD"],
    "started": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "delivery": os.environ["PI_BG_REC_DELIVERY"],
    "state": "running",
}
with open(sys.argv[1], "w") as fh:
    json.dump(rec, fh, indent=2)
PY

# --- profile doctor (issue #29): the role home must hold provider creds.
#     A fresh machine has none; pi then replies empty and the empty-completion
#     retry loop below misfiles a credential-shaped failure. Seed a missing
#     profile from the main agent + the repo template, then fail loud. ---
profile_seeded() {
  local dir="$1" f
  for f in "$dir/auth.json" "$dir/models.json"; do
    [ -s "$f" ] || continue
    python3 - "$f" <<'PY' >/dev/null 2>&1 && return 0
import json, sys
d = json.load(open(sys.argv[1]))
sys.exit(0 if isinstance(d, (dict, list)) and len(d) else 1)
PY
  done
  return 1
}

# true when the file is missing, or parses as an empty object/list.
# A present-but-EMPTY file ({}, which is 2 bytes so [ -s ] passes) is
# still seedable: a profile with BOTH auth.json={} and models.json={}
# must not block seeding from the main agent's valid creds.
empty_json() {
  local f="$1"
  [ -e "$f" ] || return 0
  python3 - "$f" <<'PY' >/dev/null 2>&1
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(1)  # unparseable = treat as user's content, do not clobber
sys.exit(0 if isinstance(d, (dict, list)) and not d else 1)
PY
}

if ! profile_seeded "$PI_CODING_AGENT_DIR"; then
  main_agent="${HOME}/.pi/agent"
  mkdir -p "$PI_CODING_AGENT_DIR" 2>/dev/null
  for f in auth.json models.json; do
    if [ -s "$main_agent/$f" ] && empty_json "$PI_CODING_AGENT_DIR/$f"; then
      cp -L "$main_agent/$f" "$PI_CODING_AGENT_DIR/$f" 2>/dev/null || true
    fi
  done
  if [ ! -e "$PI_CODING_AGENT_DIR/settings.json" ] && [ -n "$JB_ROOT" ] && [ -f "$JB_ROOT/dispatch/profiles/${profile}.json" ]; then
    python3 - "$PI_CODING_AGENT_DIR/settings.json" \
      "$JB_ROOT/dispatch/profiles/${profile}.json" "$main_agent/settings.json" <<'PY' 2>/dev/null || true
import json, sys
out, tpl, main = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    cfg = json.load(open(tpl))
    if not isinstance(cfg, dict): cfg = {}
except Exception:
    cfg = {}
try:
    m = json.load(open(main))
    for k in ("defaultProvider", "defaultModel"):
        v = m.get(k)
        if isinstance(v, str) and v:
            cfg[k] = v
except Exception:
    pass
with open(out, "w") as fh:
    json.dump(cfg, fh, indent=2)
PY
  fi
fi
if ! profile_seeded "$PI_CODING_AGENT_DIR"; then
  {
    echo "pi-bg: profile '$profile' has no provider at $PI_CODING_AGENT_DIR (auth.json/models.json missing or empty)"
    echo "pi-bg: fix: seed credentials, e.g."
    echo "  cp -L ${HOME}/.pi/agent/auth.json ${HOME}/.pi/agent/models.json $PI_CODING_AGENT_DIR/"
    echo "  (or run the main agent once to log in), then re-dispatch."
    if [ -n "$JB_ROOT" ] && [ -f "$JB_ROOT/dispatch/profiles/${profile}.json" ]; then
      echo "pi-bg: settings template: $JB_ROOT/dispatch/profiles/${profile}.json"
    fi
  } >&2
  exit 4
fi

# --- LLM HTTP idle timeout (RCA #57 fix 1): under shared vLLM queue load
# the model stream can go byte-quiet for 10+ min; pi's default 300s HTTP
# idle watchdog then kills the run (exit 1, no output = "silent death").
# Ensure the profile runs with 900s. Add-key only: an operator-set value
# (or an unparseable file) is never overwritten.
PI_BG_IDLE_MS="${PI_BG_IDLE_MS:-900000}" python3 - "$PI_CODING_AGENT_DIR/settings.json" <<'PY' 2>/dev/null || true
import json, os, sys
p = sys.argv[1]
try:
    cfg = json.load(open(p))
except Exception:
    sys.exit(0)
if isinstance(cfg, dict) and "httpIdleTimeoutMs" not in cfg:
    cfg["httpIdleTimeoutMs"] = int(os.environ.get("PI_BG_IDLE_MS", "900000"))
    with open(p, "w") as fh:
        json.dump(cfg, fh, indent=2)
        fh.write("\n")
PY

# --- secret censor for callback text (jarate/bin/jarate-censor, bun) ---
# The callback body (task + worker output) is Discord egress from a process
# outside the bridge, so it routes through the same censor + registry.
# Missing tool / bun absent / any error = pass through (never break the wake).
bg_censor() {
  local c
  if [ -n "$1" ] && [ -f "$JB_ROOT/bin/jarate-censor" ] && command -v bun >/dev/null 2>&1; then
    c="$(printf '%s' "$1" | bun "$JB_ROOT/bin/jarate-censor" 2>/dev/null)" && { printf '%s' "$c"; return; }
  fi
  printf '%s' "$1"
}

# --- callback helpers (issue #14): the webhook post is the only wake
#     mechanism, so never let it fail silently. ---
BG_CB_DONE=0
BG_DEAD="$BG_TMP/pi-bg-${run_id}-webhook-failed"
BG_WB_RESP="$BG_TMP/pi-bg-${run_id}-wb-resp.txt"
BG_WB_STATUS="$BG_TMP/pi-bg-${run_id}-wb-status"
# started marker: exists while the ticket is alive/unfinalized; the watchdog
# uses it to say "started, callback lost" instead of "no callback on record".
# Removed in bg_on_exit. A ticket that SIGKILLs keeps it (that is the point).
touch "$BG_TMP/pi-bg-${run_id}-started" 2>/dev/null || true
# run start epoch: bounds the silent-death session mtime scan (issue #57)
run_start_epoch=$(date +%s)

# bg_post <body-file>: 3 attempts, backoff, --max-time; 2xx = success.
# success: HTTP code + time recorded in $BG_WB_STATUS (webhook-delivery audit,
#   issue #14) and $BG_WB_RESP kept as the last response body.
# final failure: dead-letter file + stderr note, return 1.
bg_post() {
  local body="$1" code i
  [ -n "$webhook" ] || return 1
  for i in 1 2 3; do
    code="$(curl -s -o "$BG_WB_RESP" -w '%{http_code}' -X POST "$webhook" \
      -H 'Content-Type: application/json' --max-time 15 --data @"$body" 2>/dev/null)" || code="000"
    case "$code" in
      2*) BG_CB_DONE=1; rm -f "$BG_DEAD"
          printf '%s %s\n' "$code" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$BG_WB_STATUS"
          return 0 ;;
    esac
    [ "$i" -lt 3 ] && sleep $(( i * 3 * ${PI_BG_WB_BACKOFF:-1} ))
  done
  { printf 'ticket   : %s\n' "$run_id"
    printf 'http     : %s (3 attempts)\n' "$code"
    printf 'when     : %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'response : %s\n' "$(head -c 300 "$BG_WB_RESP" 2>/dev/null)"
    printf 'body     : %s\n' "$body"; } > "$BG_DEAD"
  echo "[pi-bg] webhook FAILED (http=$code) - dead letter: $BG_DEAD" >&2
  return 1
}

# bg_build <body-file> <status> <brief> <rc> <verdict>: existing embed format
bg_build() {
  local bodyfile="$1" status="$2" brief="$3" brc="$4" verdict="$5"
  BG_WEBHOOK="$webhook" BG_PROFILE="$profile" BG_STATUS="$status" BG_RC="$brc" \
  BG_VERDICT="$verdict" BG_DUR="${SECONDS}" BG_TASK="$(bg_censor "${task:0:200}")" \
  BG_BRIEF="$(bg_censor "$brief")" \
  BG_WT="$wt_path" BG_BRANCH="$wt_branch" BG_CWD="$(pwd)" BG_RUN="$run_id" \
  BG_WORKTREE="$wt_mode" BG_REPO="$wt_repo" \
  BG_PURL="$purl" BG_OURL="$ourl" \
  BG_PJ_TAG="$pj_tag" BG_PJ_COST="${BG_PJ_COST:-}" \
  python3 - > "$bodyfile" 2>/dev/null <<'PY'
import json, os, sys, datetime
E = lambda k: os.environ.get("BG_" + k, "")
def clip_end(s, max):
    s = str(s)
    return s if len(s) <= max else (s[:max - 1] + "\u2026" if max > 1 else "\u2026")
def clip_start(s, max):
    s = str(s)
    return s if len(s) <= max else ("\u2026" + s[len(s) - (max - 1):] if max > 1 else "\u2026")
def kv(key, val, width=6, vbudget=29, head=False):
    cut = clip_start if head else clip_end
    return "\u251c " + key.ljust(width) + " : " + cut(val, vbudget)
FRAME_W = 40  # mobile budget (docs/STYLE.md 2.3, measured 2026-09-15): every frame line <= 40
def hdr(word, rid, rc=None):
    h = f"\u250c {word} \u00b7 {rid}"
    if rc is not None:
        h += f" (rc={rc})"
    if len(h) > FRAME_W:
        h = f"\u250c {word} \u00b7 {rid}"  # only very large rc (5+ digits) exceeds 40; it stays in the title
    if len(h) > FRAME_W:
        # 8-digit pid: clip the rid head, keep the tail (the pid end is
        # the discriminator)
        keep = FRAME_W - len(f"\u250c {word} \u00b7 ")
        h = f"\u250c {word} \u00b7 {clip_start(rid, keep)}"
    return h
prof, status, rc, verdict = E("PROFILE"), E("STATUS"), E("RC"), E("VERDICT")
dur = int(E("DUR") or 0)
dstr = f"{dur//60}m{dur%60:02d}s"
rid = E("RUN")
GREEN, RED, ORANGE = 3066993, 15158332, 15105570
# v3 style (mockup3, 2026-09-13): no glyphs in titles; the description is a
# framed block (box-drawing + ASCII + middle dot), every line <= FRAME_W.
if prof == "reviewer" and verdict:
    ok = verdict == "PASS"
    title = f"reviewer \u00b7 {'PASS' if ok else 'FAIL'} \u00b7 {dstr}"
    header = hdr("pass" if ok else "fail", rid)
    color = GREEN if ok else RED
elif status == "OK":
    title = f"{prof} \u00b7 OK \u00b7 {dstr}"; header = hdr("ok", rid); color = GREEN
elif status == "FAIL":
    title = f"{prof} \u00b7 FAIL (rc={rc}) \u00b7 {dstr}"
    header = hdr("fail", rid, rc)
    color = RED
elif status == "DIED":
    title = f"{prof} \u00b7 DIED (no report) \u00b7 {dstr}"; header = hdr("died", rid); color = ORANGE
else:
    title = f"{prof} \u00b7 EMPTY \u00b7 {dstr}"; header = hdr("empty", rid); color = RED
desc_lines = [header, f"\u251c $ pi-bg {prof}{ ' --worktree' if E('WORKTREE') == '1' else ''}"]
if E("WORKTREE") == "1":
    desc_lines.append(kv("repo", E("REPO")))
    desc_lines.append(kv("wt", E("WT"), head=True))
    desc_lines.append(kv("branch", E("BRANCH")))
else:
    desc_lines.append(kv("cwd", E("CWD"), head=True))
if E("PJ_TAG"):
    # project line (2026-09-18): LAST in the frame on purpose - the 1.8k
    # callback truncation eats the tail (fields), never the identity
    # header. cost null -> "$-".
    pj = E("PJ_TAG") + " \u00b7 $" + (E("PJ_COST") or "-")
    line = "\u2502 pj " + pj
    if len(line) > FRAME_W:
        line = "\u2502 pj " + clip_end(pj, FRAME_W - 5)
    desc_lines.append(line)
desc_lines.append("\u2514")
desc = "```bash\n" + "\n".join(desc_lines) + "\n```"

embed = {
    "author": {"name": f"pi-bg ticket \u00b7 {rid}"},
    "title": title,
    "description": desc,
    "color": color,
    "footer": {"text": "pi-bg"},
    "timestamp": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
}
fields = []
if E("TASK"):
    fields.append({"name": "task", "value": E("TASK"), "inline": False})
if E("BRIEF"):
    fields.append({"name": "result", "value": E("BRIEF"), "inline": False})
if E("PURL"):
    fields.append({"name": "prompt", "value": "[view](" + E("PURL") + ")", "inline": True})
if E("OURL"):
    fields.append({"name": "full output", "value": "[view](" + E("OURL") + ")", "inline": True})
if fields:
    embed["fields"] = fields
json.dump({"embeds": [embed]}, sys.stdout)
PY
}

# bg_mark_record <state>: terminal state for the run record (issue #51):
# one-shot runs (task/cron/sleep wakes) must not accumulate "running"
# records. Audit-only: a missing/corrupt record is skipped silently (the
# watchdog's age-based prune is the backstop).
bg_mark_record() {
  local f="$rec_dir/pi-bg-${run_id}.json"
  [ -f "$f" ] || return 0
  PI_BG_REC_STATE="$1" python3 - "$f" <<'PY' 2>/dev/null || true
import datetime, json, os, sys
p = sys.argv[1]
try:
    rec = json.load(open(p))
except Exception:
    sys.exit(0)
rec["state"] = os.environ.get("PI_BG_REC_STATE", "done")
rec["finished"] = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
json.dump(rec, open(p, "w"), indent=2)
PY
  # cost capture (2026-09-18, --project): attribute this run's session
  # tokens + cost on EVERY terminal path (done/failed/DIED/killed). The
  # main flow already captured before its callback so the embed line
  # carries the real number; this second call is a cache-hit re-read
  # (idempotent) that covers the paths it did not. Bounded + failure-
  # tolerant; the echo feeds BG_PJ_COST for the DIED embed line.
  if [ -n "$pj_tag" ]; then
    BG_PJ_COST="$(bg_capture_cost)" || BG_PJ_COST=""
  fi
}

# bg_on_exit: cgroup cleanup + the 'died without report' fallback + per-run
# temp-file cleanup. If we exit with no out.md and no posted callback, post
# DIED so the orchestrator wakes. (covers TERM/INT/normal-exit paths; SIGKILL
# cannot be trapped)
# cgroup drain: by the time this trap runs, every child is gone — the pi loop
# uses wait, webdrop/webhook post are synchronous — so the ONLY member left
# is this shell. Move it back into the parent cgroup (it exits right after),
# then rmdir: cgroup v2 auto-removes the cgroup files once the last member
# leaves, so the dir is empty and rmdir succeeds. Without the self-move-out
# the rmdir always fails (348 leaked empty dirs, 2026-09-11). Guarded: a
# missing/non-empty dir must never break the exit path. SIGKILLed wrappers
# can't run this at all — pi-bg-kill reaps the drained cgroup dir itself.
bg_on_exit() {
  local ec=$?
  # heartbeat child (issue #52): stop it FIRST so its in-flight sleep can't
  # hold a member in the ticket cgroup during the drain/rmdir below
  if [ -n "${hb_pid:-}" ]; then
    kill "$hb_pid" 2>/dev/null
    wait "$hb_pid" 2>/dev/null
    hb_pid=""
  fi
  # run record: terminal state (issue #51). Written BEFORE the cgroup drain
  # on purpose: pi-bg-kill only finalizes "killed" after the drain confirms
  # empty, so "done" is guaranteed first and an operator kill ends up
  # "killed". (SIGKILL skips this whole trap; the watchdog prunes by age.)
  bg_mark_record "done"
  # exit-code artifact for the watchdog's SILENT classification (issue
  # #57): the trap runs on every trapped exit (normal/INT/TERM/error);
  # a SIGKILLed wrapper leaves no rc file (watchdog then says DEAD).
  printf '%s\n' "$ec" > "$BG_TMP/pi-bg-${run_id}-rc" 2>/dev/null || true
  if [ "$BG_CB_DONE" -eq 0 ] && [ -n "$webhook" ] && \
     [ ! -s "$BG_TMP/pi-bg-${run_id}-out.md" ]; then
    [ -n "${pi_pid:-}" ] && kill "$pi_pid" 2>/dev/null
    bg_build "$BG_TMP/pi-bg-${run_id}-body.json" "DIED" \
      "no output captured - pi-bg exited before completion (exit=$ec)" "$ec" ""
    bg_post "$BG_TMP/pi-bg-${run_id}-body.json" || true
  fi
  if [ "$ESCAPE_ACTIVE" -eq 1 ]; then
    # Drain target is the pi-bg level, NOT $CG_PARENT: the slice root is a
    # cgroup v2 domain (subtree_control populated) and the no-internal-
    # process rule makes the write back into it fail EBUSY while ANY
    # descendant holds a process - which is this shell, until the write
    # succeeds. So the old write to $CG_PARENT/cgroup.procs always failed
    # on real cgroupfs, the shell stayed in the ticket cgroup, and the
    # rmdir below always failed (every run leaked its dir, 2026-09-14).
    # $CG_PARENT/pi-bg has no controllers enabled, so the write there
    # always works; the wrapper exits right after, so nothing lingers.
    echo $$ > "$CG_PARENT/pi-bg/cgroup.procs" 2>/dev/null || true
    # real cgroup v2 auto-removes its files when the last member leaves;
    # on a plain test root the fake file must be removed for rmdir to work
    rm -f "$ESCAPE_CG/cgroup.procs" 2>/dev/null || true
    rmdir "$ESCAPE_CG" 2>/dev/null || true
  fi
  # temp-file cleanup (issue: /tmp inode exhaustion, 2026-09-14): the run's
  # scratch files are unlinked on every trapped exit path (normal, error,
  # INT, TERM - the INT/TERM traps funnel into this EXIT trap). Kept:
  # out.md (completion marker: watchdog + /jobs), raw.out (pi-bg-tail spool
  # + /jobs "run started"), wb-status (webhook audit: /jobs),
  # webhook-failed (dead letter: watchdog + /jobs). A SIGKILLed wrapper
  # cannot run this trap - its files stay for forensics (the watchdog flags
  # the ticket DEAD instead).
  rm -f "$BG_TMP/pi-bg-${run_id}-body.json" \
        "$BG_TMP/pi-bg-${run_id}-body-plain.json" \
        "$BG_TMP/pi-bg-${run_id}-err.log" \
        "$BG_TMP/pi-bg-${run_id}-prompt.md" \
        "$BG_TMP/pi-bg-${run_id}-wb-resp.txt" 2>/dev/null || true
  rm -f "$BG_TMP/pi-bg-${run_id}-started" 2>/dev/null || true
  rm -f "$hb_f" 2>/dev/null || true
  # deploy-swap guard: drop the per-run script snapshot (a hard link to the
  # startup inode; git already replaced the checkout path)
  [ -n "${SNAP_DIR:-}" ] && rm -rf "$SNAP_DIR" 2>/dev/null || true
}

# --- heartbeat (issue #52): long workers emit no signal between dispatch
#     and completion; the watchdog tells dead-from-alive only by process
#     existence, so a stalled-but-alive run (hung tool, wedged model call)
#     looks healthy until it dies. A background child touches <id>-hb
#     every ${HB_INTERVAL}s; bg_on_exit kills it (and its in-flight sleep)
#     so it never outlives the run. The child also self-terminates when the
#     wrapper dies untrappably (SIGKILL): the loop checks the wrapper's pid
#     ($$ inside a subshell is the parent's) each tick. Forked AFTER the
#     cgroup escape so it lands in the ticket cgroup (pi-bg-kill signals it
#     with the rest of the tree). Started right before the EXIT trap is
#     registered below, so every exit from this point on is trapped;
#     hb_pid="" guards bg_on_exit either way.
HB_INTERVAL="${PI_BG_HB_INTERVAL:-30}"
hb_f="$BG_TMP/pi-bg-${run_id}-hb"
touch "$hb_f" 2>/dev/null || true
hb_pid=""
(
  trap '[ -n "$s" ] && kill "$s" 2>/dev/null; exit 143' TERM INT
  s=""
  while kill -0 "$$" 2>/dev/null; do
    touch "$hb_f" 2>/dev/null
    sleep "$HB_INTERVAL" &
    s=$!
    wait "$s" 2>/dev/null
  done
) &
hb_pid=$!

trap bg_on_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# retry on empty completion (local model quirk: some phrasings return nothing)
# pi runs in background + wait so a trapped TERM/INT fires immediately
# (a trapped signal during a foreground command is deferred until it returns)
pi_pid=""
rawf="$BG_TMP/pi-bg-${run_id}-raw.out"
errf="$BG_TMP/pi-bg-${run_id}-err.log"
retry1f="$BG_TMP/pi-bg-${run_id}-retry1"
# SILENT tail bound (issue #57): a silent death (exit 1, no output) counts
# as the #57 idle-timeout signature only if it came within 15 min of the
# last activity (raw.out mtime / this run's session file mtime / attempt
# start). A long-quiet run that dies with no output stays a generic DIED.
SILENT_TAIL_MAX="${PI_BG_SILENT_TAIL_MAX:-900}"
att_start=0
silent_retried=0

# bg_session_file: the profile session jsonl written for this run after run
# start (shared by bg_silent_tail and bg_capture_cost so both consumers stay
# identical): slug from wt_path (worktree runs) else $PWD, dir
# $PI_CODING_AGENT_DIR/sessions/<slug>, newest *.jsonl newermt the run start
# epoch. Echoes the path; echoes nothing when there is no match (test stubs,
# --no-session).
bg_session_file() {
  local slug sd sf
  if [ "$wt_mode" -eq 1 ]; then slug="$wt_path"; else slug="$PWD"; fi
  slug="--${slug#/}"; slug="${slug//\//-}--"
  sd="$PI_CODING_AGENT_DIR/sessions/$slug"
  sf="$(find "$sd" -maxdepth 1 -name '*.jsonl' -newermt "@$run_start_epoch" -printf '%T@ %p\n' 2>/dev/null | sort -nr | head -1 | cut -d' ' -f2-)"
  [ -n "$sf" ] && printf '%s' "$sf"
}

# bg_capture_cost: attribute THIS run's session tokens + OpenRouter-list cost
# to the run record (2026-09-18, --project, invoice itemisation). Echoes the
# cost (2dp) for the callback project line; empty echo = cost unknown.
#   - only runs when --project was set (pj_tag); never fails the run
#   - no session file / no assistant usage -> tokens+cost+model+price_ts null
#   - JARATE_TOKEN_COST_PRICING_OFFLINE set -> tokens only, cost null
#   - price: qwen/qwen3.8-27b OpenRouter LIST rate (same convention as
#     ~/scripts/pi-token-cost.py + NF invoices), cached 24h in
#     $PI_BG_TMPDIR/pi-bg-price-cache.json; one bounded curl on cache miss;
#     ANY fetch/parse failure -> cost null + price_error (tokens still kept)
bg_capture_cost() {
  [ -n "$pj_tag" ] || return 0
  [ -f "$rec_dir/pi-bg-${run_id}.json" ] || return 0
  PI_BG_PJ_FILE="$rec_dir/pi-bg-${run_id}.json" \
  PI_BG_PJ_CACHE="${PI_BG_TMPDIR:-${HOME}/.pi-bg-art}/pi-bg-price-cache.json" \
  PI_BG_PJ_SESSION="$(bg_session_file)" \
  python3 - <<'PY' 2>/dev/null
import datetime, json, os, subprocess

MODEL = "qwen/qwen3.8-27b"
rec_f = os.environ["PI_BG_PJ_FILE"]
cache_f = os.environ.get("PI_BG_PJ_CACHE", "")
sess_f = os.environ.get("PI_BG_PJ_SESSION", "")
url = os.environ.get("PI_BG_PRICING_URL", "https://openrouter.ai/api/v1/models")
try:
    tmo = int(os.environ.get("PI_BG_PRICING_TIMEOUT", "10"))
except ValueError:
    tmo = 10

def load():
    # None = corrupt or not an object (decode failure, or valid JSON that
    # is a list/str/num). The caller must SKIP: never rewrite such a
    # record with a cost-only dict (same discipline as bg_mark_record /
    # bg_log_retry, which treat a corrupt record as skip).
    try:
        with open(rec_f) as fh:
            d = json.load(fh)
        return d if isinstance(d, dict) else None
    except Exception:
        return None

def save(rec):
    try:
        with open(rec_f, "w") as fh:
            json.dump(rec, fh, indent=2)
    except Exception:
        pass

def tokens_sum():
    # sum message.role=="assistant" usage across the file; malformed lines
    # are skipped. Same accounting as pi-token-cost.py: total excludes
    # cacheWrite.
    tot = {"input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0}
    found = False
    try:
        fh = open(sess_f)
    except Exception:
        return None
    for line in fh:
        if '"type":"message"' not in line:
            continue
        try:
            o = json.loads(line)
        except Exception:
            continue
        m = o.get("message") or {}
        if m.get("role") != "assistant":
            continue
        u = m.get("usage")
        if not isinstance(u, dict):
            continue
        found = True
        for k in tot:
            v = u.get(k)
            if isinstance(v, (int, float)) and not isinstance(v, bool):
                tot[k] += v
    fh.close()
    if not found:
        return None
    tot["total"] = tot["input"] + tot["output"] + tot["cacheRead"]
    return tot

def finish(cost, model, price_ts, price_error=None):
    rec["cost_usd"] = cost
    rec["model"] = model
    rec["price_ts"] = price_ts
    # unconditional: a capture that prices the run must clear a stale
    # price_error left by an earlier (transiently failed) capture of the
    # same run, and a failed capture records why
    rec["price_error"] = price_error
    save(rec)
    if isinstance(cost, (int, float)):
        print("%.2f" % cost)

rec = load()
if rec is None:
    # corrupt record: skip the whole capture, never clobber it with a
    # cost-only dict (the run's identity + project tag would be lost)
    raise SystemExit(0)
tok = tokens_sum() if sess_f else None
if tok is None:
    # no session file (test stubs, --no-session) or no assistant usage:
    # null fields, move on
    rec["tokens"] = None
    rec["cost_usd"] = None
    rec["model"] = None
    rec["price_ts"] = None
    save(rec)
    raise SystemExit(0)
rec["tokens"] = tok

if os.environ.get("JARATE_TOKEN_COST_PRICING_OFFLINE"):
    finish(None, None, None, "offline")
    raise SystemExit(0)

price, pts = None, None
try:  # 24h price cache: the exit path must not add minutes to shutdown
    with open(cache_f) as fh:
        c = json.load(fh)
    if isinstance(c, dict) and c.get("model") == MODEL and isinstance(c.get("ts"), str):
        age = (datetime.datetime.now(datetime.timezone.utc)
               - datetime.datetime.fromisoformat(c["ts"]))
        if age.total_seconds() < 86400 and isinstance(c.get("price"), dict):
            price, pts = c["price"], c["ts"]
except Exception:
    pass
if price is None:
    err = "fetch failed"
    try:
        p = subprocess.run(["curl", "-s", "--max-time", str(tmo), url],
                           capture_output=True, text=True, timeout=tmo + 5)
        if p.returncode == 0:
            try:
                data = json.loads(p.stdout)
            except ValueError:
                data = None
                err = "parse failed"
            if isinstance(data, dict) and isinstance(data.get("data"), list):
                entries = data["data"]

                def mid(m):
                    # non-dict/None list entries must not raise: a
                    # malformed entry degrades to an id miss, not a
                    # masked "fetch/parse failed" (the fetch + parse
                    # both succeeded)
                    return str(m.get("id") or "") if isinstance(m, dict) else ""

                entry = next((m for m in entries if mid(m) == MODEL), None)
                if entry is None:  # fuzzy, same convention as pi-token-cost.py
                    cands = [m for m in entries
                             if "qwen" in mid(m).lower()
                             and "27b" in mid(m).lower()]
                    plain = [m for m in cands
                             if "-vl" not in mid(m)
                             and "reasoning" not in mid(m).lower()]
                    entry = (plain or cands or [None])[0]
                if entry is None:
                    err = "model not found"
                else:
                    pr = (entry or {}).get("pricing") or {}
                    rates = {}
                    for k in ("prompt", "completion", "input_cache_read", "input_cache_write"):
                        v = pr.get(k)
                        try:
                            rates[k] = float(v) if v is not None else None
                        except (TypeError, ValueError):
                            rates[k] = None
                    if rates["prompt"] is None or rates["completion"] is None:
                        err = "parse failed"
                    else:
                        price, pts = rates, datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
                        try:  # cache write is best-effort (a failed cache never fails the run)
                            tmp = cache_f + ".tmp"
                            with open(tmp, "w") as fh:
                                json.dump({"model": MODEL, "price": rates, "ts": pts}, fh)
                            os.replace(tmp, cache_f)
                        except Exception:
                            pass
    except Exception:
        pass
    if price is None:
        finish(None, None, None, err)
        raise SystemExit(0)

prompt = price["prompt"]
completion = price["completion"]
cache_read = price.get("input_cache_read")
if cache_read is None:
    cache_read = prompt  # no cache price -> bill at prompt rate
if price.get("input_cache_write") is None:
    cache_write = prompt  # assumption, noted in pi-token-cost.py
else:
    cache_write = price["input_cache_write"]
cost = (tok["input"] * prompt + tok["output"] * completion
        + tok["cacheRead"] * cache_read + tok["cacheWrite"] * cache_write)
finish(round(cost, 5), MODEL, pts)
PY
}

# bg_silent_tail: seconds since the newest activity of this run (raw.out
# mtime, the profile session file for this run's cwd written after run
# start, or the attempt start). No session file (test stubs, --no-session)
# -> the attempt start bounds the tail.
bg_silent_tail() {
  local now last sm sf
  now="$(date +%s)"
  last="$att_start"
  sm="$(stat -c %Y "$rawf" 2>/dev/null)" && [ -n "$sm" ] && [ "$sm" -gt "$last" ] && last="$sm"
  sf="$(bg_session_file)"
  if [ -n "$sf" ]; then
    sm="$(stat -c %Y "$sf" 2>/dev/null)" && [ -n "$sm" ] && [ "$sm" -gt "$last" ] && last="$sm"
  fi
  echo $(( now - last ))
}

# bg_log_retry: append a retry entry to this run's record (issue #57): the
# durable "why did this ticket relaunch" trail. Never fails the run.
bg_log_retry() {
  [ -f "$rec_dir/pi-bg-${run_id}.json" ] || return 0
  PI_BG_REC_FILE="$rec_dir/pi-bg-${run_id}.json" \
  PI_BG_REC_AT="$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
  PI_BG_REC_REASON="$1" python3 - <<'PY' 2>/dev/null || true
import json, os
f = os.environ["PI_BG_REC_FILE"]
try:
    rec = json.load(open(f))
except Exception:
    rec = {}
if not isinstance(rec, dict):
    rec = {}
rec.setdefault("retries", []).append(
    {"at": os.environ["PI_BG_REC_AT"], "reason": os.environ["PI_BG_REC_REASON"]})
with open(f, "w") as fh:
    json.dump(rec, fh, indent=2)
PY
}

# standard constraints: append to the final (task) argument of every run
pi_args=( "$@" )
pi_args[-1]+=$'\n\nSTANDARD CONSTRAINTS (all tasks):\n- Never run commands that need a TTY interactively: use plain `podman exec` / `docker exec` (no -it), redirect output. An interactive child hung a 9h dispatch on 2026-09-10.\n- Bound long commands with `timeout` (default 600s) unless the task says otherwise.'
for attempt in 1 2 3; do
  att_start="$(date +%s)"
  if [ "$wt_mode" -eq 1 ]; then
    ( cd "$wt_path" && exec pi -p --no-extensions "${pi_args[@]}" ) > "$rawf" 2> "$errf" &
  else
    pi -p --no-extensions "${pi_args[@]}" > "$rawf" 2> "$errf" &
  fi
  pi_pid=$!
  wait "$pi_pid"; rc=$?; pi_pid=""
  out="$(cat "$rawf")"
  # Check if output is non-empty (after stripping whitespace)
  if [ -n "$(printf '%s' "$out" | tr -d '[:space:]')" ]; then
    # output produced: a pending retry1 is consumed (the retry recovered)
    rm -f "$retry1f" 2>/dev/null || true
    break
  fi
  # --- empty output: classify before deciding whether to relaunch ---
  silent=0
  if [ "$rc" -eq 1 ]; then
    tail="$(bg_silent_tail)"
    [ "$tail" -lt "$SILENT_TAIL_MAX" ] && silent=1
  fi
  if [ "$silent" -eq 1 ] && [ "$silent_retried" -eq 1 ]; then
    # second silent death: stop; the main flow reports a normal FAIL
    echo "[pi-bg] second silent death (rc=1, no output) - reporting FAIL, no further retry" >&2
    break
  fi
  if [ "$silent" -eq 1 ]; then
    touch "$retry1f" 2>/dev/null || true
    echo "[pi-bg] SILENT death (rc=1, no output, quiet ${tail}s < ${SILENT_TAIL_MAX}s) - relaunching ticket once (retry1)" >&2
    bg_log_retry "silent"
    silent_retried=1
    sleep 3
    continue
  fi
  # Local models occasionally return empty completion (rc=0 with empty stream)
  echo "[pi-bg] empty completion (attempt $attempt), retrying..." >&2
  sleep 3
done

# --- webdrop: full prompt + full output behind a link (channel gets a brief) ---
# pf/of are always written: the exit trap uses out.md to detect a silent death
pf="$BG_TMP/pi-bg-${run_id}-prompt.md"
of="$BG_TMP/pi-bg-${run_id}-out.md"
{ printf '# pi-bg %s task\n\n' "$profile"; printf '%s\n' "$task"; } > "$pf"
printf '%s\n' "$out" > "$of"
if command -v webdrop >/dev/null 2>&1; then
  purl="$(webdrop "$pf" "pi-bg-${run_id}-prompt" --ttl 7d 2>/dev/null | tail -1)" || purl=""
  ourl="$(webdrop "$of" "pi-bg-${run_id}-out" --ttl 7d 2>/dev/null | tail -1)" || ourl=""
fi

# project tag (2026-09-18): attribute this run's session tokens + cost to
# the record BEFORE the callback is built, so the embed's project line
# carries the real number. Bounded + failure-tolerant: never blocks or
# fails the callback (no session file / price error -> null fields, "$-").
if [ -n "$pj_tag" ]; then
  BG_PJ_COST="$(bg_capture_cost)" || BG_PJ_COST=""
fi

if [ -n "$webhook" ]; then
  brief="${out:0:400}"
  if [ -z "$(printf '%s' "$out" | tr -d '[:space:]')" ]; then
    if [ "$rc" -eq 1 ] && [ "$silent_retried" -eq 1 ]; then
      # second silent death (issue #57): the retry1 did not recover;
      # report a normal FAIL (the orchestrator decides the fix round)
      status="FAIL"
      brief="silent death x2 (rc=1, no output; retry1 did not recover - issue #57)"
    else
      # empty output: rc!=0 means pi died (killed/crashed), rc==0 is the
      # local-model empty-completion quirk (retried 3x already)
      [ $rc -ne 0 ] && status="DIED" || status="EMPTY"
    fi
  else
    status="OK"; [ $rc -ne 0 ] && status="FAIL"
  fi
  # reviewer runs: a trailing 'VERDICT: PASS|FAIL' is the real signal
  verdict="$(printf '%s' "$out" | tail -c 300 | grep -oE 'VERDICT: (PASS|FAIL)' | tail -1 | awk '{print $2}')"
  bg_build "$BG_TMP/pi-bg-${run_id}-body.json" "$status" "$brief" "$rc" "$verdict"
  if [ -s "$BG_TMP/pi-bg-${run_id}-body.json" ]; then
    bg_post "$BG_TMP/pi-bg-${run_id}-body.json"
  else
    # fallback: legacy plain text if the embed builder failed
    bodyf="$BG_TMP/pi-bg-${run_id}-body-plain.json"
    body="[bg:${profile}:${status}] cwd=$(pwd) task=${task:0:120}\n\n${out:0:400}"
    body="$(bg_censor "$body")"
    python3 -c 'import json,sys; print(json.dumps({"content": sys.argv[1]}))' "$body" > "$bodyf"
    bg_post "$bodyf" || rm -f "$bodyf"
  fi
fi

printf '%s\n' "$out"
[ "$wt_mode" -eq 1 ] && printf '[pi-bg] worktree kept: %s (branch %s)\n' "$wt_path" "$wt_branch"
exit $rc
