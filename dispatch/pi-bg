#!/usr/bin/env bash
# pi-bg — one-shot pi agent on a role profile (no Discord presence)
# profiles: worker (131k ctx, medium thinking) | reviewer (131k ctx, xhigh thinking)
# usage: cd <workdir> && pi-bg [worker|reviewer] [--worktree <ref>] [pi flags...] "task"
#
# --worktree [ref]: run the agent in a fresh git worktree instead of the live
#   checkout. ref defaults to HEAD (only consumed as ref when more args
#   follow it — otherwise the next arg is the task). Worktree:
#   $PI_BG_WT_DIR/<repo>/<id> (default ~/.pi-bg-wt/<repo>/<id>),
#   branch pi-bg/<id>. The worktree is KEPT after the run so the orchestrator
#   can diff/commit/merge it; path + branch are printed and in the callback.
#
# On completion, posts a callback to the configured Discord webhook:
#   webhook URL from $PI_DISPATCH_WEBHOOK or ~/.config/pi-dispatch/webhook
#   (file absent = no callback; stdout is always printed)
# Callback delivery (issue #14, 2026-09-10): the callback is the ONLY wake
#   mechanism for the orchestrator, so it is hardened:
#   - curl: 3 attempts, backoff 3s/6s, --max-time 15; non-2xx retried
#   - fallback: if the process exits before out.md exists/is non-empty and no
#     callback was posted, an EXIT/TERM/INT trap posts a 'DIED (no report)'
#     callback so a killed worker still wakes the orchestrator
#     (SIGKILL cannot be trapped - see DISPATCH.md recommendations)
#   - dead letter: final post failure writes $PI_BG_TMPDIR/pi-bg-<id>-webhook-failed
#     (PI_BG_TMPDIR default ~/.pi-bg-art; honored by pi-bg-tail/-kill/-watchdog//jobs)
# Fresh machine (issue #29): a missing/empty role profile is seeded from the
#   main agent's ~/.pi/agent/{auth,models}.json + the repo template
#   dispatch/profiles/<role>.json (settings). Still no provider => exit 4
#   with instructions — never a silent empty-completion retry loop.
# No webhook (issue #30): loud warning at dispatch + a run record in
#   ~/.pi-dispatch/runs/pi-bg-<id>.json marked "delivery":"none".
set -uo pipefail

profile="${1:-worker}"
case "$profile" in
  worker|reviewer) shift ;;
  *) echo "unknown profile: $profile (want worker|reviewer)" >&2; exit 2 ;;
esac

export PI_CODING_AGENT_DIR="${HOME}/.pi/agent-${profile}"

# repo root (script lives in <repo>/dispatch) - profile templates + censor.
# Resolve symlinks first (issue #37): the normal launch is the
# ~/scripts/pi-bg symlink install.sh creates, and with the unresolved link
# path JB_ROOT would be $HOME, so the settings.json seed lookup at
# $JB_ROOT/dispatch/profiles/<role>.json silently missed (fresh role got
# auth+models but no settings.json -> pi fell back to its built-in
# provider -> 402). Fallback keeps the old behavior if readlink fails.
JB_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || printf '%s' "${BASH_SOURCE[0]}")")/.." 2>/dev/null && pwd)"

# --- per-run switchboard session id (unique ledger entry per dispatch) ---
run_id="$(date -u +%Y%m%d-%H%M%S)-$RANDOM"
export PI_SESSION_ID="pi-${USER}-${profile}-${run_id}"

# --- per-run artifact dir: default ~/.pi-bg-art (persistent — /tmp on the
#     hydrogen box is a 32G tmpfs that a reboot wipes; 2026-09-13: a wiped
#     /tmp lost every out.md and the watchdog re-flagged finished tickets as
#     DEAD). PI_BG_TMPDIR is honored by pi-bg-tail, pi-bg-kill, pi-bg-watchdog
#     and the bridge /jobs history — keep all per-run files in the same place
#     so every tool finds them. ---
BG_TMP="${PI_BG_TMPDIR:-${HOME}/.pi-bg-art}"
mkdir -p "$BG_TMP" 2>/dev/null

# --- optional --worktree [ref] (consumed before pi flags) ---
wt_ref=""
wt_mode=0
args=()
while [ $# -gt 0 ]; do
  if [ "$1" = "--worktree" ]; then
    wt_mode=1
    shift
    # ref is the next arg only if it is not another flag and something follows
    if [ $# -ge 2 ] && [ "${1#-}" != "$1" ]; then wt_ref="$1"; shift; fi
  else
    args+=("$1")
    shift
  fi
done
set -- "${args[@]+"${args[@]}"}"

wt_path=""
wt_branch=""
if [ "$wt_mode" -eq 1 ]; then
  ref="${wt_ref:-HEAD}"
  top="$(git rev-parse --show-toplevel 2>/dev/null)" || {
    echo "pi-bg: --worktree needs a git repo (cwd=$(pwd) is not one)" >&2; exit 3; }
  id="$run_id"
  wt_path="${PI_BG_WT_DIR:-${HOME}/.pi-bg-wt}/$(basename "$(git rev-parse --show-toplevel)")/$id"
  wt_branch="pi-bg/$id"
  if ! git worktree add -b "$wt_branch" "$wt_path" "$ref" >/dev/null 2>&1; then
    echo "pi-bg: worktree add failed (ref=$ref path=$wt_path)" >&2; exit 3; fi
  echo "[pi-bg] worktree: $wt_path (branch $wt_branch, from $ref) — kept after run"
fi

# task = last positional arg (early: the exit trap needs it)
task="${@: -1}"
out=""; rc=1; purl=""; ourl=""

# --- cgroup escape (automatic, persistent): move THIS process (and all
#     children, incl. pi and the later webhook post) out of pi.service's
#     cgroup so an orchestrator restart can't kill an in-flight run.
#     systemd kills a unit's whole cgroup subtree on stop; a sibling cgroup
#     under the user slice survives. Fallback: run in place if cgroup v2
#     delegation is unavailable (mkdir/proc write fails).
#     PI_BG_CG_ROOT overrides the cgroup base (test hook; pi-bg-kill honors
#     the same var). ---
CG_PARENT="${PI_BG_CG_ROOT:-/sys/fs/cgroup/user.slice/user-$(id -u).slice/user@$(id -u).service}"
ESCAPE_CG="$CG_PARENT/pi-bg/${run_id}"
ESCAPE_ACTIVE=0
if mkdir -p "$ESCAPE_CG" 2>/dev/null && echo $$ > "$ESCAPE_CG/cgroup.procs" 2>/dev/null; then
  ESCAPE_ACTIVE=1
  echo "[pi-bg] cgroup escape active: $ESCAPE_CG"
else
  rmdir "$ESCAPE_CG" 2>/dev/null
  echo "[pi-bg] cgroup escape unavailable, running in caller cgroup"
fi

webhook="${PI_DISPATCH_WEBHOOK:-}"
if [ -z "$webhook" ] && [ -f "${HOME}/.config/pi-dispatch/webhook" ]; then
  webhook="$(head -1 "${HOME}/.config/pi-dispatch/webhook")"
fi

# --- no-webhook warning + run record (issue #30): a missing webhook must
#     not be a silent no-op — the callback is the ONLY wake mechanism. ---
if [ -n "$webhook" ]; then
  delivery="webhook"
else
  delivery="none"
  echo "[pi-bg] no webhook at ${HOME}/.config/pi-dispatch/webhook (and PI_DISPATCH_WEBHOOK unset) - no completion callback; poll with pi-wait" >&2
fi
rec_dir="${PI_DISPATCH_RECORD_DIR:-${HOME}/.pi-dispatch/runs}"
mkdir -p "$rec_dir" 2>/dev/null
PI_BG_REC_RUN="$run_id" PI_BG_REC_PROFILE="$profile" PI_BG_REC_CWD="$(pwd)" \
PI_BG_REC_DELIVERY="$delivery" python3 - "$rec_dir/pi-bg-${run_id}.json" <<'PY' 2>/dev/null || true
import datetime, json, os, sys
rec = {
    "run": os.environ["PI_BG_REC_RUN"],
    "profile": os.environ["PI_BG_REC_PROFILE"],
    "cwd": os.environ["PI_BG_REC_CWD"],
    "started": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
    "delivery": os.environ["PI_BG_REC_DELIVERY"],
}
with open(sys.argv[1], "w") as fh:
    json.dump(rec, fh, indent=2)
PY

# --- profile doctor (issue #29): the role home must hold provider creds.
#     A fresh machine has none; pi then replies empty and the empty-completion
#     retry loop below misfiles a credential-shaped failure. Seed a missing
#     profile from the main agent + the repo template, then fail loud. ---
profile_seeded() {
  local dir="$1" f
  for f in "$dir/auth.json" "$dir/models.json"; do
    [ -s "$f" ] || continue
    python3 - "$f" <<'PY' >/dev/null 2>&1 && return 0
import json, sys
d = json.load(open(sys.argv[1]))
sys.exit(0 if isinstance(d, (dict, list)) and len(d) else 1)
PY
  done
  return 1
}

# true when the file is missing, or parses as an empty object/list.
# A present-but-EMPTY file ({}, which is 2 bytes so [ -s ] passes) is
# still seedable: a profile with BOTH auth.json={} and models.json={}
# must not block seeding from the main agent's valid creds.
empty_json() {
  local f="$1"
  [ -e "$f" ] || return 0
  python3 - "$f" <<'PY' >/dev/null 2>&1
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(1)  # unparseable = treat as user's content, do not clobber
sys.exit(0 if isinstance(d, (dict, list)) and not d else 1)
PY
}

if ! profile_seeded "$PI_CODING_AGENT_DIR"; then
  main_agent="${HOME}/.pi/agent"
  mkdir -p "$PI_CODING_AGENT_DIR" 2>/dev/null
  for f in auth.json models.json; do
    if [ -s "$main_agent/$f" ] && empty_json "$PI_CODING_AGENT_DIR/$f"; then
      cp -L "$main_agent/$f" "$PI_CODING_AGENT_DIR/$f" 2>/dev/null || true
    fi
  done
  if [ ! -e "$PI_CODING_AGENT_DIR/settings.json" ] && [ -n "$JB_ROOT" ] && [ -f "$JB_ROOT/dispatch/profiles/${profile}.json" ]; then
    python3 - "$PI_CODING_AGENT_DIR/settings.json" \
      "$JB_ROOT/dispatch/profiles/${profile}.json" "$main_agent/settings.json" <<'PY' 2>/dev/null || true
import json, sys
out, tpl, main = sys.argv[1], sys.argv[2], sys.argv[3]
try:
    cfg = json.load(open(tpl))
    if not isinstance(cfg, dict): cfg = {}
except Exception:
    cfg = {}
try:
    m = json.load(open(main))
    for k in ("defaultProvider", "defaultModel"):
        v = m.get(k)
        if isinstance(v, str) and v:
            cfg[k] = v
except Exception:
    pass
with open(out, "w") as fh:
    json.dump(cfg, fh, indent=2)
PY
  fi
fi
if ! profile_seeded "$PI_CODING_AGENT_DIR"; then
  {
    echo "pi-bg: profile '$profile' has no provider at $PI_CODING_AGENT_DIR (auth.json/models.json missing or empty)"
    echo "pi-bg: fix: seed credentials, e.g."
    echo "  cp -L ${HOME}/.pi/agent/auth.json ${HOME}/.pi/agent/models.json $PI_CODING_AGENT_DIR/"
    echo "  (or run the main agent once to log in), then re-dispatch."
    if [ -n "$JB_ROOT" ] && [ -f "$JB_ROOT/dispatch/profiles/${profile}.json" ]; then
      echo "pi-bg: settings template: $JB_ROOT/dispatch/profiles/${profile}.json"
    fi
  } >&2
  exit 4
fi

# --- secret censor for callback text (jarate/bin/jarate-censor, bun) ---
# The callback body (task + worker output) is Discord egress from a process
# outside the bridge, so it routes through the same censor + registry.
# Missing tool / bun absent / any error = pass through (never break the wake).
bg_censor() {
  local c
  if [ -n "$1" ] && [ -f "$JB_ROOT/bin/jarate-censor" ] && command -v bun >/dev/null 2>&1; then
    c="$(printf '%s' "$1" | bun "$JB_ROOT/bin/jarate-censor" 2>/dev/null)" && { printf '%s' "$c"; return; }
  fi
  printf '%s' "$1"
}

# --- callback helpers (issue #14): the webhook post is the only wake
#     mechanism, so never let it fail silently. ---
BG_CB_DONE=0
BG_DEAD="$BG_TMP/pi-bg-${run_id}-webhook-failed"
BG_WB_RESP="$BG_TMP/pi-bg-${run_id}-wb-resp.txt"
BG_WB_STATUS="$BG_TMP/pi-bg-${run_id}-wb-status"

# bg_post <body-file>: 3 attempts, backoff, --max-time; 2xx = success.
# success: HTTP code + time recorded in $BG_WB_STATUS (webhook-delivery audit,
#   issue #14) and $BG_WB_RESP kept as the last response body.
# final failure: dead-letter file + stderr note, return 1.
bg_post() {
  local body="$1" code i
  [ -n "$webhook" ] || return 1
  for i in 1 2 3; do
    code="$(curl -s -o "$BG_WB_RESP" -w '%{http_code}' -X POST "$webhook" \
      -H 'Content-Type: application/json' --max-time 15 --data @"$body" 2>/dev/null)" || code="000"
    case "$code" in
      2*) BG_CB_DONE=1; rm -f "$BG_DEAD"
          printf '%s %s\n' "$code" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$BG_WB_STATUS"
          return 0 ;;
    esac
    [ "$i" -lt 3 ] && sleep $(( i * 3 * ${PI_BG_WB_BACKOFF:-1} ))
  done
  { printf 'ticket   : %s\n' "$run_id"
    printf 'http     : %s (3 attempts)\n' "$code"
    printf 'when     : %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'response : %s\n' "$(head -c 300 "$BG_WB_RESP" 2>/dev/null)"
    printf 'body     : %s\n' "$body"; } > "$BG_DEAD"
  echo "[pi-bg] webhook FAILED (http=$code) - dead letter: $BG_DEAD" >&2
  return 1
}

# bg_build <body-file> <status> <brief> <rc> <verdict>: existing embed format
bg_build() {
  local bodyfile="$1" status="$2" brief="$3" brc="$4" verdict="$5"
  BG_WEBHOOK="$webhook" BG_PROFILE="$profile" BG_STATUS="$status" BG_RC="$brc" \
  BG_VERDICT="$verdict" BG_DUR="${SECONDS}" BG_TASK="$(bg_censor "${task:0:200}")" \
  BG_BRIEF="$(bg_censor "$brief")" \
  BG_WT="$wt_path" BG_BRANCH="$wt_branch" BG_CWD="$(pwd)" BG_RUN="$run_id" \
  BG_PURL="$purl" BG_OURL="$ourl" \
  python3 - > "$bodyfile" 2>/dev/null <<'PY'
import json, os, sys, datetime
E = lambda k: os.environ.get("BG_" + k, "")
prof, status, rc, verdict = E("PROFILE"), E("STATUS"), E("RC"), E("VERDICT")
dur = int(E("DUR") or 0)
dstr = f"{dur//60}m{dur%60:02d}s"
GREEN, RED, ORANGE = 3066993, 15158332, 15105570
if prof == "reviewer" and verdict:
    ok = verdict == "PASS"
    title = ("\u2713 reviewer \u00b7 PASS" if ok else "\u2717 reviewer \u00b7 FAIL") + f" \u00b7 {dstr}"
    color = GREEN if ok else RED
elif status == "OK":
    title = f"\u2713 {prof} \u00b7 OK \u00b7 {dstr}"; color = GREEN
elif status == "FAIL":
    title = f"\u2717 {prof} \u00b7 FAIL (rc={rc}) \u00b7 {dstr}"; color = RED
elif status == "DIED":
    title = f"\u26a0 {prof} \u00b7 DIED (no report) \u00b7 {dstr}"; color = ORANGE
else:
    title = f"\u26a0 {prof} \u00b7 EMPTY \u00b7 {dstr}"; color = ORANGE
meta = ["$ pi-bg " + prof + (" --worktree" if E("WT") else ""),
        f"status : {status}" + (f" (rc={rc})" if status in ("FAIL", "DIED") else "")]
if E("WT"):
    wtdir = os.path.dirname(E("WT").rstrip("/"))
    meta += [f"repo   : {os.path.basename(wtdir) or '?'}",
             f"wt     : {E('WT')}", f"branch : {E('BRANCH')}"]
else:
    meta += [f"cwd    : {E('CWD')}"]
embed = {"author": {"name": f"pi-bg ticket \u00b7 {E('RUN')}"},
         "color": color, "title": title,
         "description": "```bash\n" + "\n".join(meta) + "```",
         "fields": [{"name": "task", "value": E("TASK") or "-", "inline": False},
                    {"name": "result", "value": E("BRIEF") or "-", "inline": False}],
         "footer": {"text": "pi-bg"},
         "timestamp": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")}
if E("PURL"):  embed["fields"].append({"name": "prompt", "value": f"[view]({E('PURL')})", "inline": True})
if E("OURL"):  embed["fields"].append({"name": "full output", "value": f"[view]({E('OURL')})", "inline": True})
json.dump({"embeds": [embed]}, sys.stdout)
PY
}

# bg_on_exit: cgroup cleanup + the 'died without report' fallback. If we exit
# with no out.md and no posted callback, post DIED so the orchestrator wakes.
# (covers TERM/INT/normal-exit paths; SIGKILL cannot be trapped)
# cgroup drain: by the time this trap runs, every child is gone — the pi loop
# uses wait, webdrop/webhook post are synchronous — so the ONLY member left
# is this shell. Move it back into the parent cgroup (it exits right after),
# then rmdir: cgroup v2 auto-removes the cgroup files once the last member
# leaves, so the dir is empty and rmdir succeeds. Without the self-move-out
# the rmdir always fails (348 leaked empty dirs, 2026-09-11). Guarded: a
# missing/non-empty dir must never break the exit path. SIGKILLed wrappers
# can't run this at all — pi-bg-kill reaps the drained cgroup dir itself.
bg_on_exit() {
  local ec=$?
  if [ "$BG_CB_DONE" -eq 0 ] && [ -n "$webhook" ] && \
     [ ! -s "$BG_TMP/pi-bg-${run_id}-out.md" ]; then
    [ -n "${pi_pid:-}" ] && kill "$pi_pid" 2>/dev/null
    bg_build "$BG_TMP/pi-bg-${run_id}-body.json" "DIED" \
      "no output captured - pi-bg exited before completion (exit=$ec)" "$ec" ""
    bg_post "$BG_TMP/pi-bg-${run_id}-body.json" || true
  fi
  if [ "$ESCAPE_ACTIVE" -eq 1 ]; then
    echo $$ > "$CG_PARENT/cgroup.procs" 2>/dev/null || true
    # real cgroup v2 auto-removes its files when the last member leaves;
    # on a plain test root the fake file must be removed for rmdir to work
    rm -f "$ESCAPE_CG/cgroup.procs" 2>/dev/null || true
    rmdir "$ESCAPE_CG" 2>/dev/null || true
  fi
}
trap bg_on_exit EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# retry on empty completion (local model quirk: some phrasings return nothing)
# pi runs in background + wait so a trapped TERM/INT fires immediately
# (a trapped signal during a foreground command is deferred until it returns)
pi_pid=""
rawf="$BG_TMP/pi-bg-${run_id}-raw.out"
errf="$BG_TMP/pi-bg-${run_id}-err.log"
# standard constraints: append to the final (task) argument of every run
pi_args=( "$@" )
pi_args[-1]+=$'\n\nSTANDARD CONSTRAINTS (all tasks):\n- Never run commands that need a TTY interactively: use plain `podman exec` / `docker exec` (no -it), redirect output. An interactive child hung a 9h dispatch on 2026-09-10.\n- Bound long commands with `timeout` (default 600s) unless the task says otherwise.'
for attempt in 1 2 3; do
  if [ "$wt_mode" -eq 1 ]; then
    ( cd "$wt_path" && exec pi -p --no-extensions "${pi_args[@]}" ) > "$rawf" 2> "$errf" &
  else
    pi -p --no-extensions "${pi_args[@]}" > "$rawf" 2> "$errf" &
  fi
  pi_pid=$!
  wait "$pi_pid"; rc=$?; pi_pid=""
  out="$(cat "$rawf")"
  [ -n "$(printf '%s' "$out" | tr -d '[:space:]')" ] && break
  echo "[pi-bg] empty completion (attempt $attempt), retrying..." >&2
  sleep 3
done

# --- webdrop: full prompt + full output behind a link (channel gets a brief) ---
# pf/of are always written: the exit trap uses out.md to detect a silent death
pf="$BG_TMP/pi-bg-${run_id}-prompt.md"
of="$BG_TMP/pi-bg-${run_id}-out.md"
{ printf '# pi-bg %s task\n\n' "$profile"; printf '%s\n' "$task"; } > "$pf"
printf '%s\n' "$out" > "$of"
if command -v webdrop >/dev/null 2>&1; then
  purl="$(webdrop "$pf" "pi-bg-${run_id}-prompt" --ttl 7d 2>/dev/null | tail -1)" || purl=""
  ourl="$(webdrop "$of" "pi-bg-${run_id}-out" --ttl 7d 2>/dev/null | tail -1)" || ourl=""
fi

if [ -n "$webhook" ]; then
  if [ -z "$(printf '%s' "$out" | tr -d '[:space:]')" ]; then
    # empty output: rc!=0 means pi died (killed/crashed), rc==0 is the
    # local-model empty-completion quirk (retried 3x already)
    [ $rc -ne 0 ] && status="DIED" || status="EMPTY"
  else
    status="OK"; [ $rc -ne 0 ] && status="FAIL"
  fi
  # reviewer runs: a trailing 'VERDICT: PASS|FAIL' is the real signal
  verdict="$(printf '%s' "$out" | tail -c 300 | grep -oE 'VERDICT: (PASS|FAIL)' | tail -1 | awk '{print $2}')"
  bg_build "$BG_TMP/pi-bg-${run_id}-body.json" "$status" "${out:0:400}" "$rc" "$verdict"
  if [ -s "$BG_TMP/pi-bg-${run_id}-body.json" ]; then
    bg_post "$BG_TMP/pi-bg-${run_id}-body.json"
  else
    # fallback: legacy plain text if the embed builder failed
    bodyf="$BG_TMP/pi-bg-${run_id}-body-plain.json"
    body="[bg:${profile}:${status}] cwd=$(pwd) task=${task:0:120}\n\n${out:0:400}"
    body="$(bg_censor "$body")"
    python3 -c 'import json,sys; print(json.dumps({"content": sys.argv[1]}))' "$body" > "$bodyf"
    bg_post "$bodyf" || rm -f "$bodyf"
  fi
fi

printf '%s\n' "$out"
[ "$wt_mode" -eq 1 ] && printf '[pi-bg] worktree kept: %s (branch %s)\n' "$wt_path" "$wt_branch"
exit $rc
