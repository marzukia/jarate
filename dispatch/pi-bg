#!/usr/bin/env bash
# pi-bg — deprecated shim (jarate #151): forwards to jarate-bg.
# One stderr line; stdout + rc pass through untouched (the ticket line
# must stay the first stdout line).
echo "pi-bg: deprecated, use jarate-bg (jarate #151)" >&2
exec "$(dirname "$(readlink -f "$0")")/jarate-bg" "$@"
