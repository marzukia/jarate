#!/usr/bin/env bash
# jarate-bg-kill — cancel an in-flight jarate-bg worker via its cgroup (issue #15)
#
# jarate-bg moves each run into its own cgroup at dispatch (the escape path is
# printed on stdout): /sys/fs/cgroup/user.slice/user-<uid>.slice/user@<uid>.
# service/pi-bg/<ticket-id>/. Killing via the cgroup is precise: only this
# run's process tree dies, nothing else.
# usage: jarate-bg-kill <ticket-id|short-suffix> [--dry-run]
#   ticket id is YYYYMMDD-HHMMSS-NNNNN; a 7+ digit suffix is resolved via
#   the run records (~/.pi-dispatch/runs) when it matches exactly one run
#   --dry-run  print the process tree that WOULD be killed; change nothing
# real kill: SIGTERM to every member AND the ticket's process group (issue
# #56: jarate-bg runs under setsid - the wrapper is the session leader, the pi
# child shares its PGID; signaling a group-leader member's -pgid covers
# session processes that escaped the cgroup walk and keeps the pi child
# from orphaning), wait $PI_BG_KILL_WAIT (default 10s) polling every 0.5s,
# then SIGKILL (cgroup.kill + per-pid + per-group fallback). Posts a
# kind=kill webhook event (same URL source as jarate-bg) so the dispatch
# channel sees it. Marker: $PI_BG_TMPDIR/pi-bg-<id>-killed (the watchdog
# skips killed tickets) + the run record ($PI_DISPATCH_RECORD_DIR,
# default ~/.pi-dispatch/runs) is marked state=cancelled (issue #51
# sticky terminal: manual kill = the CANCELLED class, distinct from
# state=killed, the watchdog/launch-fail audit path). The marker is
# written BEFORE the signals: the wrapper's exit trap (running
# concurrently with the drain poll) suppresses its own DIED post when it
# sees the marker, so a manual kill fires exactly one terminal embed.
# The CANCELLED embed post failure writes a dead letter
# (pi-bg-<id>-kill-webhook-failed, self-contained since #53).
# env: PI_BG_CG_ROOT (cgroup base, test override), PI_BG_KILL_WAIT,
#      PI_BG_TMPDIR, PI_DISPATCH_WEBHOOK, PI_BG_WB_BACKOFF (test: 0 = no backoff)
# exits: 0 = killed (or dry-run), 2 = bad usage / unknown ticket
set -uo pipefail

# Shared dispatch contracts (issue #262: ticket regex, webhook resolver,
# record/cgroup paths, retry shape, frame helpers) - dispatch/lib.sh +
# dispatch/jrate_common.py. The scripts are invoked through install.sh
# symlinks; lib.sh resolves its own real path for JRATE_LIB_DIR.
source "$(dirname "$(readlink -f "$0")")/lib.sh"

BG_TMP="${PI_BG_TMPDIR:-${HOME}/.pi-bg-art}"
mkdir -p "$BG_TMP" 2>/dev/null
CG_ROOT="$(jrate_cg_root)"
KILL_WAIT="${PI_BG_KILL_WAIT:-10}"
# run records (issue #51 + #86 short-id resolution): the same dir jarate-bg
# writes state=running/done/killed records into (single derivation in
# lib.sh, issue #262). Defined up front: the id validator below resolves
# short ids against it.
REC_DIR="$(jrate_rec_dir)"

id="" dry=0
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) dry=1; shift ;;
    -h|--help) sed -n '2,24p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) echo "unknown arg: $1 (want <ticket-id> [--dry-run])" >&2; exit 2 ;;
    *)
      if [ -z "$id" ]; then id="$1";
      else echo "unknown arg: $1 (want <ticket-id> [--dry-run])" >&2; exit 2; fi
      shift
      ;;
  esac
done
[ -n "$id" ] || { echo "usage: jarate-bg-kill <ticket-id> [--dry-run]" >&2; exit 2; }
# id validation + short-id resolution (issue #262: the regex + the record
# scan live in lib.sh, shared with jarate-bg signal).
# Short id (issue #86): the strict full-id regex used to be the only
# accepted form, so the natural cleanup call `jarate-bg-kill 2332046` exited
# 2; with the caller's stderr on /dev/null (as the incident loop had it)
# that was a silent no-op and four live workers died un-killled. A
# 7+ digit numeric arg is resolved against the run records: the ticket
# suffix must match EXACTLY ONE record file. 0 matches or 2+ matches ->
# exit 2 with a clear error on stderr (check the exit code; read stderr).
id_orig="$id"
id_rc=0
id="$(jrate_resolve_ticket "$id" "$REC_DIR" "jarate-bg-kill")" || id_rc=$?
case "$id_rc" in
  0) ;;
  2) echo "jarate-bg-kill: '$id_orig' is not a ticket id (want YYYYMMDD-HHMMSS-NNNNN, or a unique 7+ digit suffix resolved from $REC_DIR)" >&2; exit 2 ;;
  *) exit 2 ;;
esac

# temp-file cleanup (issue: /tmp inode exhaustion, 2026-09-14): the
# kill-body.json webhook payload is scratch. The EXIT trap unlinks it on
# every trapped exit path (normal, error, INT, TERM - the INT/TERM traps
# funnel into this EXIT trap), so a failing or killed jarate-bg-kill leaves no
# payload behind. Kept: the -killed marker and the kill-webhook-failed dead
# letter (the watchdog and /jobs history read them).
trap 'rm -f "$BG_TMP/pi-bg-${id:-}-kill-body.json" 2>/dev/null' EXIT
# INT/TERM (review #183 F5): an interrupted kill drops the PROVISIONAL
# marker (kill-in-progress). It only exists to suppress the wrapper's DIED
# post, and the wrapper is still draining in parallel - with the marker
# gone the wrapper posts DIED (pre-interrupt behavior) instead of the
# ticket ending with ZERO terminal embeds (marker suppressed DIED, record
# closed done, no CANCELLED post yet). Re-running jarate-bg-kill then
# posts CANCELLED (empty cgroup, instant drain). The FINAL marker (after
# the drain) survives the interrupt: it is the has_killed evidence +
# worktree auto-prune input. The drop rescues DIED mainly in the
# deferred-trap/fast-interrupt case: the trap fires immediately from
# wait, so a mid-drain Ctrl-C usually lands after the wrapper's DIED
# suppression has already happened.
kill_interrupt() {
  local rc="$1"
  if grep -q 'kill-in-progress' "$BG_TMP/pi-bg-${id:-}-killed" 2>/dev/null; then
    rm -f "$BG_TMP/pi-bg-${id:-}-killed" 2>/dev/null
  fi
  exit "$rc"
}
trap 'kill_interrupt 130' INT
trap 'kill_interrupt 143' TERM

CG="$CG_ROOT/pi-bg/$id"
if [ ! -d "$CG" ]; then
  echo "jarate-bg-kill: no cgroup for ticket '$id' ($CG missing) - unknown ticket, run in caller cgroup (no escape), or already reaped" >&2
  exit 2
fi

# --- cgroup members (processes only).
# cgroup.threads is deliberately excluded: per-pid signaling of thread IDs
# can hit a recycled PID (a brand-new subshell of the dying wrapper, a fresh
# bun worker thread) and corrupt the wrapper's exit-trap cleanup. Every thread
# dies with its process, and the KILL phase's cgroup.kill is the backstop.
cg_procs() { cat "$CG/cgroup.procs" 2>/dev/null | sort -un; }

# 0 when /proc/<pid>/stat says the process is a group leader (pgrp == pid).
# stat fields after 'pid (comm)': state ppid pgrp session ...
is_group_leader() {
  local want="$1" s
  s="$( { tr -d '\n' < "/proc/$want/stat"; } 2>/dev/null )" || return 1
  s="${s#*) }"
  set -- $s
  [ "${3:-}" = "$want" ]
}

# cgroup members plus every descendant: the /proc ppid scan + the BFS live
# in lib.sh (issue #262, shared with jarate-bg signal). The cgroup v2 move
# carries the whole subtree, so descendants close the fallback case where
# escape failed.
list_tree() { jrate_list_tree "$CG"; }

print_tree() {
  echo "process tree for $id (would be killed):"
  local p
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    if ps -o pid=,ppid=,etime=,args= -p "$p" 2>/dev/null; then
      :
    else
      echo "$p  (gone)"
    fi
  done < <(list_tree | sort -un)
}

if [ "$dry" -eq 1 ]; then
  print_tree
  echo "dry-run: no signal sent"
  exit 0
fi

# --- SIGTERM, wait, escalate to SIGKILL ---
# #51 sticky terminal: the -killed marker is written BEFORE the signals
# (provisional duration) so the wrapper's exit trap - which runs
# concurrently with our drain poll - suppresses its DIED post. The final
# line (real duration) rewrites it below.
pids0="$(list_tree | sort -un | tr '\n' ' ')"
[ -n "$pids0" ] || pids0="(none in cgroup)"
printf '%s kill-in-progress %s by %s after 0s; pids: %s\n' \
  "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$id" "$(id -un)" "$pids0" \
  > "$BG_TMP/pi-bg-${id}-killed"
# t0 AFTER list_tree: KILL_WAIT is the grace window after the TERM, not
# after script start. list_tree scans /proc and can take seconds on a
# loaded host; timing from start expired the grace before the TERM was
# even sent, so the KILL escalation landed milliseconds after the TERM
# and beat the wrapper's exit trap (left its hb/started files behind,
# 2026-09-15 incident).
t0="$(date +%s)"

# issue #56: jarate-bg runs under setsid, so a group-leader member of the tree
# leads the ticket's session (pgid == sid == its pid). Signal those process
# groups too, so every session process dies with the ticket even if it
# escaped the cgroup walk - a wrapper-only kill would orphan the pi child.
gl=""
for p in $pids0; do
  case "$p" in *[!0-9]*) continue ;; esac
  is_group_leader "$p" && gl="$gl $p"
done

for p in $pids0; do kill -TERM "$p" 2>/dev/null; done
for g in $gl; do kill -TERM "-$g" 2>/dev/null; done

gone=0
while :; do
  if [ ! -d "$CG" ] || [ -z "$(cg_procs)" ]; then gone=1; break; fi
  [ $(( $(date +%s) - t0 )) -ge "$KILL_WAIT" ] && break
  sleep 0.5
done
if [ "$gone" -eq 0 ]; then
  # cgroup.kill guard (issue #86): cgroup.kill nukes every CURRENT member,
  # so it is only safe on an EMPTY cgroup - "stale" means no processes.
  # Non-empty here: the targeted per-pid/group SIGKILL below is the kill
  # path; a blind cgroup.kill in this window would kill whatever shows up
  # next. 2026-09-25: a cleanup loop wrote cgroup.kill on four LIVE ticket
  # cgroups and killed four workers mid-run (one 2s after its last tool
  # call). Live PIDs -> warning, no write.
  if [ -z "$(cg_procs)" ]; then
    echo 1 > "$CG/cgroup.kill" 2>/dev/null || true
  else
    echo "jarate-bg-kill: warning: $CG not empty (live PIDs), skipping cgroup.kill - per-pid SIGKILL only" >&2
  fi
  for p in $pids0; do kill -KILL "$p" 2>/dev/null; done
  for g in $gl; do kill -KILL "-$g" 2>/dev/null; done
fi
dur=$(( $(date +%s) - t0 ))

# cgroup has drained (every member dead) -> remove the dir. While any member
# is alive rmdir fails, and SIGKILLed wrappers can't clean up themselves,
# so this is where the empty pi-bg/<ticket> dirs get reaped (348 leaked,
# 2026-09-11). Guarded: never break the kill path over a stubborn dir.
# A SIGKILLed wrapper leaves its fake cgroup.procs file behind (real
# cgroupfs auto-removes the entry when the last member dies) and the
# escalation write above leaves a cgroup.kill file on non-cgroupfs roots -
# clear both so rmdir works. Drop the heartbeat as well: a killed run must
# not keep advertising liveness (issue #52).
rm -f "$CG/cgroup.procs" 2>/dev/null
rm -f "$CG/cgroup.kill" 2>/dev/null
rm -f "$BG_TMP/pi-bg-${id}-hb" 2>/dev/null
[ -d "$CG" ] && rmdir "$CG" 2>/dev/null

printf '%s killed %s by %s after %ss; pids: %s\n' \
  "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$id" "$(id -un)" "$dur" "$pids0" \
  > "$BG_TMP/pi-bg-${id}-killed"

# mark the run record cancelled (issue #51 sticky terminal): a manual
# kill is the CANCELLED class, distinct from state=killed (watchdog audit
# / launch-fail). The wrapper's exit trap has already marked it "done"
# (its trap runs during our drain poll); "cancelled" is the final state.
# Same audit-only posture as jarate-bg: a missing/corrupt record never
# breaks the kill path.
if [ -f "$REC_DIR/pi-bg-${id}.json" ]; then
  jrate_rec_set_state "$REC_DIR/pi-bg-${id}.json" "cancelled"
fi

# --- kind=kill webhook event (same URL source + embed shape as jarate-bg) ---
webhook="$(jrate_webhook)"
if [ -n "$webhook" ]; then
  bodyf="$BG_TMP/pi-bg-${id}-kill-body.json"
  KILL_T="$id" KILL_PIDS="$(echo "$pids0" | tr ' ' ',' | cut -c1-200)" KILL_DUR="$dur" \
  python3 - > "$bodyf" 2>/dev/null <<'PY'
import json, os, sys, datetime
sys.path.insert(0, os.environ["JRATE_LIB_DIR"])
from jrate_common import FRAME_W, ORANGE_DEAD, clip_start, kv
E = lambda k: os.environ.get("KILL_" + k, "")
def rid_line(prefix, rid):
    # the rid lines are the only overflow risk (7-digit pid): keep the
    # tail - the pid end is the discriminator
    line = prefix + rid
    if len(line) > FRAME_W:
        line = prefix + clip_start(rid, FRAME_W - len(prefix))
    return line
rid = E("T")
# v3 style (mockup3, 2026-09-13): no dingbat in the title; the description
# is a framed block (box-drawing + ASCII + middle dot), <= FRAME_W cols.
title = "pi-bg " + rid + " \u00b7 CANCELLED"
meta = [rid_line("\u250c cancelled \u00b7 ", rid),
        rid_line("\u251c $ jarate-bg-kill ", rid),
        kv("pids", E("PIDS")),
        "\u251c " + "wait".ljust(6) + " : " + E("DUR") + "s (TERM->KILL)",
        "\u251c " + "state".ljust(6) + " : cancelled on request",
        "\u2514"]
embed = {"author": {"name": "pi-bg ticket \u00b7 " + rid},
         "color": ORANGE_DEAD,  # orange, same as jarate-bg DIED
         "title": title,
         "description": "```bash\n" + "\n".join(meta) + "\n```",
         "footer": {"text": "pi-bg kill"},
         "timestamp": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")}
json.dump({"embeds": [embed]}, sys.stdout)
PY
  if [ -s "$bodyf" ]; then
    ok=0
    # Shared retry shape (issue #262, lib.sh jrate_wb_post): 3 tries,
    # escalating backoff PI_BG_WB_BACKOFF seconds (default 3s/6s);
    # PI_BG_WB_BACKOFF=0 = no sleep (test seam).
    code="$(jrate_wb_post "$webhook" "$bodyf" /dev/null)" && ok=1
    if [ "$ok" -eq 0 ]; then
      # self-contained letter (issue #53): the watchdog re-posts it on a
      # later sweep. The body is embedded NOW (rm -f below would dangle
      # a `body     : <path>` reference).
      { printf 'ticket   : %s\nevent    : kill\nhttp     : %s (3 attempts)\nwhen     : %s\n' \
          "$id" "$code" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        printf -- '--- body json ---\n'
        cat "$bodyf" 2>/dev/null; } > "$BG_TMP/pi-bg-${id}-kill-webhook-failed"
      echo "jarate-bg-kill: webhook FAILED (http=$code) - dead letter: $BG_TMP/pi-bg-${id}-kill-webhook-failed" >&2
    fi
    rm -f "$bodyf"
  fi
fi

echo "jarate-bg-kill: killed $id after ${dur}s (pids: $pids0)"
exit 0
