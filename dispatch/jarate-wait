#!/usr/bin/env bash
# jarate-wait — poll the monky Discord channel for the next bus event (in-turn wait)
# usage: jarate-wait --since <message-id> [--timeout 300] [--check 5]
# exits (rc contract, issue #117):
#   0 = webhook callback arrived  → prints its content
#   2 = human message arrived     → prints "human: <name>" (break early)
#   3 = timeout                   → prints "timeout"
# #117: a failed poll must not end the wait with an arbitrary rc (curl 28,
# python 1) under set -e. Transient curl/python errors inside the poll loop
# skip that poll and the wait runs to the deadline (rc 3). If the startup
# bot-id fetch keeps failing after retries, the wait also ends rc 3, with a
# stderr diagnostic (nothing arrived; the caller reports / re-waits / drops).
# config (all from ~/.pi/agent/settings.json, no secrets in this repo):
#   bot token + channel id from channels[0]
#   webhook author id from ~/.config/pi-dispatch/webhook_author
set -euo pipefail

since=""; timeout=300; check=5
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) sed -n '2,/^set -euo pipefail$/{ /^set -euo pipefail$/d; p }' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --since) since="$2"; shift 2 ;;
    --timeout) timeout="$2"; shift 2 ;;
    --check) check="$2"; shift 2 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done
[ -n "$since" ] || { echo "--since <message-id> required" >&2; exit 2; }

cfg="${HOME}/.pi/agent/settings.json"
token="$(python3 -c 'import json;print(json.load(open("'"$cfg"'"))["channels"][0]["botToken"])')"
channel="$(python3 -c 'import json;print(json.load(open("'"$cfg"'"))["channels"][0]["channel"])')"
# issue #120: the bot token never sits in curl's argv (a bare `ps` leaked
# it). It rides a curl config fed on STDIN (`curl -K -`): the printf is a
# bash builtin (no child argv to leak), only the config bytes cross the
# pipe. Every curl is bounded: --max-time 15.
discord_get() { # $1 = url
  printf 'header = "Authorization: Bot %s"\n' "$token" \
    | curl -s -K - --max-time 15 --connect-timeout 5 "$1"
}
# #117: the startup fetch retries (a hung/stalled TLS read is bounded by
# --max-time/--connect-timeout) and a final failure maps to rc 3 instead of
# leaking curl's rc under set -e.
botid=""
for i in 1 2 3; do
  body="$(discord_get https://discord.com/api/v10/users/@me)" || body=""
  if [ -n "$body" ]; then
    botid="$(printf '%s' "$body" | python3 -c 'import json,sys;print(json.load(sys.stdin)["id"])' 2>/dev/null)" || botid=""
  fi
  if [ -n "$botid" ]; then break; fi
  [ "$i" -lt 3 ] && sleep 2
done
[ -n "$botid" ] || {
  echo "jarate-wait: cannot fetch bot id (discord unreachable?)" >&2
  echo "timeout"; exit 3
}
wa="$(head -1 "${HOME}/.config/pi-dispatch/webhook_author" 2>/dev/null || true)"
[ -n "$wa" ] || { echo "webhook_author missing" >&2; exit 2; }

end=$(( $(date +%s) + timeout ))
while [ "$(date +%s)" -lt "$end" ]; do
  # #117: a failed poll (curl rc, or Discord answering with a non-JSON body
  # that breaks the parse) skips this iteration; the deadline still bounds
  # the wait, so the rc contract (0/2/3) holds.
  event=""
  if msgs="$(discord_get "https://discord.com/api/v10/channels/${channel}/messages?after=${since}&limit=50")"; then
    event="$(MSGS="$msgs" python3 - "$wa" "$botid" <<'EOF'
import json, os, sys
wa, bot = sys.argv[1], sys.argv[2]
for m in json.loads(os.environ["MSGS"]):
    a = m.get("author", {}).get("id")
    if a == bot:
        continue  # my own messages
    if m.get("webhook_id") and a == wa:
        # B1 (polish sweep): an embed-only callback (pi-bg Variant D)
        # carries no top-level content. Serialize the first embed the
        # way the bridge does (title + description + fields) so the
        # waiting agent gets the framed result, not an empty detail line.
        c = m.get("content") or ""
        if not c:
            e = (m.get("embeds") or [{}])[0]
            lines = []
            if e.get("title"):
                lines.append(e["title"])
            if e.get("description"):
                lines.append(e["description"])
            for f in e.get("fields") or []:
                nm = f.get("name") or ""
                if nm:
                    lines.append(nm + ": " + (f.get("value") or ""))
            c = "\n".join(lines)
        print("0\t" + m["id"] + "\t" + c)
        break
    name = m.get("author", {}).get("global_name") or m.get("author", {}).get("username", "")
    print("2\t" + m["id"] + "\t" + name)
    break
EOF
    )" || event=""
  fi
  if [ -n "$event" ]; then
    code="${event%%$'\t'*}"
    rest="${event#*$'\t'}"
    newid="${rest%%$'\t'*}"
    detail="${rest#*$'\t'}"
    if [ "$code" = "0" ]; then
      echo "CALLBACK $newid"; printf '%s\n' "$detail"; exit 0
    else
      echo "HUMAN $newid: ${detail}"; exit 2
    fi
  fi
  sleep "$check"
done
echo "timeout"; exit 3
