#!/usr/bin/env bash
# jarate-bg — bg dispatch launcher (RETIRED, hall-monitor #35, 2026-10-20)
#
# hall-monitor fleetwork is now the fleet's dispatch control (LIVE
# 2026-10-20). New dispatches go to the fleet:
#
#   POST http://100.95.144.25:8001/api/fleet/dispatch   (X-Agent-Key header)
#
#   - run CWD:      /srv/fleetwork/work/<ticket>
#   - push:         feature branches to the bare mirror /srv/fleetwork/<repo>.git
#                   (never origin/main)
#   - terminal:     state returns as a [bg: fleetwork] <ticket> <agent> <state> line
#
# The launch path is STUBBED (retirement notice + exit 10), not deleted:
# in-flight tickets (dispatched before retirement) keep running to
# completion under the old topology, and the ~/.pi-bg-art artifact
# convention + run records survive for the completion side, which stays
# alive until the last in-flight ticket drains:
#   jarate-bg-watchdog  completion checks + DEAD/SILENT sweep + dead letters
#   jarate-bg-tail      live output of an in-flight run
#   jarate-bg-kill      cancel an in-flight run via its cgroup
#   jarate-wait         in-turn wait for the callback
# The watchdog's DEAD-retry re-dispatch (issue #110) targets this
# launcher: it now lands on the retirement error (rc 10, no run record),
# so the retry stays HELD and the DEAD embed carries the human decision —
# no new run enters the retired path.
#
# Retained subcommand (in-flight intervention, issue #143):
#   jarate-bg signal <run-id> <TERM|KILL> [--dry-run]
#     signal the run's cgroup tree (per-pid, never the process group -
#     that is jarate-bg-kill) and emit the receipt: stdout line +
#     dead-log line + webhook post (issue #143, same event path as the
#     watchdog's mid-run events). rc 0 = all signaled members gone,
#     3 = still alive after PI_BG_SIGNAL_WAIT, 2 = usage/unknown.
#
# RUN-IDENTITY CONTRACT (single-sourced for dispatch; issue #262).
# A ticket/run id is `<YYYYMMDD-HHMMSS>-<suffix>`: 8-digit UTC date,
# 6-digit UTC time, and a NUMERIC SUFFIX OF VARIABLE WIDTH (the
# watchdog mints <stamp>-$RANDOM, 1-5 digits; the retired launcher
# minted <stamp>-$). Every producer/consumer validates against the
# regex - never assume a fixed suffix width:
#   regex:     ^[0-9]{8}-[0-9]{6}-[0-9]+$  (lib.sh JRATE_TICKET_RE)
#   record:    <rec-dir>/pi-bg-<id>.json   (lib.sh jrate_rec_dir)
#   cgroup:    <cg-root>/pi-bg/<id>        (lib.sh jrate_cg_root)
#   artifacts: $PI_BG_TMPDIR/pi-bg-<id>-*  (watchdog bg_artifact_glob)
#   short id:  a unique 7+ digit suffix of <id> (issue #86;
#              lib.sh jrate_resolve_ticket scans the run records)
# The bridge side of the contract - the [bg: wake marker - is
# isBgWebhook in packages/bridge/channel/format.ts.
#
# Shared logic (ticket regex, webhook resolver, record/cgroup paths,
# retry shape, frame helpers) lives in dispatch/lib.sh +
# dispatch/jrate_common.py (issue #262).
#
# Exit codes: 0/3 signal receipt (gone / still alive) | 2 usage (signal)
#             | 10 launch path retired (this is not a failure of a run).

set -uo pipefail

# Shared dispatch contracts (issue #262). The scripts are invoked through
# install.sh symlinks; lib.sh resolves its own real path, so JRATE_LIB_DIR
# (the python import root) points at this checkout's dispatch/.
source "$(dirname "$(readlink -f "$0")")/lib.sh"

# --- SIGPIPE hardening (kept from the launcher; #101 follow-up) -----------
# A dispatcher that pipes us into `head` used to kill the launcher before
# the receipt post (SIGPIPE, default disposition dies without running
# anything). Ignoring SIGPIPE makes those writes fail EPIPE instead.
trap "" PIPE

# -h/--help: print this header
if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  sed -n '2,/^set -uo pipefail$/{ /^set -uo pipefail$/d; p }' "$0" | sed 's/^# \{0,1\}//'
  exit 0
fi

# --- signal subcommand (issue #143): mid-run intervention + receipt -------
# The incident (2026-10-04/05): an operator killed a wedged grandchild of a
# dispatched worker by hand, then POLLED (sleep + tail of the session
# jsonl) to verify the run resumed - nothing reported the kill. This
# subcommand performs the signal on the run's cgroup tree (same
# enumeration as jarate-bg-kill) AND emits the receipt on the same event
# path as the watchdog's mid-run events: a stdout line + a dead-log line
# (class "signal" - already_dead ignores it, so a later real death is not
# suppressed) + a webhook post (embed-only, author "pi-bg ticket · <t>"
# so the bridge exemption wakes the channel; green = the run is alive).
# The watchdog's CHILD-LEFT event (a separate class; both may fire the
# same day) confirms the departure on the next sweep.
# Per-pid signals ONLY, never the process group: the whole run shares one
# session (setsid, issue #56) - a group signal is a whole-run kill (that
# is jarate-bg-kill). The receipt is best-effort over the webhook: the
# dead-log line is the durable receipt, the run keeps running, and its
# own callback still wakes the orchestrator.
if [ "${1:-}" = "signal" ]; then
  shift
  sig_id="" sig_name="" sig_dry=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --dry-run) sig_dry=1; shift ;;
      -h|--help) echo "usage: jarate-bg signal <run-id> <TERM|KILL> [--dry-run]"; exit 0 ;;
      -*) echo "jarate-bg signal: unknown arg: $1 (want <run-id> <TERM|KILL> [--dry-run])" >&2; exit 2 ;;
      *)
        if [ -z "$sig_id" ]; then sig_id="$1"
        elif [ -z "$sig_name" ]; then sig_name="$1"
        else echo "jarate-bg signal: unknown arg: $1 (want <run-id> <TERM|KILL> [--dry-run])" >&2; exit 2; fi
        shift
        ;;
    esac
  done
  [ -n "$sig_id" ] && [ -n "$sig_name" ] || { echo "usage: jarate-bg signal <run-id> <TERM|KILL> [--dry-run]" >&2; exit 2; }
  case "$sig_name" in
    TERM | 15) sig_name="TERM" ;;
    KILL | 9) sig_name="KILL" ;;
    *) echo "jarate-bg signal: unknown signal '$sig_name' (want TERM or KILL)" >&2; exit 2 ;;
  esac
  sig_rec_dir="$(jrate_rec_dir)"
  # ticket-id validation + short-id resolution (issue #262: the regex +
  # the record scan live in lib.sh, shared with jarate-bg-kill).
  # NOTE: the suffix is variable width (PID / $RANDOM) - never re-impose
  # a fixed 5-digit width here.
  sig_orig="$sig_id"
  sig_rc=0
  sig_id="$(jrate_resolve_ticket "$sig_id" "$sig_rec_dir" "jarate-bg signal")" || sig_rc=$?
  case "$sig_rc" in
    0) ;;
    2) echo "jarate-bg signal: '$sig_orig' is not a ticket id (want YYYYMMDD-HHMMSS-NNNNN, or a unique 7+ digit suffix)" >&2; exit 2 ;;
    *) exit 2 ;;
  esac
  sig_cg="$(jrate_cg_root)/pi-bg/$sig_id"
  if [ ! -d "$sig_cg" ]; then
    echo "jarate-bg signal: no cgroup for ticket '$sig_id' ($sig_cg missing) - unknown ticket, run in caller cgroup (no escape), or already reaped" >&2
    exit 2
  fi
  # tree enumeration (same shape as jarate-bg-kill; the /proc scan + BFS
  # live in lib.sh, issue #262): the cgroup members plus every descendant
  # (a real cgroup v2 move carries the whole subtree; the /proc walk
  # closes the escape-failed case)
  sig_pids="$(jrate_list_tree "$sig_cg" | sort -un | tr '\n' ' ')"
  sig_pids="${sig_pids% }"
  if [ "$sig_dry" -eq 1 ]; then
    echo "process tree for $sig_id (would be signaled $sig_name):"
    for p in $sig_pids; do
      ps -o pid=,ppid=,etime=,args= -p "$p" 2>/dev/null || echo "$p  (gone)"
    done
    echo "dry-run: no signal sent"
    exit 0
  fi
  if [ -z "$sig_pids" ]; then
    echo "jarate-bg signal: no live process in $sig_cg (empty cgroup - the run is not here)" >&2
    exit 3
  fi
  # #231 P1: the -killed marker is written BEFORE the signal (parity with
  # jarate-bg-kill's sticky terminal, #51). The wrapper's exit trap fires
  # milliseconds after the TERM - long before the receipt post below
  # returns - and stays quiet when the marker is present, so one kill
  # lands as ONE channel event (this receipt), not two (receipt + the
  # wrapper's own no-output DIED).
  sig_tmp="${PI_BG_TMPDIR:-${HOME}/.pi-bg-art}"
  mkdir -p "$sig_tmp" 2>/dev/null
  printf '%s signal:%s %s by %s; pids: %s\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$sig_name" "$sig_id" "$(id -un)" "$sig_pids" \
    > "$sig_tmp/pi-bg-${sig_id}-killed"
  for p in $sig_pids; do kill -"$sig_name" "$p" 2>/dev/null; done
  # bounded confirm (house shape: the jarate-bg-kill drain poll, short):
  # the receipt reports the RESULT - the orchestrator reads it, no
  # re-look. /proc, not the cgroup file: a plain-file test root is not
  # kernel-maintained.
  sig_wait="${PI_BG_SIGNAL_WAIT:-3}"
  case "$sig_wait" in '' | *[!0-9]*) sig_wait=3 ;; esac
  [ "$sig_wait" -ge 1 ] || sig_wait=1
  sig_t0="$(date +%s)"
  sig_gone=0
  sig_alive=""
  while :; do
    sig_alive=""
    for p in $sig_pids; do
      [ -d "/proc/$p" ] && sig_alive="${sig_alive:+$sig_alive }$p"
    done
    [ -z "$sig_alive" ] && { sig_gone=1; break; }
    [ $(( $(date +%s) - sig_t0 )) -ge "$sig_wait" ] && break
    sleep 0.5
  done
  sig_dur=$(( $(date +%s) - sig_t0 ))
  if [ "$sig_gone" -eq 1 ]; then
    sig_result="all signaled members gone after ${sig_dur}s"
  else
    sig_result="still alive after ${sig_dur}s: $sig_alive"
  fi
  # #231 P1 (parity with jarate-bg-kill): the drain confirmed the cgroup
  # is empty - every member of the run is dead, and the wrapper's exit
  # trap has already marked the record "done" (it runs during our drain
  # poll). "cancelled" is the final state for a signaled run. Same
  # audit-only posture: a missing/corrupt record never breaks the signal
  # path.
  if [ "$sig_gone" -eq 1 ] && [ -f "$sig_rec_dir/pi-bg-${sig_id}.json" ]; then
    jrate_rec_set_state "$sig_rec_dir/pi-bg-${sig_id}.json" "cancelled"
  fi
  # receipt: stdout + dead log (always) + webhook (best-effort)
  sig_ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  sig_repo="cwd"
  sig_wt_dir="${PI_BG_WT_DIR:-${HOME}/.pi-bg-wt}"
  for cand in "$sig_wt_dir"/*/"$sig_id"; do
    [ -d "$cand" ] && { sig_repo="$(basename "$(dirname "$cand")")"; break; }
  done
  echo "[pi-bg] signal $sig_name -> $sig_id: pids $sig_pids ($sig_result)"
  printf '%s %s %s %s %s\n' \
    "$(date -u +%Y-%m-%d)" "$sig_id" "$sig_repo" "$sig_ts" \
    "signal: $sig_name sent to pids $sig_pids by $(id -un); $sig_result" \
    >> "${HOME}/.pi-bg-deadlog" 2>/dev/null || true
  sig_webhook="$(jrate_webhook)"
  if [ -n "$sig_webhook" ]; then
    sig_bodyf="$sig_tmp/pi-bg-${sig_id}-signal-body.json"
    SIG_E_T="$sig_id" SIG_E_REPO="$sig_repo" SIG_E_SIG="$sig_name" \
    SIG_E_PIDS="$sig_pids" SIG_E_RESULT="$sig_result" SIG_E_AT="$sig_ts" \
    python3 - > "$sig_bodyf" 2>/dev/null <<'PY'
import json, os, sys, datetime
sys.path.insert(0, os.environ["JRATE_LIB_DIR"])
from jrate_common import GREEN_ALIVE, kv
E = lambda k: os.environ.get("SIG_E_" + k, "")
t = E('T')
lines = ["\u250c signal \u00b7 " + t,
         "\u251c $ jarate-bg signal " + E('SIG'),
         kv("repo", E('REPO')),
         kv("what", "signal " + E('SIG') + " sent to the run cgroup tree"),
         kv("detail", "pids " + E('PIDS')),
         kv("result", E('RESULT')),
         kv("at", E('AT')),
         "\u2514"]
embed = {"author": {"name": f"pi-bg ticket \u00b7 {t}"},
         "color": GREEN_ALIVE,  # green: alive run, informational (issue #143)
         "title": "SIGNAL \u00b7 " + t,
         "description": "```bash\n" + "\n".join(lines) + "\n```",
         "footer": {"text": "pi-bg signal (issue #143)"},
         "timestamp": datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")}
json.dump({"embeds": [embed]}, sys.stdout)
PY
    if [ -s "$sig_bodyf" ]; then
      sig_respf="$sig_tmp/pi-bg-${sig_id}-signal-wb-resp.txt"
      # Shared retry shape (issue #262, lib.sh jrate_wb_post): 3 tries,
      # escalating backoff PI_BG_WB_BACKOFF seconds (default 3s/6s);
      # PI_BG_WB_BACKOFF=0 = no sleep (test seam).
      sig_code="$(jrate_wb_post "$sig_webhook" "$sig_bodyf" "$sig_respf")"
      case "$sig_code" in
        2*) : ;;
        *)
          # #231 P1: dead letter in the EXACT bg_post shape (issue #53
          # self-contained: the JSON body is embedded after the `--- body
          # json ---` marker). Without it, a dead webhook + the
          # marker-suppressed wrapper DIED is a SILENT kill. The
          # watchdog's dead-letter consumer re-posts the receipt next
          # sweep.
          { printf 'ticket   : %s\n' "$sig_id"
            printf 'http     : %s (3 attempts)\n' "$sig_code"
            printf 'when     : %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
            printf 'response : %s\n' "$(head -c 300 "$sig_respf" 2>/dev/null)"
            printf 'body     : %s\n' "$sig_bodyf"
            printf -- '--- body json ---\n'
            cat "$sig_bodyf" 2>/dev/null; } > "$sig_tmp/pi-bg-${sig_id}-webhook-failed"
          echo "jarate-bg signal: webhook receipt FAILED (http=$sig_code) - dead letter: $sig_tmp/pi-bg-${sig_id}-webhook-failed" >&2
          ;;
      esac
    fi
    rm -f "$sig_bodyf" "$sig_tmp/pi-bg-${sig_id}-signal-wb-resp.txt" 2>/dev/null
  fi
  [ "$sig_gone" -eq 1 ] && exit 0
  exit 3
fi

# --- launch path (RETIRED, hall-monitor #35) ------------------------------
# One stdout line (the ticket-line slot dispatchers read with `head -1`)
# + the full notice on stderr. No side effects: no run record, no
# heartbeat, no worktree, no cgroup - a stubbed launch must not touch
# the artifact dir the in-flight runs are reading.
echo "jarate-bg: RETIRED (hall-monitor #35, 2026-10-20) - use the fleet: POST http://100.95.144.25:8001/api/fleet/dispatch (X-Agent-Key header)"
cat >&2 <<'EOF'
jarate-bg: bg dispatch is retired - new dispatches go to the fleet:
  POST http://100.95.144.25:8001/api/fleet/dispatch   (X-Agent-Key header)
  run CWD:  /srv/fleetwork/work/<ticket>
  push:     feature branches to the bare mirror /srv/fleetwork/<repo>.git
            (never origin/main)
  terminal: state returns as a [bg: fleetwork] <ticket> <agent> <state> line
In-flight tickets are unaffected: already-launched runs finish under the
old topology, and the completion side still works (jarate-bg-watchdog,
jarate-bg-tail, jarate-bg-kill, jarate-wait; the ~/.pi-bg-art artifact
convention survives). This launcher exits 10 on the launch path by design.
EOF
exit 10
