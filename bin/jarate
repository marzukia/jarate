#!/usr/bin/env bash
# jarate — single JSON entrypoint for machine-ops helpers (issue #17).
#
#   in:  jarate <cmd> [args...]      (args may also arrive pre-joined; both work)
#   out: ONE JSON doc on stdout: {"ok": true|false, "error": "...", ...}
#   rc:  0 ok | 1 helper failed | 2 usage error (JSON doc says why, always)
#
# JSON discipline (stable across calls — agents rely on it):
#   - snake_case keys, deterministic field order per subcommand
#   - ok:false + "error" is the ONLY error shape; never throw, never mix
#   - missing data = null, absent sections omitted
#   - error is ALWAYS present (null on success)
#   - ISO-8601 UTC timestamps, seconds for ages
#   - no emoji
#
# Commands:
#   setup <bot-token> <channel>   fresh-node FTUE (default dry-run; --yes executes)
#   ctx-report                    context % + token cost (reuses pi-token-cost.py --json)
#   journal-errors [--since S]    per-agent pi.service warnings (journalctl -p warning)
#   memory-grep <query>           search ~/memory, top-20 matches
#   rag <question> [--project P]  RAG one-call over project knowledge (recall --json)
#   agents-check                  AGENTS.md vs manifest (drift tripwire, read-only)
#   agents-bless [note]           rewrite the AGENTS.md manifest (re-bless an approved change)
#
# Deployed by install.sh: $HOME/bin/jarate + $HOME/scripts/jarate.
# Callers use $HOME/bin/jarate — do not rely on PATH.
#
# Env overrides (tests / exotic hosts):
#   JARATE_TOKEN_COST   path to pi-token-cost.py (default: ~/scripts, then repo)
#   JARATE_CTX_LIMIT    context limit fallback when models.json has none
#   JARATE_AGENT_HOMES  colon-separated agent homes (default: $HOME + /home/* agents)
#   JARATE_SSH_HOST     cross-user hop target (default andryo@127.0.0.1)
#   JARATE_SUDO_PASS    password for the sudo -S hop (else ~/.config/sudo-pass, 0600)
#   JARATE_RECALL_CLI   path to the recall CLI (default: repo, then ~/projects/recall)
#   JARATE_AGENTS_MD    path to the agent AGENTS.md (default: ~/.pi/agent/AGENTS.md,
#                       falling back to ~/AGENTS.md when that is absent — the
#                       live boxes keep the main profile's law in ~/AGENTS.md)
#   JARATE_TIMEOUT_S    per-external-call timeout in seconds (default 25)
#   JARATE_SETUP_GATE_S setup boot-gate window in seconds (default 90)
#   JARATE_SETUP_POLL_S setup boot-gate poll interval in seconds (default 3)

set -uo pipefail

JARATE_ROOT="${JARATE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)}"
TMO="${JARATE_TIMEOUT_S:-25}"
WARN_CAP=100   # max warning lines per agent
GREP_CAP=20    # memory-grep top-N
PARSE_CAP=1000 # memory-grep: max lines parsed from rg output

COMMANDS=("setup" "ctx-report" "journal-errors" "memory-grep" "rag" "agents-check" "agents-bless")

ts_now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

# die <error> — emit ok:false JSON and exit 1 (helper/runtime failure).
die() {
  jq -cn --arg ts "$(ts_now)" --arg e "$1" '{ok: false, ts: $ts, error: $e}'
  exit 1
}

# die_usage <error> — emit ok:false JSON and exit 2 (usage error).
die_usage() {
  jq -cn --arg ts "$(ts_now)" --arg e "$1" '{ok: false, ts: $ts, error: $e}'
  exit 2
}

# since_is_abs <value> — 0 if $1 is an absolute journalctl datetime.
# Accepted: 2026-09-13, 2026-09-13T00:00:00, 2026-09-13 00:00:00,
# optional Z / ±HH:MM offset. Relative forms (-1h) are rejected.
since_is_abs() {
  [[ "$1" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}([T ][0-9]{2}:[0-9]{2}(:[0-9]{2})?(Z|[+-][0-9]{2}:?[0-9]{2})?)?$ ]]
}

# ─── ctx-report ─────────────────────────────────────────────────────────────
# Context % of the calling agent (newest main-profile session) + lifetime
# token cost via pi-token-cost.py --json (cross-profile, per-home).

# Print {"tokens": N|null} for the newest assistant usage in a session jsonl.
# Same accounting as pi-token-cost.py: totalTokens == input+output+cacheRead.
session_last_usage() {
  timeout "$TMO" python3 -c '
import json, sys
last = None
try:
    fh = open(sys.argv[1], "r")
except Exception:
    print(json.dumps({"tokens": None}))
    raise SystemExit(0)
for line in fh:
    if "\"type\":\"message\"" not in line:
        continue
    try:
        o = json.loads(line)
    except Exception:
        continue
    m = o.get("message") or {}
    if m.get("role") != "assistant":
        continue
    u = m.get("usage")
    if isinstance(u, dict) and any(u.get(k) for k in ("input", "output", "cacheRead", "totalTokens")):
        last = u
if last is None:
    print(json.dumps({"tokens": None}))
else:
    t = last.get("totalTokens")
    if not t:
        t = (last.get("input", 0) or 0) + (last.get("output", 0) or 0) + (last.get("cacheRead", 0) or 0)
    print(json.dumps({"tokens": t}))
' "$1" 2>/dev/null
}

# Locate pi-token-cost.py: env override, ~/scripts, repo scripts/.
find_token_cost() {
  if [ -n "${JARATE_TOKEN_COST:-}" ]; then
    printf '%s' "${JARATE_TOKEN_COST:-}"
    return
  fi
  local c
  for c in "$HOME/scripts/pi-token-cost.py" "$JARATE_ROOT/scripts/pi-token-cost.py"; do
    if [ -f "$c" ]; then
      printf '%s' "$c"
      return
    fi
  done
}

cmd_ctx_report() {
  local profile="main"
  while [ $# -gt 0 ]; do
    case "$1" in
      --profile) [ $# -ge 2 ] || die_usage "ctx-report: --profile needs a value"; profile="$2"; shift ;;
      *) die_usage "ctx-report: unknown arg: $1" ;;
    esac
    shift
  done
  local agent home prof_dir
  agent="$(id -un)"
  home="$HOME"
  case "$profile" in
    main) prof_dir="$home/.pi/agent" ;;
    worker) prof_dir="$home/.pi/agent-worker" ;;
    *) die_usage "ctx-report: profile must be main or worker" ;;
  esac

  # context limit from the profile's models.json (switchboard header)
  local limit=""
  local mf
  mf="$(ls "$prof_dir"/models.json 2>/dev/null | head -1)"
  if [ -n "$mf" ]; then
    limit="$(jq -r '[.providers[].headers["X-Switchboard-Context"]? // empty] | .[0] // empty' "$mf" 2>/dev/null)"
  fi
  [ -n "$limit" ] || limit="${JARATE_CTX_LIMIT:-}"
  local limit_json="null"
  case "$limit" in
    ''|*[!0-9]*) limit_json="null" ;;
    *) limit_json="$limit" ;;
  esac

  # newest live session jsonl (reset files end .jsonl.reset-*, so -name
  # '*.jsonl' already skips them)
  local sess=""
  sess="$(find "$prof_dir/sessions" -name '*.jsonl' -type f -printf '%T@ %p\n' 2>/dev/null | sort -rn | head -1 | cut -d' ' -f2-)"

  local context="null"
  if [ -n "$sess" ]; then
    local usage tokens="null" age=0 pct="null" compact="false"
    usage="$(session_last_usage "$sess")"
    tokens="$(jq -r '.tokens // "null"' <<<"$usage" 2>/dev/null)"
    [ -n "$tokens" ] || tokens="null"
    age=$(( $(date +%s) - $(stat -c %Y "$sess" 2>/dev/null || echo "$(date +%s)") ))
    [ "$age" -ge 0 ] || age=0
    if [ "$tokens" != "null" ] && [ "$limit_json" != "null" ] && [ "$limit" -gt 0 ] 2>/dev/null; then
      pct=$(( tokens * 100 / limit ))
      [ "$pct" -ge 80 ] && compact="true"
    fi
    context="$(jq -cn \
      --arg session "$sess" \
      --argjson age_s "$age" \
      --argjson tokens "$tokens" \
      --argjson limit "$limit_json" \
      --argjson pct "$pct" \
      --argjson compact "$compact" \
      '{session: $session, age_s: $age_s, tokens: $tokens, limit: $limit, pct: $pct, compact_recommended: $compact}')" \
      || context="null"
  fi

  # cost via pi-token-cost.py --json <home> (hits OpenRouter; bounded)
  local cost="null" cost_error="" ptc raw
  ptc="$(find_token_cost)"
  if [ -z "$ptc" ] || [ ! -f "$ptc" ]; then
    cost_error="pi-token-cost.py not found (set JARATE_TOKEN_COST)"
  else
    if raw="$(timeout "$TMO" python3 "$ptc" --json "$home" 2>/dev/null)"; then
      cost="$(jq -cn --argjson r "$raw" '
        ($r.agents[0] // null) as $a
        | if $a == null then null else
            {model: ($r.model // null),
             turns: $a.stats.turns,
             input: $a.stats.input,
             output: $a.stats.output,
             cache_read: $a.stats.cacheRead,
             cache_write: $a.stats.cacheWrite,
             total_tokens: $a.stats.totalTokens,
             usd: ($a.pricing.cost // null)}
          end' 2>/dev/null)" || cost="null"
    else
      cost_error="pi-token-cost.py failed or timed out (${TMO}s)"
    fi
  fi
  [ -n "$cost" ] || cost="null"

  local ok="true" error=""
  if [ "$context" = "null" ] && { [ "$cost" = "null" ] || [ -n "$cost_error" ]; }; then
    ok="false"
    error="no context or cost data for $agent"
  fi

  jq -cn \
    --argjson ok "$ok" \
    --arg ts "$(ts_now)" \
    --arg agent "$agent" \
    --arg home "$home" \
    --arg profile "$profile" \
    --argjson context "$context" \
    --argjson cost "$cost" \
    --arg cost_error "${cost_error:-}" \
    --arg error "$error" \
    '{ok: $ok, ts: $ts, error: (if $error == "" then null else $error end),
      agent: $agent, home: $home, profile: $profile,
      context: $context, cost: $cost,
      cost_error: (if $cost_error == "" then null else $cost_error end)}' \
    || die "ctx-report: json assembly failed"
  [ "$ok" = "true" ] || exit 1
}

# ─── journal-errors ─────────────────────────────────────────────────────────
# Per-agent pi.service warnings. Self via user journal; other agents via the
# proven sshpass/sudo hop (pi-token-cost.py pattern).

# Remote probe for a peer agent home: prints [jarate:pi] as the first line
# only if that user has pi.service enabled, followed by the warning lines.
# Non-pi users (e.g. system accounts) produce no marker -> caller skips them.
run_remote_probe() { # $1=name $2=uid $3=since
  local host="${JARATE_SSH_HOST:-andryo@127.0.0.1}"
  local pass="${JARATE_SUDO_PASS:-$(cat "$HOME/.config/sudo-pass" 2>/dev/null)}"
  if [ -z "$pass" ]; then
    echo "[jarate:probe] no sudo password: set JARATE_SUDO_PASS or write ~/.config/sudo-pass (0600)" >&2
    return 1
  fi
  timeout "$TMO" sshpass -p "$pass" \
    ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=accept-new "$host" \
    "echo '$pass' | sudo -S -u '$1' bash -c 'export XDG_RUNTIME_DIR=/run/user/$2; if systemctl --user is-enabled pi.service >/dev/null 2>&1; then echo \"[jarate:pi]\"; journalctl --user -u pi.service -p warning --since \"\$1\" -q 2>/dev/null; fi' _ '$3'" 2>/dev/null
}

cmd_journal_errors() {
  local agent_filter=""
  local since
  since="$(date -u -d '1 hour ago' +%Y-%m-%dT%H:%M:%SZ)" # default: 1h back, absolute
  while [ $# -gt 0 ]; do
    case "$1" in
      --since)
        [ $# -ge 2 ] || die_usage "journal-errors: --since needs a value"
        local sv="$2"
        # journalctl's canonical absolute form "YYYY-MM-DD HH:MM:SS" arrives
        # as two words after arg re-join; re-join it here.
        if [[ "$sv" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] && [ $# -ge 3 ] \
          && [[ "$3" =~ ^[0-9]{2}:[0-9]{2}(:[0-9]{2})?$ ]]; then
          sv="$sv $3"; shift
        fi
        since_is_abs "$sv" || die_usage "journal-errors: --since must be an absolute datetime (YYYY-MM-DD[THH:MM:SS][Z]), got: $sv"
        since="$sv"; shift ;;
      --agent)
        [ $# -ge 2 ] || die_usage "journal-errors: --agent needs a value"
        agent_filter="$2"; shift ;;
      *) die_usage "journal-errors: unknown arg: $1" ;;
    esac
    shift
  done

  local -a homes=()
  if [ -n "${JARATE_AGENT_HOMES:-}" ]; then
    IFS=':' read -r -a homes <<<"$JARATE_AGENT_HOMES"
  else
    homes=("$HOME")
    local ssh_user="${JARATE_SSH_HOST:-andryo@127.0.0.1}"
    ssh_user="${ssh_user%%@*}"
    local self="$(id -un)"
    local u uid
    while IFS=: read -r u _ _ uid _ _ _; do
      [ -n "$u" ] || continue
      [ "$uid" -gt 900 ] 2>/dev/null || continue
      [ "$u" = "$self" ] && continue
      [ "$u" = "$ssh_user" ] && continue
      [ -d "/home/$u" ] && homes+=("/home/$u")
    done < <(getent passwd)
  fi
  [ "${#homes[@]}" -gt 0 ] || die "journal-errors: no agent homes found"

  local rows="[]"
  local included=0 ok_all="true" failed=""
  for h in "${homes[@]}"; do
    local name src err="" text=""
    name="$(basename "$h")"
    if [ -n "$agent_filter" ] && [ "$name" != "$agent_filter" ]; then
      continue
    fi
    included=$((included + 1))
    if [ "$h" = "$HOME" ]; then
      src="local"
      if text="$(timeout "$TMO" env XDG_RUNTIME_DIR="/run/user/$(id -u)" \
        journalctl --user -u pi.service -p warning --since "$since" -q 2>/dev/null)"; then
        :
      else
        err="journalctl failed (rc=$?)"
      fi
    else
      src="ssh+sudo"
      local uid rc=0
      uid="$(getent passwd "$name" 2>/dev/null | cut -d: -f3)"
      text="$(run_remote_probe "$name" "$uid" "$since")" || rc=$?
      if [ "$rc" -ne 0 ]; then
        err="cross-user hop failed (sshpass/sudo via ${JARATE_SSH_HOST:-andryo@127.0.0.1})"
      elif [ -z "$text" ] || [ "${text%%$'\n'*}" != "[jarate:pi]" ]; then
        # no pi.service for this user -> not an agent, skip the row
        included=$((included - 1))
        continue
      else
        text="${text#*$'\n'}"   # drop the marker line
        [ "$text" = "[jarate:pi]" ] && text=""
      fi
    fi

    local -a wl=()
    if [ -n "$text" ]; then
      mapfile -t wl <<<"$text"
    fi
    local total="${#wl[@]}" truncated="false"
    [ "$total" -gt "$WARN_CAP" ] && { wl=("${wl[@]:0:$WARN_CAP}"); truncated="true"; }
    local warnings
    warnings="$(printf '%s\n' "${wl[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))' 2>/dev/null)" || warnings="[]"
    if [ -n "$err" ]; then
      warnings="null"
      ok_all="false"
      failed+="${failed:+,}$name"
    fi
    local row
    row="$(jq -cn \
      --arg name "$name" \
      --arg source "$src" \
      --argjson count "${#wl[@]}" \
      --argjson warnings "$warnings" \
      --argjson truncated "$truncated" \
      --arg error "${err:-}" \
      '{name: $name, source: $source, count: $count, warnings: $warnings,
        truncated: $truncated, error: (if $error == "" then null else $error end)}')"
    rows="$(jq -c --argjson r "$row" '. + [$r]' <<<"$rows")"
  done

  [ "$included" -gt 0 ] || die "journal-errors: no agents matched --agent $agent_filter"
  local error=""
  [ "$ok_all" = "true" ] || error="agent(s) failed: $failed"
  jq -cn \
    --argjson ok "$ok_all" \
    --arg ts "$(ts_now)" \
    --arg since "$since" \
    --arg error "$error" \
    --argjson agents "$rows" \
    '{ok: $ok, ts: $ts, error: (if $error == "" then null else $error end),
      since: $since, agents: $agents}' \
    || die "journal-errors: json assembly failed"
  [ "$ok_all" = "true" ] || exit 1
}

# ─── memory-grep ────────────────────────────────────────────────────────────
# Search ~/memory (file-based memory), top-20 matches. Fixed strings by
# default (-F); --regex for rg regex. Case-insensitive by default; --case to
# pin. `--` ends flag parsing so dash-leading queries work.

cmd_memory_grep() {
  local root="$HOME/memory" mode="fixed" ci="-i"
  local -a qw=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --root) [ $# -ge 2 ] || die_usage "memory-grep: --root needs a value"; root="$2"; shift ;;
      --regex) mode="regex" ;;
      --case) ci="" ;;
      --) shift; qw+=("$@"); break ;;
      -*) die_usage "memory-grep: unknown flag: $1" ;;
      *) qw+=("$1") ;;
    esac
    shift
  done
  local query="${qw[*]:-}"
  [ -n "$query" ] || die_usage "memory-grep: usage: jarate memory-grep <query> [--root DIR] [--regex] [--case]"
  [ -d "$root" ] || die_usage "memory-grep: root not found: $root"
  command -v rg >/dev/null 2>&1 || die "memory-grep: rg not found on PATH"

  local -a fm=()
  [ "$mode" = "fixed" ] && fm+=(-F)

  # rg exit codes: 0 = matches, 1 = no matches, >1 = error.
  # Probe with -q first (cheap, no output), then read the lines.
  local rc=0
  timeout "$TMO" rg -q ${fm[@]} $ci -e "$query" "$root" 2>/dev/null || rc=$?
  [ "$rc" -eq 124 ] && die "memory-grep: rg timed out (${TMO}s)"
  [ "$rc" -le 1 ] || die "memory-grep: rg failed (rc=$rc)"
  local out="" orcp=0
  if [ "$rc" -eq 0 ]; then
    out="$(timeout "$TMO" rg -n --no-heading --sort path ${fm[@]} $ci -e "$query" "$root" 2>/dev/null | head -n "$PARSE_CAP")"
    orcp=$?
    [ "$orcp" -eq 124 ] && die "memory-grep: rg timed out (${TMO}s)"
  fi

  local rows="" truncated="false"
  local line file rest lineno text
  # total matches = non-empty lines in out (out itself is head-capped at PARSE_CAP)
  local total=0
  while IFS= read -r line; do
    [ -n "$line" ] && total=$((total + 1))
  done <<<"$out"
  [ "$total" -gt "$GREP_CAP" ] && truncated="true"
  local kept=0
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    [ "$kept" -ge "$GREP_CAP" ] && break
    file="${line%%:*}"
    rest="${line#*:}"
    lineno="${rest%%:*}"
    text="${rest#*:}"
    case "$lineno" in
      ''|*[!0-9]*) continue ;;
    esac
    rows+="$(jq -cn --arg f "$file" --argjson l "$lineno" --arg t "$text" \
      '{file: $f, line: $l, text: $t}')"$'\n'
    kept=$((kept + 1))
  done <<<"$out"
  local matches
  matches="$(printf '%s' "$rows" | jq -cs 'map(select(. != null))' 2>/dev/null)" || matches="[]"
  local count="$total"

  jq -cn \
    --arg ts "$(ts_now)" \
    --arg query "$query" \
    --arg root "$root" \
    --argjson count "$count" \
    --argjson truncated "$truncated" \
    --argjson matches "$matches" \
    '{ok: true, ts: $ts, error: null, query: $query, root: $root,
      count: $count, truncated: $truncated, matches: $matches}' \
    || die "memory-grep: json assembly failed"
}

# ─── rag ────────────────────────────────────────────────────────────────────
# One-call RAG wrapper over the recall CLI (TS port of pgrag, same db `rag`).
# `recall query --json` emits a SearchRow array: {source, content, score}.

find_bun() {
  if command -v bun >/dev/null 2>&1; then
    command -v bun
    return
  fi
  local c
  for c in "$HOME/.local/bin/bun" "$HOME/.bun/bin/bun"; do
    if [ -x "$c" ]; then
      printf '%s' "$c"
      return
    fi
  done
}

find_recall_cli() {
  if [ -n "${JARATE_RECALL_CLI:-}" ]; then
    printf '%s' "${JARATE_RECALL_CLI:-}"
    return
  fi
  local c
  for c in \
    "$JARATE_ROOT/packages/recall/bin/recall.ts" \
    "$HOME/projects/recall/bin/recall.ts"; do
    if [ -f "$c" ]; then
      printf '%s' "$c"
      return
    fi
  done
  command -v recall 2>/dev/null || true
}

cmd_rag() {
  local project=""
  local -a qw=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --project) [ $# -ge 2 ] || die_usage "rag: --project needs a value"; project="$2"; shift ;;
      -*) die_usage "rag: unknown flag: $1" ;;
      *) qw+=("$1") ;;
    esac
    shift
  done
  local question="${qw[*]:-}"
  [ -n "$question" ] || die_usage "rag: usage: jarate rag <question> [--project NAME]"

  local bun
  bun="$(find_bun)" || true
  [ -n "$bun" ] || die "rag: bun not found on PATH"
  local cli
  cli="$(find_recall_cli)"
  [ -n "$cli" ] || die "rag: recall CLI not found (repo packages/recall, ~/projects/recall, PATH)"

  # stdout and stderr stay separate: stderr noise must not fail a
  # successful query (F5).
  local out rc errf err
  errf="$(mktemp "${TMPDIR:-/tmp}/jarate-rag.XXXXXXXX")" || die "rag: mktemp failed"
  if [ -n "$project" ]; then
    out="$(timeout "$TMO" env RAG_PROJECT="$project" "$bun" "$cli" query --json "$question" 2>"$errf")"
    rc=$?
  else
    out="$(timeout "$TMO" "$bun" "$cli" query --json "$question" 2>"$errf")"
    rc=$?
  fi
  err="$(head -1 "$errf" 2>/dev/null)"
  rm -f "$errf"
  if [ "$rc" -eq 124 ]; then
    die "rag: recall query timed out (${TMO}s)"
  elif [ "$rc" -ne 0 ] || [ -z "$out" ]; then
    die "rag: recall query failed (rc=$rc): ${err:-$(head -1 <<<"$out")}"
  fi
  jq -e 'type == "array"' >/dev/null 2>&1 <<<"$out" \
    || die "rag: unexpected recall output (expected JSON array)"
  local count
  count="$(jq 'length' <<<"$out")"

  jq -cn \
    --arg ts "$(ts_now)" \
    --arg question "$question" \
    --arg project "${project:-}" \
    --argjson count "$count" \
    --argjson results "$out" \
    '{ok: true, ts: $ts, error: null, backend: "recall", question: $question,
      project: (if $project == "" then null else $project end),
      count: $count, results: $results}' \
    || die "rag: json assembly failed"
}

# ─── agents-check / agents-bless ───────────────────────────────────────────
# AGENTS.md is prompt-level law: changes require Andryo's explicit approval
# (2026-09-14). A hash manifest makes the rule mechanical. ALERT-ONLY: the
# check never reverts, never blocks; the watchdog (pi-bg-watchdog) posts one
# warning per drifted hash. Manifest: <sha256>  <UTC timestamp>  <note>.

agents_md_path() {
  if [ -n "${JARATE_AGENTS_MD:-}" ]; then
    printf '%s' "$JARATE_AGENTS_MD"
    return
  fi
  # live boxes keep the main profile's law in ~/AGENTS.md; prefer the
  # canonical ~/.pi/agent/AGENTS.md when it exists
  if [ -f "$HOME/.pi/agent/AGENTS.md" ]; then
    printf '%s' "$HOME/.pi/agent/AGENTS.md"
  else
    printf '%s' "$HOME/AGENTS.md"
  fi
}

agents_manifest_path() {
  # fixed design path; only an explicit JARATE_AGENTS_MD moves it (next to
  # the checked file)
  if [ -n "${JARATE_AGENTS_MD:-}" ]; then
    printf '%s' "$(dirname "$JARATE_AGENTS_MD")/.agents-md-hash"
  else
    printf '%s' "$HOME/.pi/agent/.agents-md-hash"
  fi
}

agents_hash() { # $1=md path -> sha256 on stdout, rc!=0 on failure
  sha256sum "$1" 2>/dev/null | awk '{print $1}'
}

cmd_agents_check() {
  local md man hash expected="" drift
  md="$(agents_md_path)"
  man="$(agents_manifest_path)"
  [ -r "$md" ] || die "agents-check: AGENTS.md unreadable or missing: $md"
  hash="$(agents_hash "$md")" || die "agents-check: sha256 failed: $md"
  [ -n "$hash" ] || die "agents-check: sha256 failed: $md"
  if [ -r "$man" ]; then
    expected="$(awk 'NR==1 {print $1; exit}' "$man" 2>/dev/null)"
  fi
  if [ -z "$expected" ]; then
    drift="true" # manifest missing (or unparseable)
  elif [ "$expected" = "$hash" ]; then
    drift="false"
  else
    drift="true" # hash mismatch
  fi
  jq -cn \
    --arg ts "$(ts_now)" \
    --arg hash "$hash" \
    --arg expected "$expected" \
    --argjson drift "$drift" \
    '{ok: true, ts: $ts, error: null, hash: $hash,
      expected: (if $expected == "" then null else $expected end),
      drift: $drift}' \
    || die "agents-check: json assembly failed"
}

cmd_agents_bless() {
  local md man hash ts note tmpf
  md="$(agents_md_path)"
  man="$(agents_manifest_path)"
  [ -r "$md" ] || die "agents-bless: AGENTS.md unreadable or missing: $md"
  hash="$(agents_hash "$md")" || die "agents-bless: sha256 failed: $md"
  [ -n "$hash" ] || die "agents-bless: sha256 failed: $md"
  ts="$(ts_now)"
  note="$*"
  [ -n "$note" ] || note="-"
  mkdir -p "$(dirname "$man")" 2>/dev/null \
    || die "agents-bless: cannot create $(dirname "$man")"
  tmpf="$(mktemp "$(dirname "$man")"/.agents-md-hash.XXXXXX)" \
    || die "agents-bless: mktemp failed"
  printf '%s  %s  %s\n' "$hash" "$ts" "$note" > "$tmpf" \
    && mv "$tmpf" "$man" \
    || { rm -f "$tmpf"; die "agents-bless: manifest write failed: $man"; }
  jq -cn \
    --arg ts "$ts" \
    --arg hash "$hash" \
    --arg note "$note" \
    '{ok: true, ts: $ts, error: null, hash: $hash, note: $note}' \
    || die "agents-bless: json assembly failed"
}

# ─── setup ────────────────────────────────────────────────────────────────────
# Fresh-node FTUE: token + channel -> running, verified agent (design:
# audit-ftue.md section 2, 2026-09-15). Default = DRY-RUN: prints the plan,
# no network, no writes. --yes executes. Idempotent: settings.json jq-merged
# (timestamped .bak first), the "Jarate" webhook is REUSED when present,
# units rewritten in place, enable safe to repeat. All curl bounded (-m 15).
# No TTY usage.
#
# Human portal prerequisites (NOT reachable with a bot token):
#   H1. application created, bot token issued
#   H2. privileged intents: SERVER MESSAGES, MESSAGE CONTENT, VOICE STATES
#   H3. invite mask incl. MANAGE_WEBHOOKS (1<<21); recommended 2228048
#       (else pass --webhook-url)
#   H4. LLM endpoint creds (else the agent boots, LLM calls fail)

SETUP_API="https://discord.com/api/v10"
SETUP_CLONE_URL="https://github.com/marzukia/jarate.git"
SETUP_TOK="" SETUP_CH="" SETUP_OWNER="" SETUP_WH=""
SETUP_NAME="" SETUP_DIR=""
SETUP_MBASE="" SETUP_MID="" SETUP_MKEY="" SETUP_MHDR="{}"
SETUP_DRY=1 SETUP_UNITS=1 SETUP_VERIFY=1

slog() { echo "[setup] $*" >&2; }
# sdry <line> — dry-run plan line (stderr)
sdry() { echo "[setup dry] $*" >&2; }

# s_api_try METHOD path [body] — one Discord API call that never dies.
# rc 0 = ok (response body on stdout); rc 1 = curl failure or Discord error
# doc (error body on stdout when one arrived). DRY: log only, fake body.
s_api_try() {
  local m="$1" p="$2" body="${3:-}"
  if [ "$SETUP_DRY" = 1 ]; then
    sdry "$m $SETUP_API$p${body:+ body=$(printf %s "$body" | wc -c)c}"
    printf '{"id":"dry"}'
    return 0
  fi
  local out
  if [ -n "$body" ]; then
    # -d @- + here-string: body via stdin, dodging the 128KB argv element
    # limit (avatar base64 ~260KB).
    out="$(curl -sS -m 15 -X "$m" "$SETUP_API$p" \
      -H "Authorization: Bot $SETUP_TOK" -H "Content-Type: application/json" \
      -d @- <<<"$body" 2>&1)" || return 1
  else
    out="$(curl -sS -m 15 "$SETUP_API$p" \
      -H "Authorization: Bot $SETUP_TOK" 2>&1)" || return 1
  fi
  # Discord error doc: {"message":..., "code":...} without an "id"
  if printf '%s' "$out" | jq -e \
    '(.id? // null) == null and ((.code? // .message?) != null)' \
    >/dev/null 2>&1; then
    printf '%s' "$out"
    return 1
  fi
  printf '%s' "$out"
}

# s_api METHOD path [body] — hard version: die (JSON doc, rc 1) on failure.
s_api() {
  local out
  out="$(s_api_try "$@")" || die "setup: api $1 $2 failed: ${out:0:300}"
  printf '%s' "$out"
}

cmd_setup() {
  SETUP_TOK="" SETUP_CH="" SETUP_OWNER="" SETUP_WH=""
  SETUP_NAME="${USER:-$(id -un)}" SETUP_DIR="$HOME/projects/jarate"
  SETUP_MBASE="" SETUP_MID="" SETUP_MKEY="" SETUP_MHDR="{}"
  SETUP_DRY=1 SETUP_UNITS=1 SETUP_VERIFY=1

  local usage='setup: usage: jarate setup <bot-token> <channel-id> [--yes] [--owner UID] [--name N] [--jarate-dir D] [--webhook-url U] [--model-base URL] [--model-id ID] [--model-key KEY] [--model-headers JSON] [--no-units] [--no-verify]'
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes) SETUP_DRY=0 ;;
      --dry-run) SETUP_DRY=1 ;;
      --no-units) SETUP_UNITS=0 ;;
      --no-verify) SETUP_VERIFY=0 ;;
      --owner) [ $# -ge 2 ] || die_usage "setup: --owner needs a value"; SETUP_OWNER="$2"; shift ;;
      --name) [ $# -ge 2 ] || die_usage "setup: --name needs a value"; SETUP_NAME="$2"; shift ;;
      --jarate-dir) [ $# -ge 2 ] || die_usage "setup: --jarate-dir needs a value"; SETUP_DIR="$2"; shift ;;
      --webhook-url) [ $# -ge 2 ] || die_usage "setup: --webhook-url needs a value"; SETUP_WH="$2"; shift ;;
      --model-base) [ $# -ge 2 ] || die_usage "setup: --model-base needs a value"; SETUP_MBASE="$2"; shift ;;
      --model-id) [ $# -ge 2 ] || die_usage "setup: --model-id needs a value"; SETUP_MID="$2"; shift ;;
      --model-key) [ $# -ge 2 ] || die_usage "setup: --model-key needs a value"; SETUP_MKEY="$2"; shift ;;
      --model-headers) [ $# -ge 2 ] || die_usage "setup: --model-headers needs a value"; SETUP_MHDR="$2"; shift ;;
      -h | --help)
        jq -cn --arg ts "$(ts_now)" \
          '{ok: true, ts: $ts, error: null,
            usage: "jarate setup <bot-token> <channel-id> [options]",
            note: "default is dry-run (plan only, no network, no writes); --yes executes",
            options: ["--owner <discord-user-id>", "--name <agent-name>",
                       "--jarate-dir <dir>", "--webhook-url <url>",
                       "--model-base <url> --model-id <id> --model-key <key>",
                       "[--model-headers <json>]", "--no-units", "--no-verify"],
            effect: "installs pi + @jarate/bridge on this node: settings.json, models.json, dispatch webhook, systemd user units, boot verification"}'
        exit 0 ;;
      -*) die_usage "setup: unknown flag: $1" ;;
      *) if [ -z "$SETUP_TOK" ]; then SETUP_TOK="$1"
         elif [ -z "$SETUP_CH" ]; then SETUP_CH="$1"
         else die_usage "setup: extra arg: $1"; fi ;;
    esac
    shift
  done
  [ -n "$SETUP_TOK" ] && [ -n "$SETUP_CH" ] || die_usage "$usage"
  [[ "$SETUP_CH" =~ ^[0-9]+$ ]] || die_usage "setup: channel id must be numeric: $SETUP_CH"
  if [ -n "$SETUP_MHDR" ] && ! jq -e . >/dev/null 2>&1 <<<"$SETUP_MHDR"; then
    die_usage "setup: --model-headers must be valid JSON: $SETUP_MHDR"
  fi
  [[ "$SETUP_TOK" == *.*.* ]] \
    || slog "note: token does not look like a Discord bot token (3 dot parts); continuing"

  slog "(dry=$SETUP_DRY, agent=$SETUP_NAME, channel=$SETUP_CH)"

  # --- 1. local deps -------------------------------------------------------
  local t
  for t in git jq python3 curl; do
    command -v "$t" >/dev/null 2>&1 || die "setup: missing dep: $t"
  done
  command -v bun >/dev/null 2>&1 || [ -x "$HOME/.local/bin/bun" ] \
    || slog "note: bun not on PATH (bridge install); see SETUP.md prerequisites"
  command -v pi >/dev/null 2>&1 || [ -x "$HOME/.local/bin/pi" ] \
    || slog "note: pi not on PATH yet; see SETUP.md prerequisites"

  # --- 2. token check ------------------------------------------------------
  local me bot_id="" bot_name=""
  me="$(s_api GET /users/@me)"
  bot_id="$(jq -r '.id // empty' <<<"$me")"
  bot_name="$(jq -r '.username // empty' <<<"$me")"
  slog "bot: $bot_id${bot_name:+ ($bot_name)}"

  # --- 3. channel check ----------------------------------------------------
  local ch ch_type="" ch_guild=""
  ch="$(s_api GET "/channels/$SETUP_CH")"
  ch_type="$(jq -r '.type // empty' <<<"$ch")"
  ch_guild="$(jq -r '.guild_id // empty' <<<"$ch")"
  slog "channel: $SETUP_CH (guild=${ch_guild:-unknown}, type=${ch_type:-?})"
  # Discord v10 channel types: 0 = guild text, 1 = DM, 4 = guild voice, 5 =
  # group DM, 15 = guild text (newer). Webhooks need a guild channel - accept
  # the text types, reject everything else by name.
  case "$ch_type" in
    "") ;; # dry-run: s_api_try returns the stub doc, no type - nothing to check
    0 | 15) ;;
    *)
      die "setup: channel type $ch_type is not a guild text channel (0/15). DM=1, voice=4, group-DM=5 - webhooks need a guild text channel"
      ;;
  esac

  # --- 4. checkout + install.sh --------------------------------------------
  if [ -d "$SETUP_DIR/.git" ]; then
    slog "checkout present: $SETUP_DIR"
    if [ "$SETUP_DRY" = 0 ]; then
      (cd "$SETUP_DIR" && ./install.sh) || die "setup: install.sh failed"
    else
      sdry "(cd $SETUP_DIR && ./install.sh)"
    fi
  else
    if [ "$SETUP_DRY" = 0 ]; then
      mkdir -p "$(dirname "$SETUP_DIR")" || die "setup: cannot create $(dirname "$SETUP_DIR")"
      git clone "$SETUP_CLONE_URL" "$SETUP_DIR" || die "setup: git clone failed"
      (cd "$SETUP_DIR" && ./install.sh) || die "setup: install.sh failed"
    else
      sdry "git clone $SETUP_CLONE_URL $SETUP_DIR && ./install.sh"
    fi
  fi

  # --- 5. LLM endpoint (model block built first: feeds settings merge) ------
  local prov_key="" provider="null"
  if [ -n "$SETUP_MBASE" ] && [ -n "$SETUP_MID" ]; then
    prov_key="$(jq -rn --arg b "$SETUP_MBASE" '$b | split("/") | .[2] // "provider"')"
    provider="$(jq -cn \
      --arg name "$SETUP_MID" --arg base "$SETUP_MBASE" \
      --arg key "${SETUP_MKEY:-local}" --argjson headers "$SETUP_MHDR" \
      --arg id "$SETUP_MID" \
      '{name:$name,baseUrl:$base,api:"openai-completions",apiKey:$key,headers:$headers,
        models:[{id:$id,name:$id,contextWindow:262144,maxTokens:16384,
                 cost:{input:0,output:0,cacheRead:0,cacheWrite:0}}]}')"
  fi

  # --- 6. settings.json (jq merge, timestamped .bak first) ------------------
  local settings="$HOME/.pi/agent/settings.json"
  local entry
  entry="$(jq -cn \
    --arg id "discord-$SETUP_NAME" \
    --arg name "${SETUP_NAME^^}" \
    --arg ch "$SETUP_CH" \
    --arg tok "$SETUP_TOK" \
    --arg owner "$SETUP_OWNER" \
    '{id:$id,name:$name,type:"discord",enabled:true,channel:$ch,botToken:$tok,
      default:true,forwardToolCalls:true,ack:false}
     + (if $owner == "" then {} else {ownerUserId:$owner} end)')"
  local merge_filter='(.packages // []) as $pk | (.channels // []) as $cs
    | .packages = (($pk + [$pkg]) | unique)
    | .channels = (($cs | map(select(.channel != $ch.channel))) + [$ch])
    | . + (if $prov == "" then {} else {defaultProvider: $prov, defaultModel: $model} end)'
  local fresh_filter='{packages:[$pkg],channels:[$ch]}
    + (if $prov == "" then {} else {defaultProvider:$prov,defaultModel:$model} end)'
  if [ "$SETUP_DRY" = 1 ]; then
    sdry "merge $settings: packages += $SETUP_DIR/packages/bridge; channels: replace for channel $SETUP_CH${prov_key:+; defaultProvider=$prov_key defaultModel=$SETUP_MID}"
  else
    mkdir -p "$HOME/.pi/agent" || die "setup: mkdir failed: $HOME/.pi/agent"
    [ -f "$settings" ] && cp -p "$settings" "$settings.bak-$(date +%Y%m%d%H%M%S)"
    local tmp
    tmp="$(mktemp)" || die "setup: mktemp failed"
    if [ -f "$settings" ]; then
      jq --arg pkg "$SETUP_DIR/packages/bridge" --argjson ch "$entry" \
        --arg prov "$prov_key" --arg model "$SETUP_MID" \
        "$merge_filter" "$settings" > "$tmp" \
        || { rm -f "$tmp"; die "setup: settings.json merge failed (invalid existing JSON?): $settings"; }
    else
      jq -n --arg pkg "$SETUP_DIR/packages/bridge" --argjson ch "$entry" \
        --arg prov "$prov_key" --arg model "$SETUP_MID" \
        "$fresh_filter" > "$tmp" \
        || { rm -f "$tmp"; die "setup: settings.json write failed"; }
    fi
    mv "$tmp" "$settings" && chmod 600 "$settings" \
      || die "setup: settings.json write failed"
    slog "settings.json merged (backup kept)"
  fi

  # --- 7. models.json --------------------------------------------------------
  local models="$HOME/.pi/agent/models.json"
  if [ -n "$prov_key" ]; then
    if [ "$SETUP_DRY" = 1 ]; then
      sdry "merge $models: provider $prov_key ($SETUP_MID @ $SETUP_MBASE)"
    else
      [ -f "$models" ] && cp -p "$models" "$models.bak-$(date +%Y%m%d%H%M%S)"
      local tmp
      tmp="$(mktemp)" || die "setup: mktemp failed"
      if [ -f "$models" ]; then
        jq --arg k "$prov_key" --argjson p "$provider" \
          '.providers = ((.providers // {}) + {($k): $p})' "$models" > "$tmp" \
          || { rm -f "$tmp"; die "setup: models.json merge failed (invalid existing JSON?): $models"; }
      else
        jq -n --arg k "$prov_key" --argjson p "$provider" \
          '{providers:{($k):$p}}' > "$tmp" \
          || { rm -f "$tmp"; die "setup: models.json write failed"; }
      fi
      mv "$tmp" "$models" && chmod 600 "$models" || die "setup: models.json write failed"
      slog "models.json written (provider $prov_key; defaults set in settings.json)"
    fi
  else
    slog "NOTE: no --model-base/--model-id; agent boots but LLM calls fail until models.json exists (H4)"
  fi

  # --- 8. dispatch webhook (reuse "Jarate" or POST /channels/{id}/webhooks) --
  local wcfg="$HOME/.config/pi-dispatch"
  local wb_id="" wb_tok=""
  if [ -n "$SETUP_WH" ]; then
    wb_id="$(sed -E 's#.*webhooks/([0-9]+)/.*#\1#' <<<"$SETUP_WH")"
    wb_tok="$(sed -E 's#.*/##' <<<"$SETUP_WH")"
    [ -n "$wb_id" ] && [ -n "$wb_tok" ] \
      || die "setup: cannot parse webhook id/token from --webhook-url"
    slog "using given webhook $wb_id"
  else
    local list
    if ! list="$(s_api_try GET "/channels/$SETUP_CH/webhooks")"; then
      if grep -q "Missing Permissions" <<<"$list"; then
        die "setup: bot lacks MANAGE_WEBHOOKS on channel $SETUP_CH (403). Invite mask must include 1<<29 (use 539098960), or pass --webhook-url"
      fi
      die "setup: webhook list failed: ${list:0:300}"
    fi
    if [ "$SETUP_DRY" = 1 ]; then
      sdry "look for existing 'Jarate' webhook in channel $SETUP_CH; POST to create if absent"
    else
      local existing
      existing="$(jq -c '[.[] | select(.name == "Jarate")] | .[0] // empty' <<<"$list")"
      if [ -n "$existing" ] && [ "$existing" != "null" ]; then
        wb_id="$(jq -r '.id' <<<"$existing")"
        wb_tok="$(s_api GET "/webhooks/$wb_id" | jq -r '.token // empty')"
        [ -n "$wb_tok" ] || die "setup: existing 'Jarate' webhook $wb_id is owned by another app (no token readable); pass --webhook-url"
        slog "reusing existing webhook $wb_id"
      else
        local b64 body created
        b64="$(base64 -w0 "$SETUP_DIR/assets/jarate-icon.png" 2>/dev/null)" \
          || die "setup: avatar missing: $SETUP_DIR/assets/jarate-icon.png"
        body="$(printf '%s' "$b64" | jq -cRs '{name:"Jarate",avatar:("data:image/png;base64," + .)}')" \
          || die "setup: avatar body build failed"
        if ! created="$(s_api_try POST "/channels/$SETUP_CH/webhooks" "$body")"; then
          slog "avatar body rejected; retrying without avatar: $(head -c 200 <<<"$created")"
          created="$(s_api_try POST "/channels/$SETUP_CH/webhooks" '{"name":"Jarate"}')" \
            || die "setup: webhook create failed (MANAGE_WEBHOOKS in invite mask? else --webhook-url): $created"
        fi
        wb_id="$(jq -r '.id' <<<"$created")"
        wb_tok="$(jq -r '.token' <<<"$created")"
        slog "created webhook $wb_id (avatar $(printf %s "$b64" | wc -c) b64 chars, cap 262144)"
      fi
    fi
  fi
  if [ "$SETUP_DRY" = 0 ]; then
    [ -n "$wb_id" ] && [ -n "$wb_tok" ] || die "setup: webhook id/token missing"
    mkdir -p "$wcfg" || die "setup: mkdir failed: $wcfg"
    printf 'https://discord.com/api/webhooks/%s/%s\n' "$wb_id" "$wb_tok" > "$wcfg/webhook"
    printf '%s\n' "$wb_id" > "$wcfg/webhook_author"
    chmod 600 "$wcfg/webhook" "$wcfg/webhook_author" || die "setup: chmod failed"
    slog "$wcfg/{webhook,webhook_author} written (600)"
  else
    sdry "write $wcfg/webhook + $wcfg/webhook_author (600)"
  fi

  # --- 9. units (repo templates, %h specifiers — no sed of user paths) -------
  local unit_dir="$HOME/.config/systemd/user"
  if [ "$SETUP_UNITS" = 1 ]; then
    if [ "$SETUP_DRY" = 1 ]; then
      sdry "write $unit_dir/{pi.service,jarate-deploy.service,jarate-deploy.timer,pi-bg-watchdog.service,pi-bg-watchdog.timer} from repo templates (%h specifiers)"
      sdry "systemctl --user daemon-reload; loginctl enable-linger $(id -un); systemctl --user enable --now pi.service jarate-deploy.timer pi-bg-watchdog.timer"
    else
      command -v systemctl >/dev/null 2>&1 \
        || die "setup: systemctl not found (need a systemd user session)"
      export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
      [ -f "$SETUP_DIR/deploy/pi.service" ] \
        || die "setup: template missing: $SETUP_DIR/deploy/pi.service (old checkout? git pull)"
      mkdir -p "$unit_dir" || die "setup: mkdir failed: $unit_dir"
      sed "s#__AGENT_NAME__#${SETUP_NAME}#" "$SETUP_DIR/deploy/pi.service" \
        > "$unit_dir/pi.service" || die "setup: pi.service write failed"
      sed "s#%h/projects/jarate#${SETUP_DIR}#g" "$SETUP_DIR/deploy/jarate-deploy.service" \
        > "$unit_dir/jarate-deploy.service" || die "setup: jarate-deploy.service write failed"
      cp "$SETUP_DIR/deploy/jarate-deploy.timer" "$unit_dir/" \
        || die "setup: jarate-deploy.timer copy failed"
      cp "$SETUP_DIR/dispatch/pi-bg-watchdog.service" "$unit_dir/" \
        || die "setup: pi-bg-watchdog.service copy failed"
      cp "$SETUP_DIR/dispatch/pi-bg-watchdog.timer" "$unit_dir/" \
        || die "setup: pi-bg-watchdog.timer copy failed"
      systemctl --user daemon-reload || die "setup: daemon-reload failed"
      loginctl enable-linger "$(id -un)" 2>/dev/null \
        || slog "note: enable-linger needs root (loginctl enable-linger $(id -un))"
      systemctl --user enable --now pi.service || die "setup: enable pi.service failed"
      systemctl --user enable --now jarate-deploy.timer pi-bg-watchdog.timer \
        || die "setup: enable timers failed"
      slog "units installed + enabled (pi.service, jarate-deploy.timer, pi-bg-watchdog.timer)"
    fi
  fi

  # --- 10. verify: journal gate (same signal deploy.sh trusts) ---------------
  local verified="null"
  if [ "$SETUP_VERIFY" = 1 ] && [ "$SETUP_DRY" = 0 ]; then
    slog "boot gate: waiting <=90s for pi.service active + '[interactions] registered'"
    local since ok=0 deadline
    since="$(date '+%F %T')"
    deadline=$(( $(date +%s) + ${JARATE_SETUP_GATE_S:-90} ))
    while [ "$(date +%s)" -lt "$deadline" ]; do
      if [ "$(systemctl --user is-active pi.service 2>/dev/null)" = "active" ] \
         && journalctl --user -u pi.service --since "$since" --no-pager 2>/dev/null | grep -aq '\[interactions\] registered'; then
        ok=1; break
      fi
      sleep "${JARATE_SETUP_POLL_S:-3}"
    done
    if [ "$ok" = 1 ]; then
      verified="true"
      slog "boot gate passed — send a message to the channel to confirm"
    else
      local tail
      tail="$(journalctl --user -u pi.service --since "$since" --no-pager -n 20 2>/dev/null | tail -c 600 | tr '\n' '|')"
      die "setup: boot gate failed (${JARATE_SETUP_GATE_S:-90}s). journal tail: $tail. usual suspects: H2 intents not enabled, H3 invite mask (MANAGE_WEBHOOKS 1<<21 / VIEW_CHANNEL), bad token"
    fi
  fi

  # --- 11. report -------------------------------------------------------------
  local -a steps_a=()
  [ "$SETUP_DRY" = 1 ] && steps_a+=("re-run with --yes to execute (dry-run wrote nothing)")
  [ -z "$prov_key" ] && steps_a+=("LLM creds: re-run with --model-base/--model-id/--model-key (H4) — agent boots but LLM calls fail")
  steps_a+=("identity: author ~/AGENTS.md (per-agent, hand-written)")
  steps_a+=("RAG (optional): docs/PGRAG-SETUP.md")
  steps_a+=("web search (optional): cp $SETUP_DIR/extensions/mcp-tools.ts ~/.pi/agent/extensions/ + tavily key in settings.json mcp[]")
  steps_a+=("peers (optional): invite bots to each other's guilds + peerBotIds in settings.json")
  local steps
  steps="$(printf '%s\n' "${steps_a[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))')"
  local units_out dry_json
  if [ "$SETUP_DRY" = 1 ]; then
    units_out="null"
    dry_json=true
  elif [ "$SETUP_UNITS" = 1 ]; then
    units_out="true"
    dry_json=false
  else
    units_out="null"
    dry_json=false
  fi

  jq -cn \
    --arg ts "$(ts_now)" \
    --argjson dry "$dry_json" \
    --arg agent "$SETUP_NAME" \
    --arg ch "$SETUP_CH" \
    --arg bot_id "$bot_id" \
    --arg wb_id "$wb_id" \
    --argjson units "$units_out" \
    --argjson verified "$verified" \
    --argjson steps "$steps" \
    '{ok: true, ts: $ts, error: null, dry_run: $dry,
      agent: $agent, channel: $ch,
      bot_id: (if $bot_id == "" or $bot_id == "dry" then null else $bot_id end),
      webhook_id: (if $wb_id == "" or $wb_id == "dry" then null else $wb_id end),
      units: $units, verified: $verified, next_steps: $steps}' \
    || die "setup: json assembly failed"
}

# ─── dispatch ─────────────────────────────────────────────────────────────────

main() {
  local cmd="${1:-}"
  [ $# -gt 0 ] && shift
  local -a args=()
  read -r -a args <<<"$*"

  case "$cmd" in
    "" | help | -h | --help)
      jq -cn --arg ts "$(ts_now)" \
        '{ok: true, ts: $ts, error: null, usage: "jarate <cmd> [args]",
          commands: ["setup", "ctx-report", "journal-errors", "memory-grep",
                     "rag", "agents-check", "agents-bless"]}'
      ;;
    setup) cmd_setup "${args[@]}" ;;
    ctx-report) cmd_ctx_report "${args[@]}" ;;
    journal-errors) cmd_journal_errors "${args[@]}" ;;
    memory-grep) cmd_memory_grep "${args[@]}" ;;
    rag) cmd_rag "${args[@]}" ;;
    agents-check) cmd_agents_check "${args[@]}" ;;
    agents-bless) cmd_agents_bless "${args[@]}" ;;
    *)
      jq -cn --arg ts "$(ts_now)" --arg c "$cmd" \
        '{ok: false, ts: $ts, error: ("unknown command: " + $c),
          usage: "jarate <cmd> [args]",
          commands: ["setup", "ctx-report", "journal-errors", "memory-grep",
                     "rag", "agents-check", "agents-bless"]}'
      exit 2
      ;;
  esac
}

main "$@"
