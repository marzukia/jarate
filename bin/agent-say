#!/usr/bin/env bash
# agent-say: send a message to a Discord channel as the calling user's pi bot.
#
# Usage:
#   agent-say <channel-id|peer> "message"
#   echo "message" | agent-say <channel-id|peer> -
#
# Target: a numeric Discord channel id of a known fleet peer, or a fleet
# peer name resolved via ~/.config/agent-fleet/peers.json (seeded by
# install.sh from the local dispatch/peers.json - gitignored, copy
# dispatch/peers.example.json and fill in real channel ids - + your own
# channel; operators add peers). Keep the file current on roster/channel
# changes.
#
# Token resolution: $PI_BOT_TOKEN, else first discord botToken in
# ~/.pi/agent/settings.json.
#
# This is how pi agents talk to each other: post to the peer's channel.
# Your normal reply only auto-forwards to your own channel.
#
# Guards (history: 2026-09-20 incident — a human deliverable routed to a
# peer's channel via agent-say, derailing the peer):
#   exit 3  target is your OWN channel -> use a normal reply (the bridge
#           auto-forwards it)
#   exit 4  target is not a known fleet peer (peers.json value). Humans
#           live in your own channel; a raw id that is no agent's channel
#           is a mis-route. Bypass: AGENT_SAY_FORCE=1.
#   [warn]  message does not name the target peer (non-blocking nudge:
#           human deliverables dropped into a peer channel usually do not
#           address the peer). AGENT_SAY_HUMANS (space-separated human
#           names, machine-local config) sharpens the nudge when the body
#           names a known human but not the peer.
set -euo pipefail

if [ $# -lt 2 ]; then
  echo "usage: agent-say <channel-id|peer> <message|->" >&2
  exit 2
fi
channel="$1"

# Peer name resolution (#45): a non-numeric target must exist in the
# peers file or the command fails loudly (a typo'd channel id would
# otherwise 404 deep in curl). Numeric targets pass through untouched.
if ! [[ "$channel" =~ ^[0-9]+$ ]]; then
  peers="$HOME/.config/agent-fleet/peers.json"
  resolved=""
  if [ -f "$peers" ] && command -v jq >/dev/null 2>&1; then
    resolved="$(jq -r --arg p "$channel" '.[$p] // empty' "$peers" 2>/dev/null || true)"
  fi
  if [[ "$resolved" =~ ^[0-9]+$ ]]; then
    channel="$resolved"
  else
    echo "agent-say: unknown peer '$1' (add it to $peers)" >&2
    exit 2
  fi
fi
msg="$2"
if [ "$msg" = "-" ]; then msg="$(cat)"; fi
if [ -z "$msg" ]; then
  echo "agent-say: empty message" >&2
  exit 2
fi

# Guard: reject agent-say to your OWN channel. agent-say is for
# agent-to-agent comms. If you're replying to a human in your own
# channel, just reply normally — the bridge auto-forwards it.
# (Incident 2026-09-20: one agent sent a human's deliverable link to a
# peer's channel via agent-say, derailing the peer.)
own_channel=""
if [ -f "$HOME/.pi/agent/settings.json" ]; then
  own_channel=$(jq -r '[.channels[]? | select(.type == "discord") | .channel // empty] | .[0] // empty' "$HOME/.pi/agent/settings.json" 2>/dev/null)
fi
if [ -n "$own_channel" ] && [ "$channel" = "$own_channel" ]; then
  echo "agent-say: channel $channel is YOUR OWN channel. Use a normal reply instead — the bridge auto-forwards it. agent-say is for agent-to-agent comms only." >&2
  exit 3
fi

# Guard: the target must be a known fleet peer channel — a value in the
# peers file. Name targets were already validated against it during
# resolution, so this only bites on raw numeric ids (the incident vector:
# a channel id copied from context that is no agent's channel). Fail
# closed when the peers file or jq is missing; AGENT_SAY_FORCE=1 bypasses
# (migration windows, one-off channels).
peers="$HOME/.config/agent-fleet/peers.json"
in_peers=""
peer_name=""
known_peers=""
if [ -f "$peers" ] && command -v jq >/dev/null 2>&1; then
  in_peers="$(jq --arg c "$channel" '[.[] | tostring | select(. == $c)] | length > 0' "$peers" 2>/dev/null || echo false)"
  peer_name="$(jq -r --arg c "$channel" 'to_entries[] | select((.value | tostring) == $c) | .key' "$peers" 2>/dev/null | head -n 1 || true)"
  known_peers="$(jq -r 'to_entries[] | "\(.key)=\(.value)"' "$peers" 2>/dev/null | tr '\n' ' ' || true)"
fi
if [ "${AGENT_SAY_FORCE:-0}" != "1" ] && [ "$in_peers" != "true" ]; then
  echo "agent-say: channel $channel is not a known fleet peer (known: ${known_peers:-none}; check $peers). agent-say reaches agents only — for a human, reply normally in your own channel. Bypass: AGENT_SAY_FORCE=1." >&2
  exit 4
fi

# Nudge: a message to a peer's channel should name that peer. Human
# deliverables dropped into a peer channel usually don't (2026-09-20
# incident: a human-named deliverable routed to a peer's channel).
# Non-blocking: replies inside an agent-to-agent thread often omit the name.
# agent-say is ONLY for bot-to-bot. If the message names a human but
# not the target peer, it is almost certainly mis-routed.
if [ -n "$peer_name" ]; then
  lc_msg="$(printf '%s' "$msg" | tr '[:upper:]' '[:lower:]')"
  lc_name="$(printf '%s' "$peer_name" | tr '[:upper:]' '[:lower:]')"
  case "$lc_msg" in
    *"$lc_name"*) ;;
    *)
      # Check if the message names a known human instead of the peer.
      # Roster = AGENT_SAY_HUMANS (space-separated names, machine-local
      # config; empty by default = generic nudge only).
      human_hit=""
      for h in ${AGENT_SAY_HUMANS:-}; do
        h="$(printf '%s' "$h" | tr '[:upper:]' '[:lower:]')"
        case "$lc_msg" in *"$h"*) human_hit="$h"; break;; esac
      done
      if [ -n "$human_hit" ]; then
        echo "agent-say: [warn] message names '$human_hit' (a human) but not $peer_name. agent-say is ONLY for bot-to-bot. Reply in your own channel to reach $human_hit — use <@userId> to tag them." >&2
      else
        echo "agent-say: [warn] message to $peer_name's channel does not name $peer_name. If it is for a human, reply in your own channel instead." >&2
      fi
      ;;
  esac
fi

# Secret censor: the message is Discord egress from outside the bridge, so
# route it through the same censor + registry (jarate/bin/jarate-censor).
# Missing tool / bun absent / any error = send as-is (never block the peer).
AS_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)"
if [ -f "$AS_ROOT/bin/jarate-censor" ] && command -v bun >/dev/null 2>&1; then
  censored="$(printf '%s' "$msg" | bun "$AS_ROOT/bin/jarate-censor" 2>/dev/null)" && msg="$censored"
fi

# Outbox (2026-10-06 abort incident): a mid-run kill can land between
# curl POST-completion and the "sent" print; the agent re-runs agent-say
# with the same text and double-posts. Record each successful send as a
# receipt and dedupe an identical channel + text re-run within
# DEDUPE_WINDOW seconds (skip the POST, print the receipt's id). Receipt
# writes are best-effort: a failure warns once, never changes rc.
DEDUPE_WINDOW=60
AS_RT="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
AS_OUTBOX="$AS_RT/jarate/agent-say-outbox.jsonl"
msg_sha="$(printf '%s' "$msg" | sha256sum 2>/dev/null | awk '{print $1}')" || msg_sha=""

token="${PI_BOT_TOKEN:-}"
if [ -z "$token" ] && [ -f "$HOME/.pi/agent/settings.json" ]; then
  token=$(jq -r '[.channels[]? | select(.type == "discord") | .botToken // empty] | .[0] // empty' "$HOME/.pi/agent/settings.json")
fi
if [ -z "$token" ]; then
  echo "agent-say: no bot token (set PI_BOT_TOKEN or add a discord channel to ~/.pi/agent/settings.json)" >&2
  exit 1
fi

# Idempotent re-run check (pre-POST): a receipt for the same channel +
# text within DEDUPE_WINDOW seconds -> skip the POST and print the
# receipt's id in the identical "sent <id>" shape (callers cannot tell
# the difference). Unreadable file / partial line / jq failure = miss =
# post as normal (dedupe is an optimization, never a blocker).
if [ -n "$msg_sha" ] && [ -f "$AS_OUTBOX" ]; then
  now="$(date +%s)"
  dedup_id="$(jq -rs --arg c "$channel" --arg h "$msg_sha" --argjson now "$now" --argjson w "$DEDUPE_WINDOW" \
    '[.[] | select(.channel == $c and .text_sha256 == $h and .ts <= $now and ($now - .ts) <= $w)] | last | .id // empty' \
    "$AS_OUTBOX" 2>/dev/null || true)"
  if [ -n "$dedup_id" ]; then
    echo "sent $dedup_id"
    exit 0
  fi
fi

# issue #120: the bot token never sits in curl's argv — it rides a curl
# config on stdin (`curl -K -`); --max-time 15 bounds the call.
resp=$(printf 'header = "Authorization: Bot %s"\n' "$token" \
  | curl -sS -K - --max-time 15 -X POST "https://discord.com/api/v10/channels/$channel/messages" \
    -H "Content-Type: application/json" \
    -d "$(jq -n --arg c "$msg" '{content: $c}')") || {
  echo "agent-say: curl failed" >&2
  exit 1
}

id=$(jq -r '.id // empty' <<<"$resp")
if [ -z "$id" ]; then
  echo "agent-say: discord error: $(jq -c '.' <<<"$resp")" >&2
  exit 1
fi

# Outbox receipt: written only on a true success (error bodies were
# rejected above), best-effort — a failed write warns, rc stays 0.
if [ -n "$msg_sha" ]; then
  if ! { mkdir -p "${AS_OUTBOX%/*}" 2>/dev/null \
      && jq -cn --arg c "$channel" --arg h "$msg_sha" --arg i "$id" --argjson t "$(date +%s)" \
        '{channel: $c, text_sha256: $h, id: $i, ts: $t}' >>"$AS_OUTBOX" 2>/dev/null; }; then
    echo "agent-say: [warn] outbox receipt write failed ($AS_OUTBOX)" >&2
  fi
fi
echo "sent $id"
