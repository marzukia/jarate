#!/usr/bin/env bash
# jarate pre-commit: format+lint staged TypeScript/JavaScript with biome.
# Fast, fail-immediate. Full check (including bash-excluded dirs) runs in CI.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

STAGED="$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx|js|jsx|mts|cts|mjs|cjs|json)$' || true)"
if [ -z "$STAGED" ]; then
  exit 0
fi

# --no-errors-on-unmatched: files may have been staged but not on disk edge cases
exec bunx biome check --no-errors-on-unmatched $STAGED
